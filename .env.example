# Copy to .env for local work. .gitignore already excludes .env.
# In production these live in hPanel → Website → Environment variables and are
# never committed.

# Database — MySQL on the same Hostinger account as the app, reached over
# localhost so port 3306 never opens to the internet.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u666480115_xstudiozfolio
DB_PASSWORD=
DB_NAME=u666480115_XStudiozfolio

# Admin panel. The app refuses to sign anyone in below these lengths rather
# than falling back to something guessable — a weak admin password is a
# stranger rewriting the live portfolio.
#   ADMIN_PASSWORD  12+ characters
#   SESSION_SECRET  32+ characters — generate with `npm run admin-secret`
ADMIN_PASSWORD=
SESSION_SECRET=

# Where uploaded deck images are written and read.
#
# Set this in production. It must point OUTSIDE the deployed application
# directory, because Hostinger replaces that wholesale on every deploy — an
# unset value resolves to `<cwd>/public/uploads`, which lands inside the app
# and takes the whole portfolio with it on the next redeploy.
#
# Production: UPLOADS_DIR=/home/u666480115/domains/portfolio.xstudioz.com/public_html/uploads
# Local: leave blank to use ./public/uploads.
UPLOADS_DIR=
