# build output
dist/
# PDF page renders + covers generated by scripts/ingest.mjs during build
src/content/projects/*/page-*.png
src/content/projects/*/cover.png
# generated types
.astro/
# dependencies
node_modules/
# logs
npm-debug.log*
# environment variables (all variants Vite/Astro load)
.env*
!.env.example
# macOS-specific files
.DS_Store
.env

# Uploaded portfolio images. Written at runtime into public_html/uploads on
# the host, which survives redeploys; keeping them in git would put the 62 MB
# back that the migration just took out.
public/uploads/
