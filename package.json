{
  "name": "xstudioz-portfolio",
  "description": "XStudioz \u2014 design studio portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/ingest.mjs && astro build && node scripts/prune-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "og": "node scripts/generate-og.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" \"*.mjs\"",
    "ingest": "node scripts/ingest.mjs",
    "export-sql": "node scripts/export-sql.mjs",
    "check-sql": "node scripts/export-sql.mjs --check",
    "start": "node ./dist/server/entry.mjs",
    "migrate-images": "node --env-file=.env --experimental-strip-types scripts/migrate-images.mjs",
    "start:local": "node --env-file=.env ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/sitemap": "^3.4.1",
    "@napi-rs/canvas": "^1.0.3",
    "astro": "^5.12.0",
    "mysql2": "^3.23.2",
    "pdfjs-dist": "^6.1.200",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
