---
import { SITE } from '@/config/site';
import { STUDIO } from '@/data/studio';

/**
 * The handoff to Fiverr.
 *
 * The gap this closes: a visitor is convinced, clicks through, and then
 * stalls on an empty message box. Telling them exactly what to send turns
 * the click into a brief, and a brief into a reply that is worth having.
 *
 * Edit the copy in the CMS (Site settings → Studio content → Start a
 * project). The reassurance lines are deliberately factual — how the work
 * runs — rather than promises about speed or price.
 */
interface Props {
  /** Overrides the heading when a page needs its own framing. */
  title?: string;
  lede?: string;
  headingId?: string;
}

const { brief } = STUDIO;
const { title = brief.title, lede = brief.lede, headingId = 'brief-heading' } = Astro.props;
---

<section class="section brief" aria-labelledby={headingId}>
  <div class="container brief-inner">
    <div class="brief-lead">
      <p class="overline">{brief.overline}</p>
      <h2 id={headingId} class="brief-title">{title}</h2>
      <p class="brief-lede">{lede}</p>

      <div class="brief-action">
        <a
          class="button button--primary button--lg"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {brief.ctaLabel}
          <span aria-hidden="true">↗</span>
        </a>
        {brief.ctaNote && <p class="brief-note">{brief.ctaNote}</p>}
      </div>

      {
        brief.reassurance.length > 0 && (
          <ul class="brief-reassurance" role="list">
            {brief.reassurance.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        )
      }
    </div>

    {/* The panel is the artefact: a brief template you can read down and copy */}
    <div class="brief-panel" data-reveal>
      <p class="overline overline--bare brief-panel-label">Include in your first message</p>
      <ol class="brief-list" role="list">
        {
          brief.items.map((item, i) => (
            <li class="brief-item">
              <span class="brief-item-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="brief-item-body">
                <span class="brief-item-label">{item.label}</span>
                <span class="brief-item-hint">{item.hint}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .brief {
    /* Its own surface: the last paper section before the ink footer, lifted
       one step so the page visibly arrives somewhere. */
    background: var(--color-paper-raised);
    border-block-start: 1px solid var(--color-line);
  }

  .brief-inner {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 1000px) {
    .brief-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-3xl);
      align-items: start;
    }
  }

  .brief-title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-2xs) var(--space-md);
    max-width: var(--measure-statement);
  }

  .brief-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .brief-action {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xl);
  }

  .brief-note {
    font-size: var(--text-sm);
    color: var(--color-ink-mute);
  }

  .brief-reassurance {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
  }

  .brief-reassurance li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  /* A check drawn in the accent — the one place a tick earns its keep */
  .brief-reassurance li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.5rem;
    block-size: 0.3rem;
    border-inline-start: 1.5px solid var(--color-accent);
    border-block-end: 1.5px solid var(--color-accent);
    rotate: -45deg;
  }

  .brief-panel {
    background: var(--color-paper);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      var(--shadow-md);
    padding: var(--space-lg);
  }

  .brief-panel-label {
    color: var(--color-ink);
    margin-block-end: var(--space-sm);
  }

  .brief-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--color-line);
  }

  .brief-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2xs);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--color-line);
  }

  .brief-item-num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    padding-block-start: 0.35em;
  }

  .brief-item-body {
    display: grid;
    gap: 0.1rem;
  }

  .brief-item-label {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
  }

  .brief-item-hint {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }
</style>
