---
import type { ReadyProject } from '@/lib/projects';
import { categoryLabel } from '@/data/categories';

/**
 * A slow, seamless column of real project covers beside the hero headline.
 *
 * Every tile is an actual published cover, not an abstract composition: the
 * fastest way to say "this studio has taste" is to show the work in the first
 * screen, before anyone has scrolled or clicked.
 *
 * Seamless because the list is rendered twice and the track translates by
 * exactly -50%. At that point tile N+1 sits precisely where tile 1 was, so
 * the loop has no seam to hide. The duplicate half is aria-hidden, so a
 * screen reader hears each project once.
 *
 * It used to be decoration — no links, no captions, aria-hidden — which made
 * the first work a visitor sees the one thing on the site they cannot act on.
 * Hovering already paused the drift, so it invited a click and then answered
 * nothing. Each tile is a link now, and says which project it is.
 *
 * The duplicate half stays hidden: the track renders the column twice, so
 * naively exposing it would put every project in the tab order and the
 * accessibility tree twice.
 */
interface Props {
  projects: ReadyProject[];
}

const { projects } = Astro.props;
// Two columns drifting in opposite directions reads as depth; one reads as a
// banner. Needs at least four covers to be worth doing at all.
const columns =
  projects.length >= 4
    ? [projects.filter((_, i) => i % 2 === 0), projects.filter((_, i) => i % 2 === 1)]
    : [projects];
---

{
  projects.length > 0 && (
    <div class="marquee">
      {columns.map((column, c) => (
        <div class:list={['marquee-col', { 'marquee-col--reverse': c === 1 }]}>
          <div class="marquee-track">
            {[...column, ...column].map((p, i) => (
              <figure class="marquee-tile" aria-hidden={i >= column.length ? 'true' : undefined}>
                <a
                  class="marquee-link"
                  href={`/work/${p.id}/`}
                  data-astro-prefetch
                  tabindex={i >= column.length ? -1 : undefined}
                >
                  <picture>
                    {p.data.cover.avifSrcset && (
                      <source
                        type="image/avif"
                        srcset={p.data.cover.avifSrcset}
                        sizes="(min-width: 1100px) 320px, 92vw"
                      />
                    )}
                    <img
                      src={p.data.cover.src}
                      srcset={p.data.cover.srcset}
                      sizes="(min-width: 1100px) 320px, 92vw"
                      alt=""
                      width={p.data.cover.width}
                      height={p.data.cover.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <figcaption class="marquee-say">
                    <span class="marquee-name">{p.data.title}</span>
                    <span class="marquee-kind">{categoryLabel(p.data.category)}</span>
                  </figcaption>
                </a>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  )
}

<style>
  .marquee {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    /* The column is taller than its box and the overflow is masked, so the
       covers arrive from nowhere and leave to nowhere. */
    block-size: clamp(22rem, 46vh, 34rem);
    overflow: hidden;
    /* Fade both ends into the page rather than cutting them off.

       A fixed distance, not a percentage. At 12% of a 414px lane the fade was
       50px; the lane now fills the hero, so the same 12% became a 99px ramp —
       and in light mode a dark cover ramping into near-white paper over 99px
       is a grey smear that reads as a rendering fault rather than an edge.
       Three rem is the same soft edge whatever height the hero gives it. */
    --marquee-fade: 3rem;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent
    );
  }

  /* One lane at every width, and the second lane never renders.

     Two lanes measured 260px per tile at 1440 — narrower than the phone the
     same page is read on. A brand mark at 260px is a swatch: you can tell the
     artwork apart from its neighbour and you cannot read it, which is the one
     thing the first screen of a logo studio has to let you do. One lane is
     717px on the same screen, 2.75x the width and 7.5x the area, and the
     counter-drifting second column is not worth a cover nobody can judge.

     The mask lives on the column rather than the grid, so the lane fades at
     both of its own ends whatever height the hero gives it. */
  .marquee-col--reverse {
    display: none;
  }

  @media (max-width: 1099px) {
    .marquee {
      block-size: auto;
      mask-image: none;
    }

    .marquee-col {
      block-size: clamp(18rem, 42vh, 26rem);
      mask-image: linear-gradient(
        to bottom,
        transparent,
        #000 var(--marquee-fade),
        #000 calc(100% - var(--marquee-fade)),
        transparent
      );
    }
  }

  /* Fills the height the hero gives it, instead of a fixed 414px floating in
     the middle of a 1038px column — which left the top-right quadrant of the
     first screen, the most valuable space on the site, completely empty.

     Out of flow, which is the whole trick. `block-size: 100%` against a parent
     whose height is auto resolves to auto, so the lane grew to fit all
     eighteen tiles and took the hero to 5,263px. Absolute, it contributes no
     height at all: the row is sized by the words beside it and the lane is
     told to match. Requires a positioned parent — the hero sets
     `position: relative` on the element this renders into. */
  @media (min-width: 1100px) {
    .marquee {
      position: absolute;
      inset: 0;
      block-size: auto;
    }
  }

  .marquee-col {
    overflow: hidden;
    min-block-size: 0;
  }

  .marquee-track {
    display: grid;
    gap: var(--space-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      /* -50% lands tile N+1 exactly where tile 1 was: no seam. */
      animation: marquee-drift 46s linear infinite;
    }

    .marquee-col--reverse .marquee-track {
      animation-direction: reverse;
      animation-duration: 58s;
    }

    /* Slow to a stop while the pointer is over it, so a cover can be looked at */
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee-drift {
    to {
      transform: translateY(-50%);
    }
  }

  /* Glass tile: the cover sits behind a hairline and a faint lift, so wildly
     different artwork reads as one set of objects in one room. */
  .marquee-tile {
    margin: 0;
    border-radius: var(--radius-md);
    /* --image-bg, not --color-paper-raised: that token is pure white in light
       mode, and a deck page is usually white too, so the tile's edge
       dissolved into exactly the frame that is meant to hold it. */
    background: var(--image-bg);
    box-shadow: var(--image-frame), var(--shadow-md);
    overflow: hidden;
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .marquee-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .marquee-tile :global(img) {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }

  /* Names the cover. Without this a visitor who likes one has nothing to
     search for and nothing to ask about. */
  .marquee-say {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    padding: var(--space-2xs) var(--space-xs) var(--space-xs);
  }

  .marquee-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .marquee-kind {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  @media (hover: hover) {
    .marquee-link:hover .marquee-name {
      color: var(--color-ink);
    }
  }

  .marquee-tile:has(.marquee-link:hover),
  .marquee-tile:has(.marquee-link:focus-visible) {
    box-shadow: var(--image-frame-hover), var(--shadow-lift), var(--glow-card);
  }

  .marquee-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }
</style>
