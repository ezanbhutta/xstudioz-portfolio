---
import { Picture } from 'astro:assets';
import { lqipStyle } from '@/lib/lqip';
import { getCategory } from '@/data/categories';
import type { ReadyProject } from '@/lib/projects';

/**
 * The hero's visual moment: three plates in a row, numbered like exhibits.
 *
 * A shallower crop than the main grid on purpose — the strip is a glance,
 * not a browse, so it stays clearly subordinate to Selected Work further
 * down and the same cover never reads as a duplicate. On a phone it becomes
 * a scroll-snapping rail with the next plate peeking, which says "there is
 * more" without needing a label to say it.
 */
interface Props {
  projects: ReadyProject[];
}

const { projects } = Astro.props;

const plates = await Promise.all(
  projects.map(async (project, i) => ({
    project,
    index: i,
    placeholder: await lqipStyle(project.data.cover),
    service: getCategory(project.data.category).title,
  })),
);
---

<ul class="strip" role="list">
  {
    plates.map(({ project, index, placeholder, service }) => (
      <li class="strip-item" data-enter style={`--enter-step:${4 + index}`}>
        <a class="strip-link" href={`/work/${project.id}/`} data-astro-prefetch>
          <div class="strip-media media" data-vt={`work-${project.id}`}>
            <Picture
              src={project.data.cover}
              alt={project.data.coverAlt || `${project.data.title} — presentation cover`}
              formats={['webp']}
              fallbackFormat="webp"
              widths={[420, 720, 1100]}
              sizes="(min-width: 900px) 30vw, 78vw"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              style={placeholder}
            />
          </div>
          <p class="strip-caption">
            <span class="strip-num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="strip-title">{project.data.title}</span>
            <span class="strip-meta">
              {[project.data.industry, service].filter(Boolean).join(' · ')}
            </span>
          </p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
    /* Phone: a snapping rail that bleeds to both gutters, with the next
       plate visible so the affordance needs no instructions. */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    scroll-padding-inline-start: var(--gutter);
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip-item {
    scroll-snap-align: start;
  }

  @media (min-width: 760px) {
    .strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    /* Each plate a beat lower than the last — a straight row of three reads
       as a card deck; a stepped one reads as a hang. */
    .strip-item:nth-child(2) {
      margin-block-start: var(--space-lg);
    }

    .strip-item:nth-child(3) {
      margin-block-start: var(--space-2xl);
    }
  }

  .strip-link {
    display: block;
    text-decoration: none;
  }

  .strip-media {
    aspect-ratio: 3 / 2;
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .strip-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  .strip-caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75em;
    align-items: baseline;
    padding-block-start: var(--space-2xs);
  }

  .strip-num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .strip-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    justify-self: start;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .strip-meta {
    grid-column: 2;
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  @media (hover: hover) {
    .strip-link:hover .strip-media {
      box-shadow: var(--image-frame-hover), var(--shadow-md);
    }

    .strip-link:hover .strip-media :global(img) {
      transform: scale(1.04);
    }

    .strip-link:hover .strip-title {
      background-size: 100% 1px;
    }
  }

  .strip-link:focus-visible .strip-title {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-link:hover .strip-media :global(img) {
      transform: none;
    }
  }
</style>
