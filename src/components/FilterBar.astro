---
import { CATEGORIES, type CategoryId } from '@/data/categories';
import FilterBarEnhancer from '@/components/FilterBarEnhancer.astro';
import Subfilters from '@/components/Subfilters.astro';

interface Props {
  counts: Partial<Record<CategoryId, number>>;
  total: number;
  /** Category id when rendered on a category landing page, 'all' on home. */
  active?: CategoryId | 'all';
  /**
   * When true (home), a script upgrades the links to instant in-page
   * filtering. Without JS — or on category pages — they are plain links.
   */
  enhanced?: boolean;
  /** Distinct industries per category (for the Industry dropdowns). */
  industries?: Partial<Record<CategoryId, string[]>>;
}

const { counts, total, active = 'all', enhanced = false, industries = {} } = Astro.props;

// On category pages these are real links to the current page → 'page'.
// On the enhanced home bar they mark the active filter state → 'true'.
const current = enhanced ? 'true' : 'page';
---

<nav
  class="filterbar"
  aria-label="Filter work by category"
  data-filterbar={enhanced ? '' : undefined}
  data-total={total}
>
  <div class="container filter-inner">
    <ul class="filter-list" role="list">
      {
        CATEGORIES.map((c) => {
          const count = counts[c.id] ?? 0;
          // A chip that leads to an empty grid is a dead end. Services with
          // no published work still belong here — they say what the studio
          // offers — but they read as quiet labels, not as things to click,
          // and they never advertise a "0".
          const empty = count === 0 && active !== c.id;
          return (
            <li>
              {empty ? (
                <span class="filter-link filter-link--empty" title={`${c.title} — coming soon`}>
                  {c.title}
                </span>
              ) : (
                <a
                  class="filter-link"
                  href={!enhanced && active === c.id ? '/' : `/${c.id}/`}
                  data-filter={c.id}
                  data-label={c.title}
                  data-astro-prefetch={enhanced ? undefined : ''}
                  aria-current={active === c.id ? current : undefined}
                >
                  {c.title}
                  {count > 0 && <span class="filter-count">{count}</span>}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
    <Subfilters industries={industries} active={active} enhanced={enhanced} />
  </div>
</nav>

{enhanced && <FilterBarEnhancer />}

<script is:inline>
  // Bring the active chip into view — inline so it runs during parse and
  // the sticky bar never visibly jumps after first paint.
  (() => {
    const list = document.querySelector('.filter-list');
    const activeChip = list && list.querySelector('[aria-current]');
    if (list && activeChip) {
      const delta = activeChip.getBoundingClientRect().left - list.getBoundingClientRect().left;
      list.scrollLeft = Math.max(0, delta - (list.clientWidth - activeChip.clientWidth) / 2);
    }
  })();
</script>

<style>
  .filterbar {
    position: sticky;
    top: 0;
    z-index: var(--z-filter);
    /* Translucent so the work scrolls under the bar rather than hitting a
       hard opaque slab; the blur keeps the chips legible over any cover. */
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    border-block-end: 1px solid var(--color-line);
  }

  /* Chips left, refinements right — one row instead of two stacked ones.
     Below 900px they wrap back to their own line. */
  @media (min-width: 900px) {
    .filter-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-lg);
    }

    /* The refinement selects sit on the same baseline as the chips now, so
       the block padding that separated the two rows has to go. */
    .filter-inner :global(.subfilters) {
      padding-block-end: 0;
      flex: none;
    }
  }

  .filter-list {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0 calc(-1 * var(--space-sm));
    padding: var(--space-xs) var(--space-sm);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .filter-list::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    /* Absorb the chip's own 1rem inline padding so the LABEL — not the
       pill — sits on the page's left rail; the pill bleeds into the gutter. */
    .filter-list {
      margin-inline: calc(-1 * (var(--space-sm) + 1rem));
      padding-inline: calc(var(--space-sm) + 1rem);
    }
  }

  @media (max-width: 1199px) {
    /* The chip row can overflow up to ~1200px wide; fade hints at more,
       trailing padding keeps the last chip clear of the fade. */
    .filter-list {
      padding-inline-end: var(--space-2xl);
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    }
  }

  /* Compact chrome on short landscape viewports — still tappable, and the
     list keeps enough block padding for the focus ring to render. */
  @media (max-height: 26rem) {
    .filter-list {
      padding-block: var(--space-2xs);
    }

    .filter-link {
      min-height: 2.5rem;
    }
  }

  .filter-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: var(--control-h);
    padding: 0.375rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  /* Services with nothing published yet: present, but plainly not a control */
  .filter-link--empty {
    color: var(--color-ink-mute);
    opacity: 0.55;
    cursor: default;
  }

  @media (hover: hover) {
    .filter-link:hover {
      background: var(--color-line);
      color: var(--color-ink);
    }
  }

  .filter-link:active {
    transform: scale(0.98);
  }

  /* Active = the outline vocabulary the buttons already own; a solid ink
     pill pinned over the covers stole attention from the work. */
  .filter-link[aria-current] {
    background: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  /* Raised like a footnote marker — the count annotates the label rather
     than sitting on the baseline competing with it. */
  .filter-count {
    align-self: flex-start;
    margin-block-start: 0.15em;
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-soft);
  }

  .filter-link[aria-current] .filter-count {
    color: var(--color-accent);
  }
</style>
