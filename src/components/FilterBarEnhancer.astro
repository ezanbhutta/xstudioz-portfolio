---
/**
 * Client-side filtering for the home work grid. Rendered only where the
 * FilterBar is `enhanced`, so category pages don't ship a script that can
 * never run there.
 *
 * One category is always selected — Logo Design by default on landing.
 * Clicking another chip switches to it; Logo Design additionally exposes
 * Type and Industry dropdowns that refine within the category.
 */
---

<script>
  const bar = document.querySelector<HTMLElement>('[data-filterbar]');
  const gridWrap = document.querySelector<HTMLElement>('[data-work-grid]');

  if (bar && gridWrap) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('a[data-filter]')];
    const items = [...gridWrap.querySelectorAll<HTMLLIElement>('li[data-category]')];
    const status = gridWrap.querySelector<HTMLElement>('[data-filter-status]');
    const empty = gridWrap.querySelector<HTMLElement>('[data-work-empty]');
    const groups = [...bar.querySelectorAll<HTMLElement>('[data-subfilters]')];
    const valid = new Set(links.map((l) => l.dataset.filter));

    const activeSelects = (category: string) => {
      const group = groups.find((g) => g.dataset.subgroup === category);
      return group ? [...group.querySelectorAll<HTMLSelectElement>('select')] : [];
    };

    const subMatch = (li: HTMLLIElement, selects: HTMLSelectElement[]) =>
      selects.every((s) => !s.value || li.dataset[s.dataset.key ?? ''] === s.value);

    const apply = (category: string) => {
      // Swap in the category's own refinement dropdowns; hidden groups
      // reset so a stale choice never filters the next visit invisibly.
      for (const g of groups) {
        const on = g.dataset.subgroup === category;
        g.classList.toggle('is-active', on);
        if (!on) {
          for (const s of g.querySelectorAll<HTMLSelectElement>('select')) {
            s.value = '';
            s.classList.remove('has-value');
          }
        }
      }
      const selects = activeSelects(category);
      let shown = 0;
      let label = 'All work';
      for (const li of items) {
        const show = li.dataset.category === category && subMatch(li, selects);
        li.hidden = !show;
        if (show) {
          shown += 1;
          // Un-hidden cards must be visible NOW — the view transition
          // snapshots before the reveal observer's async callback runs.
          li.querySelector('[data-reveal]')?.classList.add('is-visible');
        }
      }
      for (const link of links) {
        if (link.dataset.filter === category) {
          link.setAttribute('aria-current', 'true');
          label = link.dataset.label ?? label;
        } else {
          link.removeAttribute('aria-current');
        }
      }
      if (empty) empty.hidden = shown > 0;
      if (status) {
        status.textContent = `${label}: showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;
      }
      return shown;
    };

    const applyWithTransition = (category: string) => {
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduceMotion) {
        document.startViewTransition(() => apply(category));
      } else {
        apply(category);
      }
    };

    // The home page IS the Logo Design view — '/' maps to it.
    const DEFAULT = 'logo-design';

    const fromUrl = () => {
      const byPath = location.pathname.match(/^\/([^/]+)\/?$/)?.[1];
      if (byPath && valid.has(byPath)) return byPath;
      const byQuery = new URLSearchParams(location.search).get('category');
      return byQuery && valid.has(byQuery) ? byQuery : DEFAULT;
    };

    const current = () =>
      links.find((l) => l.hasAttribute('aria-current'))?.dataset.filter ?? DEFAULT;

    bar.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-filter]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      // One chip is always selected; re-clicking it changes nothing.
      if (link.hasAttribute('aria-current')) return;
      const category = link.dataset.filter ?? DEFAULT;
      // Scroll FIRST (instantly) so both view-transition snapshots are
      // captured at the same offset — no slide-then-jump.
      if (gridWrap.getBoundingClientRect().top < 0) {
        gridWrap.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
      applyWithTransition(category);
      // Push the canonical URL so Back undoes the filter step by step.
      history.pushState(null, '', category === DEFAULT ? '/' : `/${category}/`);
    });

    for (const g of groups) {
      for (const s of g.querySelectorAll<HTMLSelectElement>('select')) {
        s.addEventListener('change', () => applyWithTransition(current()));
      }
    }

    // Back/forward replays the same motion as the click that created it.
    window.addEventListener('popstate', () => applyWithTransition(fromUrl()));

    // The server already rendered the state '/' maps to; re-applying it
    // here would mark every card visible and skip the entrance reveals.
    const initial = fromUrl();
    if (initial !== current()) {
      apply(initial);
      // Normalize legacy ?category= deep links to the canonical path.
      if (location.search) history.replaceState(null, '', `/${initial}/`);
    }
  }
</script>
