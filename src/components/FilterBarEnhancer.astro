---
/**
 * Client-side filtering for the home work grid. Rendered only where the
 * FilterBar is `enhanced`, so category pages don't ship a script that can
 * never run there.
 */
---

<script>
  const bar = document.querySelector<HTMLElement>('[data-filterbar]');
  const gridWrap = document.querySelector<HTMLElement>('[data-work-grid]');

  if (bar && gridWrap) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('a[data-filter]')];
    const items = [...gridWrap.querySelectorAll<HTMLLIElement>('li[data-category]')];
    const status = gridWrap.querySelector<HTMLElement>('[data-filter-status]');
    const empty = gridWrap.querySelector<HTMLElement>('[data-work-empty]');
    const valid = new Set(links.map((l) => l.dataset.filter));

    const apply = (category: string) => {
      let shown = 0;
      let label = 'All work';
      for (const li of items) {
        const show = category === 'all' || li.dataset.category === category;
        li.hidden = !show;
        if (show) {
          shown += 1;
          // Un-hidden cards must be visible NOW — the view transition
          // snapshots before the reveal observer's async callback runs.
          li.querySelector('[data-reveal]')?.classList.add('is-visible');
        }
      }
      for (const link of links) {
        if (link.dataset.filter === category) {
          link.setAttribute('aria-current', 'true');
          label = link.dataset.label ?? label;
        } else {
          link.removeAttribute('aria-current');
        }
      }
      if (empty) empty.hidden = shown > 0;
      if (status) {
        status.textContent = `${label}: showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;
      }
    };

    const applyWithTransition = (category: string) => {
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduceMotion) {
        document.startViewTransition(() => apply(category));
      } else {
        apply(category);
      }
    };

    const fromUrl = () => {
      const byPath = location.pathname.match(/^\/([^/]+)\/?$/)?.[1];
      if (byPath && valid.has(byPath)) return byPath;
      const byQuery = new URLSearchParams(location.search).get('category');
      return byQuery && valid.has(byQuery) ? byQuery : 'all';
    };

    bar.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-filter]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const category = link.dataset.filter ?? 'all';
      // Scroll FIRST (instantly) so both view-transition snapshots are
      // captured at the same offset — no slide-then-jump.
      if (gridWrap.getBoundingClientRect().top < 0) {
        gridWrap.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
      applyWithTransition(category);
      // Push the canonical URL so Back undoes the filter step by step.
      history.pushState(null, '', link.getAttribute('href'));
    });

    // Back/forward replays the same motion as the click that created it.
    window.addEventListener('popstate', () => applyWithTransition(fromUrl()));

    const initial = fromUrl();
    if (initial !== 'all') {
      apply(initial);
      // Normalize legacy ?category= deep links to the canonical path.
      if (location.search) history.replaceState(null, '', `/${initial}/`);
    }
  }
</script>
