---
import { SITE } from '@/config/site';
import { CATEGORIES } from '@/data/categories';
import Logo from '@/components/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <section class="footer-cta" aria-labelledby="footer-cta-heading">
      <p class="overline footer-overline">Start a project</p>
      <h2 id="footer-cta-heading">Ready for a transformation?</h2>
      <p class="footer-lede">
        We're storytellers as much as designers. Tell us your brand's story and we'll make people
        feel it. Message us anytime.
      </p>
      <div class="footer-actions">
        <a
          class="button button--paper"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Message us on Fiverr <span aria-hidden="true">↗</span>
        </a>
        {
          SITE.linkedinUrl && (
            <a
              class="button button--ghost"
              href={SITE.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Connect on LinkedIn <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </section>

    <div class="footer-grid">
      <div class="footer-brand">
        <p class="wordmark wordmark-lockup footer-wordmark">
          <Logo size={26} />
          XStudioz<span class="accent-dot" aria-hidden="true">.</span>
        </p>
        <p class="footer-tag">Where your brand meets creative ideas.<br />The work speaks first.</p>
      </div>
      <nav aria-label="Services">
        <p class="overline footer-overline" id="footer-categories">Services</p>
        <ul role="list" aria-labelledby="footer-categories">
          {
            CATEGORIES.map((c) => (
              <li>
                <a href={`/${c.id}/`} data-astro-prefetch>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Studio">
        <p class="overline footer-overline" id="footer-studio">Studio</p>
        <ul role="list" aria-labelledby="footer-studio">
          <li><a href="/" data-astro-prefetch>Work</a></li>
          <li>
            <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer"
              >Fiverr <span aria-hidden="true">↗</span></a
            >
          </li>
          {
            SITE.linkedinUrl && (
              <li>
                <a href={SITE.linkedinUrl} target="_blank" rel="noopener noreferrer">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <p class="footer-legal">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-paper);
    margin-block-start: var(--space-section);
    padding-block: var(--space-section) var(--space-lg);
  }

  .footer-cta {
    max-width: var(--measure-wide);
  }

  .footer-overline {
    color: var(--color-paper-mute);
  }

  /* The deep violet rule disappears against ink — on dark surfaces the
     label leads with the bright end of the brand gradient instead. */
  .footer-overline::before {
    background: var(--color-accent-bright);
  }

  .footer-cta h2 {
    font-size: var(--text-3xl);
    margin-block: var(--space-3xs) var(--space-md);
  }

  .footer-lede {
    color: var(--color-paper-mute);
    max-width: var(--measure);
  }

  .footer-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-lg);
    border-block-start: 1px solid var(--color-line-on-ink);
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-xl);
  }

  .footer-wordmark :global(.accent-dot) {
    color: var(--color-accent-bright);
  }

  .footer-tag {
    color: var(--color-paper-mute);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
  }

  .footer-grid ul {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-sm);
    display: grid;
    gap: var(--space-3xs);
  }

  .footer-grid ul a {
    display: inline-block;
    /* 25.6px line + 2 × 9.2px = 44px touch target */
    padding-block: 0.575rem;
    color: var(--color-paper-mute);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .footer-grid ul a:hover {
      color: var(--color-paper);
    }
  }

  .footer-legal {
    color: var(--color-paper-mute);
    font-size: var(--text-xs);
    margin-block-start: var(--space-2xl);
  }

  @media (max-width: 719px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
