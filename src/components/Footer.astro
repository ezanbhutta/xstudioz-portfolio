---
import { SITE, SOCIALS } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
import Logo from '@/components/Logo.astro';

/**
 * The closing band — the site's one dark surface, so it stays an event.
 *
 * Every link here resolves to a real page: services come from the active
 * list, and a service page sells its scope whether or not it has published
 * work, so none of them can bottom out in an empty grid. Social links render
 * only when their URL is set in site.json.
 */
const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="container">
    <section class="footer-cta" aria-labelledby="footer-cta-heading">
      <div class="footer-cta-text">
        <p class="overline">Start a project</p>
        <h2 id="footer-cta-heading" class="footer-cta-title">
          Tell us about your brand<span class="accent-dot">.</span>
        </h2>
        {
          /* The site speaks as a studio everywhere else — categories.json,
            the hero, every case study. This heading was the one place it
            slipped into the first person, which read as a solo operator
            dressed up rather than as either thing done deliberately. */
        }
        <p class="footer-cta-lede">
          Send what the business does and who it is for. What comes back is a mark, its variants,
          and the files to use them — in SVG, PDF and PNG, colour and mono.
        </p>
      </div>
      <div class="footer-actions">
        <a
          class="button button--paper button--lg"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Message on Fiverr <span aria-hidden="true">↗</span>
        </a>
        {
          SITE.linkedinUrl && (
            <a
              class="button button--ghost button--lg"
              href={SITE.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Connect on LinkedIn <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </section>

    <div class="footer-grid">
      <div class="footer-brand">
        <p class="wordmark wordmark-lockup footer-wordmark">
          <Logo size={26} />
          <span>{SITE.name}<span class="accent-dot" aria-hidden="true">.</span></span>
        </p>
        <p class="footer-tag">{SITE.tagline}</p>
      </div>

      <nav aria-labelledby="footer-services">
        <p class="overline footer-heading" id="footer-services">Services</p>
        <ul role="list">
          {
            ACTIVE_CATEGORIES.map((c) => (
              <li>
                <a href={`/${c.id}/`} data-astro-prefetch>
                  {c.navLabel ?? c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-elsewhere">
        <p class="overline footer-heading" id="footer-elsewhere">Elsewhere</p>
        <ul role="list">
          <li>
            <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer"
              >Fiverr <span aria-hidden="true">↗</span></a
            >
          </li>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="footer-legal">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-cta-lede {
    margin-block-start: var(--space-xs);
    max-inline-size: 46ch;
    color: var(--color-paper-mute);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .footer {
    /* The page is already obsidian, so the footer separates by sinking
       darker behind a hairline rather than inverting to light. */
    background: var(--color-paper-sunken);
    color: var(--color-ink);
    border-block-start: 1px solid var(--color-line);
    padding-block: var(--space-section) var(--space-lg);
  }

  /* Closing statement left, actions right — one row on desktop so the band
     opens with a single confident line rather than a stacked paragraph. */
  .footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .footer-cta-title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    margin-block-start: var(--space-2xs);
    max-width: var(--measure-statement);
  }

  .footer-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    border-block-start: 1px solid var(--color-line-on-ink);
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-xl);
  }

  .footer-wordmark :global(.accent-dot) {
    color: var(--color-accent-bright);
  }

  .footer-tag {
    color: var(--color-paper-mute);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
    max-width: 24ch;
  }

  .footer-heading {
    color: var(--color-ink);
  }

  .footer-grid ul {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-2xs);
    display: grid;
    gap: var(--space-3xs);
  }

  .footer-grid ul a {
    display: inline-block;
    /* 25.6px line + 2 × 9.2px = 44px touch target */
    padding-block: 0.575rem;
    color: var(--color-paper-mute);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .footer-grid ul a:hover {
      color: var(--color-ink);
    }
  }

  .footer-legal {
    color: var(--color-paper-mute);
    font-size: var(--text-xs);
    margin-block-start: var(--space-2xl);
  }

  @media (max-width: 899px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl) var(--space-lg);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 519px) {
    .footer-actions {
      display: grid;
      width: 100%;
    }
  }
</style>
