---
import { SITE } from '@/config/site';
import Logo from '@/components/Logo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

/**
 * Wordmark and one call to action. Nothing else.
 *
 * The five services used to live here. They now sit under the hero, in the
 * page (see ServiceNav) — the visitor reads what the studio does before
 * being asked to choose between its services.
 *
 * That move deleted a whole mechanism: with the links in the document flow
 * there is no need for a mobile dialog, a focus trap, a hamburger, or the
 * script that revealed it. This component ships one line of JavaScript, and
 * only to tell the header when it has stopped being at the top of the page.
 */
---

{/* Sentinel: while it is on screen the header is at rest and stays flush */}
<div data-header-top aria-hidden="true"></div>

<header class="header" data-header>
  <div class="container header-inner">
    {
      /* Mark plus wordmark. The mark alone read as a favicon — a studio
        selling identity should show its own lockup, not an icon. */
    }
    <a class="brand-mark" href="/" data-astro-prefetch aria-label={`${SITE.name} home`}>
      <Logo size={30} />
      <span class="brand-word" aria-hidden="true">{SITE.name}<span class="accent-dot">.</span></span
      >
    </a>

    <div class="header-actions">
      <ThemeToggle />

      <a
        class="button button--primary header-cta"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="header-cta-full">Hire on Fiverr</span><span class="header-cta-short"
          >Fiverr</span
        >
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  // The header sits flush at the top of the page and only grows its hairline
  // and blur once content is passing beneath it.
  const sentinel = document.querySelector('[data-header-top]');
  const header = document.querySelector('[data-header]');
  if (sentinel && header && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-block: var(--space-sm);
    /* Transparent at rest: at the top of a page the header should feel like
       part of the paper, not a bar bolted onto it. */
    background: color-mix(in srgb, var(--color-paper) 0%, transparent);
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  /* Solid, not blurred. `backdrop-filter` is recomputed every frame the page
     scrolls under it, which is the most expensive thing a sticky bar can do —
     and on an obsidian ground a 96%-opaque panel is indistinguishable from a
     blurred one. The scroll gets the frames instead. */
  .header.is-stuck {
    background: color-mix(in srgb, var(--color-paper) 97%, transparent);
    border-block-end-color: var(--color-line);
  }

  /* Without JS the class never lands, so give the header its surface always */
  :global(html:not(.js)) .header {
    background: var(--color-paper);
    border-block-end-color: var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* The theme switch and the call to action travel together at the end of the
     bar. Gap is tighter than the header's own so they read as one cluster
     rather than two competing destinations. */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--control-h);
    text-decoration: none;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: var(--text-wordmark);
    font-weight: var(--weight-wordmark);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  @media (hover: hover) {
    .brand-mark:hover .accent-dot {
      color: var(--color-accent-deep);
    }
  }

  /* On the narrowest phones the CTA needs the room more than the wordmark */
  @media (max-width: 389px) {
    .brand-word {
      display: none;
    }
  }

  .brand-mark :global(img),
  .brand-mark :global(svg) {
    border-radius: 8px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .brand-mark:hover :global(img),
    .brand-mark:hover :global(svg) {
      transform: scale(1.05);
    }
  }

  .header-cta {
    font-size: var(--text-sm);
    padding: 0.5rem 1.125rem;
  }

  .header-cta-short {
    display: none;
  }

  @media (max-width: 519px) {
    .header-cta-full {
      display: none;
    }

    .header-cta-short {
      display: inline;
    }
  }
</style>
