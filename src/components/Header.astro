---
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
import Logo from '@/components/Logo.astro';

/**
 * Site header: brand, one destination per service, and a Fiverr call to
 * action that never leaves the screen.
 *
 * The services ARE the navigation. A visitor arrives wanting one specific
 * thing — a logo, a rulebook, a set of templates — and the top of every page
 * names all five and takes them straight there. A single "Services" link
 * would have made that a two-click journey behind a word nobody is shopping
 * for.
 *
 * There is nothing else in the row. This is a portfolio, so the navigation
 * is the portfolio: five names, five destinations, and the work. The
 * breakpoint at which the row collapses into the menu is set by measurement
 * rather than by device class — see the media query below.
 *
 * The mobile menu is a native <dialog>, which buys the focus trap, the
 * Escape key, inert background content and the top layer for free. Its
 * trigger only exists when JavaScript does (`html.js`, set before first
 * paint in BaseLayout) — below that breakpoint a no-JS visitor gets the
 * links inline instead. A button that does nothing is worse than no button.
 */
const segment = Astro.url.pathname.split('/')[1] ?? '';

/** One entry per service, in the order they are listed in categories.json. */
const SERVICES = ACTIVE_CATEGORIES.map((c) => ({
  href: `/${c.id}/`,
  label: c.navLabel ?? c.title,
  current: segment === c.id,
}));
---

{/* Sentinel: while it is on screen the header is at rest and stays flush */}
<div data-header-top aria-hidden="true"></div>

<header class="header" data-header>
  <div class="container header-inner">
    {
      /* Mark plus wordmark. The mark alone read as a favicon — a studio
        selling identity should show its own lockup, not an icon. */
    }
    <a class="brand-mark" href="/" data-astro-prefetch aria-label={`${SITE.name} home`}>
      <Logo size={30} />
      <span class="brand-word" aria-hidden="true">{SITE.name}<span class="accent-dot">.</span></span
      >
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {
          SERVICES.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                data-astro-prefetch
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="button button--primary header-cta"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="header-cta-full">Hire on Fiverr</span><span class="header-cta-short"
          >Fiverr</span
        >
        <span aria-hidden="true">↗</span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-open
        aria-expanded="false"
        aria-haspopup="dialog"
        hidden
      >
        <span class="visually-hidden">Open menu</span>
        <span class="menu-toggle-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu on-ink" data-menu aria-label="Site menu">
  <div class="menu-inner">
    <div class="menu-top">
      <span class="wordmark wordmark-lockup menu-wordmark">
        <Logo size={26} />
        <span>{SITE.name}<span class="accent-dot" aria-hidden="true">.</span></span>
      </span>
      <button type="button" class="menu-close" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    {
      /* Same order as the desktop row: services first and set large, because
        they are what a visitor came to choose between. */
    }
    <nav class="menu-nav" aria-label="Menu">
      <ul class="menu-primary" role="list">
        {
          SERVICES.map((item) => (
            <li>
              <a
                class="menu-link"
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot">
      <a
        class="button button--paper button--lg menu-cta"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hire on Fiverr <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</dialog>

<script>
  // Reveal the trigger only now that JS is running, so a no-JS visitor never
  // meets a button that cannot open anything.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');

  if (toggle && menu && typeof menu.showModal === 'function') {
    document.documentElement.classList.add('has-menu');
    toggle.hidden = false;

    const close = () => menu.open && menu.close();

    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      // The background must not scroll under an open full-screen menu.
      document.body.style.overflow = 'hidden';
      menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    });

    menu.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggle.focus();
    });

    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    // Any destination closes it — same-page anchors would otherwise leave the
    // overlay covering what the visitor just asked to see.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close();
    });
    // Clicking the surrounding darkness dismisses, like the project viewer.
    menu.addEventListener('mousedown', (event) => {
      if (event.target === menu) close();
    });
    // A menu open at phone width makes no sense once the desktop nav returns.
    matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches) close();
    });
  }

  // The header sits flush at the top of the page and only grows its hairline
  // and blur once content is passing beneath it.
  const sentinel = document.querySelector('[data-header-top]');
  const header = document.querySelector('[data-header]');
  if (sentinel && header && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-block: var(--space-sm);
    /* Transparent at rest: at the top of a page the header should feel like
       part of the paper, not a bar bolted onto it. */
    background: color-mix(in srgb, var(--color-paper) 0%, transparent);
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .header.is-stuck {
    background: color-mix(in srgb, var(--color-paper) 96%, transparent);
    backdrop-filter: blur(18px);
    border-block-end-color: var(--color-line);
  }

  /* Without JS the class never lands, so give the header its surface always */
  :global(html:not(.js)) .header {
    background: var(--color-paper);
    border-block-end-color: var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--control-h);
    text-decoration: none;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-wordmark);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  @media (hover: hover) {
    .brand-mark:hover .accent-dot {
      color: var(--color-accent-deep);
    }
  }

  /* On the narrowest phones the CTA needs the room more than the wordmark */
  @media (max-width: 389px) {
    .brand-word {
      display: none;
    }
  }

  .brand-mark :global(img),
  .brand-mark :global(svg) {
    border-radius: 8px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .brand-mark:hover :global(img),
    .brand-mark:hover :global(svg) {
      transform: scale(1.05);
    }
  }

  /* --- Desktop navigation ------------------------------------------------ */
  .nav-list {
    display: flex;
    align-items: center;
    /* Five destinations, generously spaced — the row should read as calm
       rather than as a packed toolbar. */
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .nav-link:hover {
      color: var(--color-ink);
    }
  }

  .nav-link[aria-current='page'] {
    color: var(--color-ink);
  }

  /* Active indicator hugs the text baseline instead of the 44px hit box */
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% + 0.8em);
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .nav-link:hover::after {
      transform: scaleX(1);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .header-cta {
    font-size: var(--text-sm);
    padding: 0.5rem 1.125rem;
  }

  .header-cta-short {
    display: none;
  }

  @media (max-width: 519px) {
    .header-cta-full {
      display: none;
    }

    .header-cta-short {
      display: inline;
    }
  }

  /* --- The breakpoint ----------------------------------------------------- *
     Below 900px the inline nav is replaced by the menu — but only once the
     menu can actually open. `html.has-menu` is set by this component's own
     script, so the swap and the trigger arrive together.                     */
  @media (max-width: 959px) {
    :global(html.has-menu) .nav {
      display: none;
    }

    /* No-JS fallback: the links stay, wrapping onto their own row */
    :global(html:not(.has-menu)) .header-inner {
      flex-wrap: wrap;
    }

    :global(html:not(.has-menu)) .nav {
      order: 3;
      width: 100%;
    }

    :global(html:not(.has-menu)) .nav-list {
      gap: var(--space-sm);
    }
  }

  @media (min-width: 960px) {
    .menu-toggle {
      display: none !important;
    }
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-h);
    block-size: var(--control-h);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .menu-toggle:hover {
      background: var(--color-paper-raised);
    }
  }

  .menu-toggle-bars {
    display: grid;
    gap: 5px;
    inline-size: 1.125rem;
  }

  .menu-toggle-bars i {
    display: block;
    block-size: 1.5px;
    background: currentcolor;
  }

  /* --- The menu ----------------------------------------------------------- */
  .menu {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0;
    border: none;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .menu::backdrop {
    background: rgb(13 11 16 / 60%);
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    padding: var(--space-sm) var(--gutter) var(--space-xl);
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .menu-wordmark {
    color: var(--color-paper);
  }

  .menu-wordmark :global(.accent-dot) {
    color: var(--color-accent-bright);
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-h);
    block-size: var(--control-h);
    border-radius: var(--radius-pill);
    color: var(--color-paper);
    background: rgb(255 255 255 / 8%);
  }

  @media (hover: hover) {
    .menu-close:hover {
      background: rgb(255 255 255 / 18%);
    }
  }

  .menu-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-xl);
    /* A long service list on a short phone must still scroll */
    overflow-y: auto;
  }

  .menu-primary {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .menu-link {
    display: block;
    padding-block: var(--space-2xs);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 4vw, 3.5rem);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
    color: var(--color-paper);
    text-decoration: none;
  }

  .menu-link[aria-current='page'] {
    color: var(--color-accent-bright);
  }

  .menu-service {
    display: inline-block;
    padding-block: 0.575rem;
    font-size: var(--text-lg);
    color: var(--color-paper-mute);
    text-decoration: none;
  }

  .menu-service[aria-current='page'] {
    color: var(--color-accent-bright);
  }

  .menu-foot {
    display: grid;
  }

  .menu-cta {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu-inner {
      animation: menu-in var(--duration-base) var(--ease-out) both;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>
