---
import { SITE } from '@/config/site';
import { CATEGORY_IDS } from '@/data/categories';
import Logo from '@/components/Logo.astro';

const path = Astro.url.pathname;
const isWork =
  path === '/' ||
  path.startsWith('/work/') ||
  CATEGORY_IDS.some((id) => path.startsWith(`/${id}/`));
---

<header class="header">
  <div class="container header-inner">
    <a
      class="wordmark wordmark-lockup"
      href="/"
      data-astro-prefetch
      aria-label={`${SITE.name} — home`}
    >
      <Logo size={26} />
      XStudioz<span class="accent-dot" aria-hidden="true">.</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list" role="list">
        <li>
          <a
            class="nav-link"
            href="/"
            aria-current={isWork ? 'page' : undefined}
            data-astro-prefetch>Work</a
          >
        </li>
        <li class="nav-cta">
          <a
            class="button button--outline"
            href={SITE.fiverrUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="nav-cta-full">Hire on Fiverr</span><span class="nav-cta-short">Fiverr</span
            >
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    padding-block: var(--space-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .nav-link:hover {
      color: var(--color-ink);
    }
  }

  .nav-link[aria-current='page'] {
    color: var(--color-ink);
  }

  /* Active indicator hugs the text baseline instead of the 44px hit box */
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% + 0.8em);
    height: 2px;
    background: var(--color-accent);
  }

  .nav-cta .button {
    font-size: var(--text-sm);
    padding: 0.5rem 1.125rem;
  }

  .nav-cta-short {
    display: none;
  }

  @media (max-width: 519px) {
    .nav-cta-full {
      display: none;
    }

    .nav-cta-short {
      display: inline;
    }
  }
</style>
