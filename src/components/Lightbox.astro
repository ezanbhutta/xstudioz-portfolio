---
/**
 * Full-screen presentation viewer for a project's deck.
 *
 * The case study prints every page in sequence; this is the same deck read
 * one page at a time, at full size, with the rest of the site out of the way.
 *
 * The page list is passed in explicitly rather than scraped from the DOM,
 * because the deck is entered at whatever index was clicked — the hero, or
 * any page in the stack. Any element with `data-open-page="<0-based index>"`
 * opens the viewer there.
 *
 * Progressive enhancement throughout: every page is a real image in the
 * document already. This only upgrades the way they are looked at.
 */
interface Props {
  /**
   * Every page of the deck, in order, at full display resolution.
   *
   * `chapter` is the section that page belongs to, on a deck whose pages have
   * been labelled. Full screen is where a reader is most lost — the whole
   * viewport is artwork and the only orientation is "23 / 45" — and it is the
   * one view where the chapter rules drawn down the case study are not on
   * screen. Absent on an unchaptered deck, where the counter stands alone.
   */
  pages: { src: string; alt: string; chapter?: string }[];
  /** Named in the counter, e.g. "Zion Ventures". */
  title: string;
}

const { pages, title } = Astro.props;
---

<dialog class="lightbox on-ink" data-lightbox aria-label={`${title}: presentation pages`}>
  <div class="lightbox-head">
    <p class="lightbox-where" aria-live="polite">
      <span class="lightbox-chapter" data-lightbox-chapter hidden></span>
      <span class="lightbox-counter" data-lightbox-counter></span>
    </p>
    <button type="button" class="lightbox-btn" data-lightbox-close aria-label="Close viewer">
      <span aria-hidden="true">✕</span>
    </button>
  </div>

  <div class="lightbox-stage" data-lightbox-stage>
    <img class="lightbox-img" data-lightbox-img alt="" />
  </div>

  <div class="lightbox-bar">
    <button type="button" class="lightbox-btn" data-lightbox-prev aria-label="Previous page">
      <span aria-hidden="true">←</span>
    </button>
    {
      /* The rail turns a linear deck into something you can browse rather
        than page through. Rendered here rather than built in script: Astro
        scopes component CSS with a generated attribute, and an element
        created by document.createElement never carries it — the dots would
        collapse to 0×0 and the rail would look empty. */
    }
    <div class="lightbox-rail" data-lightbox-rail role="tablist" aria-label="Pages">
      {
        pages.map((_, i) => (
          <button
            type="button"
            class="lightbox-dot"
            role="tab"
            data-dot={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Page ${i + 1}`}
          />
        ))
      }
    </div>
    <button type="button" class="lightbox-btn" data-lightbox-next aria-label="Next page">
      <span aria-hidden="true">→</span>
    </button>
  </div>
</dialog>

{/* Data, not code — the viewer reads its page list from here */}
<script is:inline type="application/json" data-lightbox-pages set:html={JSON.stringify(pages)} />

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const payload = document.querySelector<HTMLScriptElement>('[data-lightbox-pages]');

  if (dialog && payload && typeof dialog.showModal === 'function') {
    const sources: { src: string; alt: string; thumb?: string; chapter?: string }[] = JSON.parse(
      payload.textContent || '[]',
    );

    if (sources.length > 0) {
      const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
      const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
      const chapter = dialog.querySelector<HTMLElement>('[data-lightbox-chapter]')!;
      const rail = dialog.querySelector<HTMLElement>('[data-lightbox-rail]')!;
      const btnPrev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
      const btnNext = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
      const btnClose = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;

      let index = 0;
      let opener: HTMLElement | null = null;
      // Set while we unwind our own history entry, so the popstate handler
      // doesn't try to close a dialog that is already closing.
      let closingViaHistory = false;

      // One dot per page, already in the document. Makes the deck's length
      // legible at a glance in a way a "12 / 36" counter alone never does.
      const dots = [...rail.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      for (const [i, dot] of dots.entries()) dot.addEventListener('click', () => show(i));

      /** Warm the neighbours so arrowing through never shows a blank frame. */
      const preload = (i: number) => {
        for (const n of [i - 1, i + 1]) {
          const s = sources[n]?.src;
          if (s) new Image().src = s;
        }
      };

      const show = (i: number) => {
        index = (i + sources.length) % sources.length;
        const page = sources[index];
        img.src = page.src;
        img.alt = page.alt;
        counter.textContent = `${index + 1} / ${sources.length}`;
        // One live region, so the chapter and the count are announced as one
        // change rather than racing each other on every arrow press.
        chapter.textContent = page.chapter ?? '';
        chapter.hidden = !page.chapter;
        for (const [n, dot] of dots.entries()) {
          const on = n === index;
          dot.classList.toggle('is-current', on);
          dot.setAttribute('aria-selected', String(on));
          if (on) dot.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
        preload(index);
      };

      const open = (i: number, from: HTMLElement) => {
        opener = from;
        show(i);
        dialog.showModal();
        // An extra history entry means the phone's Back gesture closes the
        // viewer instead of leaving the case study entirely.
        history.pushState({ lightbox: true }, '');
        btnClose.focus();
      };

      const close = () => {
        if (dialog.open) dialog.close();
      };

      dialog.addEventListener('close', () => {
        opener?.focus();
        opener = null;
        // Drop our history entry unless popstate is what closed us.
        if (history.state?.lightbox && !closingViaHistory) history.back();
      });

      window.addEventListener('popstate', () => {
        if (!dialog.open) return;
        closingViaHistory = true;
        close();
        closingViaHistory = false;
      });

      // Delegated: one listener covers every page in the stack, however long
      // the deck is, and keeps working for anything added later.
      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-open-page]');
        if (!trigger) return;
        const at = Number(trigger.dataset.openPage);
        if (Number.isFinite(at)) {
          event.preventDefault();
          open(at, trigger);
        }
      });

      btnPrev.addEventListener('click', () => show(index - 1));
      btnNext.addEventListener('click', () => show(index + 1));
      btnClose.addEventListener('click', close);

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(index - 1);
        else if (event.key === 'ArrowRight') show(index + 1);
        else if (event.key === 'Home') show(0);
        else if (event.key === 'End') show(sources.length - 1);
      });

      // Click the surrounding darkness to dismiss. Testing the event target
      // is not enough — clicking the dialog's own padding also reports the
      // dialog — so compare against its box.
      dialog.addEventListener('click', (event) => {
        const box = dialog.getBoundingClientRect();
        const outside =
          event.clientX < box.left ||
          event.clientX > box.right ||
          event.clientY < box.top ||
          event.clientY > box.bottom;
        if (outside || (event.target as HTMLElement).dataset.lightboxStage !== undefined) close();
      });

      // Horizontal swipe on touch, ignoring vertical scroll intent.
      let startX = 0;
      let startY = 0;
      let swiping = false;
      dialog.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType === 'mouse') return;
          startX = event.clientX;
          startY = event.clientY;
          swiping = true;
        },
        { passive: true },
      );
      dialog.addEventListener(
        'pointerup',
        (event) => {
          if (!swiping) return;
          swiping = false;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  /* Only the OPEN dialog gets a display value. Setting `display: grid` on the
     bare element would beat the UA's `dialog:not([open]) { display: none }` —
     author styles win over UA styles regardless of specificity — and lay a
     full-height black panel into the page flow on every case study. */
  .lightbox[open] {
    display: grid;
    /* One row. The head and the bar are absolutely positioned over it now,
       so the artwork gets the whole viewport instead of the ~136px that two
       chrome rows used to take off the top and bottom. */
    grid-template-rows: minmax(0, 1fr);
    /* `minmax(0, 1fr)`, not the implicit `auto` column: an auto track floors
       at its widest item's min-content, and a 36-dot rail min-contents at
       554px. On a 390px phone that pushed every row off the left edge. */
    grid-template-columns: minmax(0, 1fr);
  }

  .lightbox {
    /* Fill the viewport rather than the default centred box, so the stage
       can letterbox the artwork itself. */
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0;
    border: none;
    background: #0d0b10;
    /* The viewer is its own dark room whatever the page theme. Without this
       the ink tokens resolve light-mode values inside it, and the controls —
       set in --color-ink on #0d0b10 — go nearly black on black. */
    color-scheme: dark;
    --color-ink: #f4f4f5;
    --color-paper-mute: #a1a1aa;
    --color-accent-bright: #d946ef;
    --color-line-on-ink-strong: rgb(255 255 255 / 24%);
    color: var(--color-ink);
    overflow: hidden;
  }

  /**
   * The chrome floats; the stage is the whole dialog.
   *
   * The head (~60px) and the bar (~76px) were grid rows, so "open full
   * screen" handed back 136px less height than it took. On a 1440x900
   * laptop a deck page went from 1272x716 in the page to 1440x764 in the
   * viewer — 13% wider — and a taller icon sheet came out SHORTER than it
   * had been on the page it was opened from. Overlaying the controls gives
   * the artwork the full viewport and the gain becomes real.
   */
  .lightbox-head,
  .lightbox-bar {
    position: absolute;
    inset-inline: 0;
    z-index: 2;
    /* A short scrim so controls stay legible over a light deck page. */
    background: linear-gradient(to bottom, rgb(13 11 16 / 82%), transparent);
  }

  .lightbox-head {
    inset-block-start: 0;
  }

  .lightbox-bar {
    inset-block-end: 0;
    background: linear-gradient(to top, rgb(13 11 16 / 82%), transparent);
  }

  .lightbox-stage {
    grid-row: 1 / -1;
  }

  .lightbox::backdrop {
    background: #0d0b10;
  }

  .lightbox-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-inline-size: 0;
    padding: var(--space-2xs) clamp(0.75rem, 3vw, 2rem);
  }

  .lightbox-where {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    min-inline-size: 0;
    margin: 0;
  }

  /* Truncates rather than wraps: the head is one row over the artwork, and a
     long chapter name pushing the close button off the edge would trap
     somebody in the viewer. */
  .lightbox-chapter {
    overflow: hidden;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .lightbox-chapter:not([hidden]) + .lightbox-counter::before {
    content: '·';
    margin-inline-end: var(--space-2xs);
  }

  .lightbox-counter {
    flex: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-paper-mute);
  }

  .lightbox-stage {
    position: relative;
    min-inline-size: 0;
    min-block-size: 0;
    /* Nothing may spill onto the control bar below, whatever the page ratio */
    overflow: hidden;
  }

  /* Absolutely positioned so the percentage has somewhere to land.
     As an in-flow child of a `1fr` grid row, both `max-block-size: 100%` and
     `block-size: 100%` resolved to auto — the row is not a definite height
     at percentage-resolution time — so a 16:9 page took its full intrinsic
     height, ran past the row and covered the prev/next buttons and the page
     rail. Out of flow, 100% resolves against the stage's padding box, which
     always is definite.

     The gutter is padding on the image rather than on the stage: an
     out-of-flow child is positioned against the padding box, so padding on
     the stage would not inset it. `object-fit` fits the content box, so the
     padding is exactly the letterbox margin. */
  .lightbox-img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    /* Enough to clear the floating chrome at the top and bottom without
       boxing the artwork in on a wide screen. */
    padding: 3.25rem clamp(0.5rem, 2vw, 1.5rem) 4.25rem;
    object-fit: contain;
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-inline-size: 0;
    padding: var(--space-2xs) clamp(0.75rem, 3vw, 2rem) var(--space-md);
  }

  .lightbox-rail {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-inline-size: 0;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: var(--space-2xs);
  }

  .lightbox-rail::-webkit-scrollbar {
    display: none;
  }

  .lightbox-dot {
    flex: none;
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 26%);
    /* The dot is 6px but the target is 24px — pointer accuracy is not the
       same thing as visual weight. */
    outline-offset: 6px;
    box-shadow: 0 0 0 9px transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .lightbox-dot.is-current {
    background: var(--color-accent-bright);
    transform: scale(1.6);
  }

  @media (hover: hover) {
    .lightbox-dot:hover {
      background: var(--color-ink);
    }
  }

  .lightbox-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-h);
    block-size: var(--control-h);
    border-radius: var(--radius-pill);
    font-size: var(--text-md);
    color: var(--color-ink);
    background: rgb(255 255 255 / 8%);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .lightbox-btn:hover {
      background: rgb(255 255 255 / 18%);
    }
  }

  .lightbox-btn:active {
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox-img {
      animation: lightbox-in var(--duration-base) var(--ease-out) both;
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }
</style>
