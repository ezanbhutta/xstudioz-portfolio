---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The XStudioz mark.
 *
 * EXACT-FILE MODE: drop the original logo file in the repo as
 * src/assets/logo-original.png (or .jpg/.webp) and it is used verbatim here
 * and — after `npm run og` — for the favicon, touch icon and social card.
 *
 * Until that file exists, a faithful vector recreation renders instead:
 * white outlined X on the violet→magenta gradient with the pink corner glow.
 */
interface Props {
  /** Rendered size in CSS pixels. */
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;

const originals = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/logo-original.{png,jpg,jpeg,webp}',
  { eager: true },
);
const original = Object.values(originals)[0]?.default;

const uid = `xg-${Math.random().toString(36).slice(2, 8)}`;
---

{
  original ? (
    <Image
      src={original}
      alt=""
      width={size * 2}
      height={size * 2}
      style={`width:${size}px;height:${size}px`}
      class={className}
      loading="eager"
    />
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 100 100"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id={uid} x1="0" y1="100" x2="100" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#5e0fa8" />
          <stop offset="0.5" stop-color="#9c1fd6" />
          <stop offset="1" stop-color="#e33ed4" />
        </linearGradient>
        <radialGradient id={`${uid}-glow`} cx="0.88" cy="0.08" r="0.55">
          <stop offset="0" stop-color="#ff8ae2" stop-opacity="0.9" />
          <stop offset="1" stop-color="#ff8ae2" stop-opacity="0" />
        </radialGradient>
        {/* Outline ring: outer X silhouette minus inner X, so the badge
            gradient (glow included) shows through the mark's interior. */}
        <mask id={`${uid}-m`}>
          <g transform="translate(50 50) scale(0.74) rotate(45) translate(-50 -50)">
            <rect x="35" y="12" width="30" height="76" rx="11" fill="#fff" />
            <rect x="12" y="35" width="76" height="30" rx="11" fill="#fff" />
            <rect x="42" y="19" width="16" height="62" rx="6" fill="#000" />
            <rect x="19" y="42" width="62" height="16" rx="6" fill="#000" />
          </g>
        </mask>
      </defs>
      <rect width="100" height="100" rx="10" fill={`url(#${uid})`} />
      <rect width="100" height="100" rx="10" fill={`url(#${uid}-glow)`} />
      <rect width="100" height="100" fill="#fff" mask={`url(#${uid}-m)`} />
    </svg>
  )
}
