---
/**
 * The XStudioz mark: white outlined X on the brand violet→magenta gradient.
 * Inline SVG so it ships with zero requests and scales crisply anywhere.
 * The inner X is filled with the same gradient as the badge, which reads as
 * a punch-out and keeps the outline silhouette clean.
 */
interface Props {
  /** Rendered size in CSS pixels. */
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
const uid = `xg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="100" x2="100" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--color-brand-violet, #5e17b8)"></stop>
      <stop offset="0.55" stop-color="var(--color-brand-purple, #a928d9)"></stop>
      <stop offset="1" stop-color="var(--color-brand-magenta, #ed4fcf)"></stop>
    </linearGradient>
    {
      /* Same gradient counter-rotated so the punch-out aligns with the badge
        from inside the rotated group. */
    }
    <linearGradient
      id={`${uid}-i`}
      x1="0"
      y1="100"
      x2="100"
      y2="0"
      gradientUnits="userSpaceOnUse"
      gradientTransform="rotate(-45 50 50)"
    >
      <stop offset="0" stop-color="var(--color-brand-violet, #5e17b8)"></stop>
      <stop offset="0.55" stop-color="var(--color-brand-purple, #a928d9)"></stop>
      <stop offset="1" stop-color="var(--color-brand-magenta, #ed4fcf)"></stop>
    </linearGradient>
  </defs>
  <rect width="100" height="100" rx="24" fill={`url(#${uid})`}></rect>
  <g transform="rotate(45 50 50)">
    <rect x="35" y="12" width="30" height="76" rx="11" fill="#fff"></rect>
    <rect x="12" y="35" width="76" height="30" rx="11" fill="#fff"></rect>
    <rect x="42" y="19" width="16" height="62" rx="6" fill={`url(#${uid}-i)`}></rect>
    <rect x="19" y="42" width="62" height="16" rx="6" fill={`url(#${uid}-i)`}></rect>
  </g>
</svg>
