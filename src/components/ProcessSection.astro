---
import { STUDIO } from '@/data/studio';

/**
 * The process, in two densities.
 *
 * `detail` off (homepage): four ledger rows — the shape of the engagement at
 * a glance, with a link to the full page.
 *
 * `detail` on (/process/): every stage opens into the two columns that
 * actually build confidence — what the client is responsible for, and what
 * lands in their hands. Design goes wrong when nobody says who owns what.
 *
 * The revisions and timeline notes render only when they are filled in
 * (Site settings → Studio content → Process). They are commercial terms, so
 * they stay empty until the studio states its own.
 */
interface Props {
  detail?: boolean;
  /** Rendered as the section heading; omit to use the copy from studio.json. */
  headingId?: string;
}

const { detail = false, headingId = 'process-heading' } = Astro.props;
const { process } = STUDIO;
---

<div class="process">
  <div class="section-head">
    {/* On /process/ the page hero already carries this label — twice reads as
      a template with the slots left in. */}
    {!detail && <p class="overline">{process.overline}</p>}
    <h2 id={headingId} class="section-title">{process.title}</h2>
    <p class="section-lede">{process.lede}</p>
  </div>

  <ol class:list={['steps', { 'steps--detail': detail }]} role="list">
    {
      process.steps.map((step, i) => (
        <li class="step" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span class="step-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="step-head">
            <h3 class="step-title">{step.name}</h3>
            <p class="step-summary">{step.summary}</p>
          </div>
          {detail && (
            <div class="step-detail">
              <div class="step-col">
                <p class="overline overline--bare step-col-label">You provide</p>
                <ul class="spec-list" role="list">
                  {step.client.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="step-col">
                <p class="overline overline--bare step-col-label">You receive</p>
                <ul class="spec-list" role="list">
                  {step.studio.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ol>

  {
    detail && (process.revisionsNote || process.timelineNote) && (
      <p class="process-terms">
        {process.revisionsNote && <span>{process.revisionsNote}</span>}
        {process.timelineNote && <span>{process.timelineNote}</span>}
      </p>
    )
  }
</div>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) 0 0;
    border-block-start: 1px solid var(--color-line);
  }

  /* Numeral in the margin, then the row's content — an index, not a set of
     cards. The row rule does the separating work, so nothing needs a box. */
  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-line);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .step-head {
    display: grid;
    gap: var(--space-2xs);
  }

  /* Condensed mode reads across: name in a fixed column, summary beside it */
  @media (min-width: 720px) {
    .steps:not(.steps--detail) .step-head {
      grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-md);
    }
  }

  @media (hover: hover) {
    .steps:not(.steps--detail) .step:hover {
      background: var(--color-paper-raised);
    }
  }

  .step-num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .step-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .step-summary {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  /* --- Detailed mode ----------------------------------------------------- */
  .steps--detail .step {
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    padding-block: var(--space-xl);
  }

  .steps--detail .step-head {
    display: grid;
    gap: var(--space-2xs);
  }

  .steps--detail .step-title {
    font-size: var(--text-2xl);
  }

  .step-detail {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-lg);
    margin-block-start: var(--space-md);
  }

  .step-col-label {
    color: var(--color-ink);
    margin-block-end: var(--space-2xs);
  }

  .process-terms {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 719px) {
    .step,
    .steps--detail .step {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-2xs) var(--space-sm);
      padding-block: var(--space-sm);
    }

    .step-summary {
      grid-column: 2;
      font-size: var(--text-sm);
    }

    .steps--detail .step {
      padding-block: var(--space-lg);
    }
  }
</style>
