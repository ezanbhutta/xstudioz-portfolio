---
import { Picture } from 'astro:assets';
import { getCategory } from '@/data/categories';
import { lqipStyle } from '@/lib/lqip';
import { projectType } from '@/lib/projects';
import type { ReadyProject } from '@/lib/projects';

interface Props {
  project: ReadyProject;
  /** Above-the-fold cards load eagerly with high priority. */
  eager?: boolean;
  /** Stagger position for the entrance reveal. */
  index?: number;
  /** Rendered but not shown until the filter script reveals it. */
  hidden?: boolean;
  /** The first visible card paints instantly instead of scroll-revealing. */
  lead?: boolean;
  /** Overrides the responsive sizes hint when the card sits in a narrow rail. */
  sizes?: string;
}

const {
  project,
  eager = false,
  index = 0,
  hidden = false,
  lead = false,
  sizes = '(min-width: 1360px) 592px, (min-width: 680px) 45vw, 92vw',
} = Astro.props;

const { title, category, cover, coverAlt, industry, logoType } = project.data;
const serviceLabel = getCategory(category).title;
const kind = projectType(project.data);
// Service then industry — the taxonomy a buyer shops by. The type stays a
// filter facet rather than caption text: it belongs on the case study.
const meta = [serviceLabel, industry].filter(Boolean).join(' · ');
const href = `/work/${project.id}/`;
// Two-column grid: the left card leads its right neighbour by one beat.
const delay = (index % 2) * 60;
const placeholder = await lqipStyle(cover);
---

{
  /* Only an explicitly-flagged lead card skips the scroll reveal (it is the
    mobile LCP and must paint instantly); `eager` still controls fetch
    priority. Everything else wipes in as it arrives — consistency reads as
    polish. */
}
<li
  class="card"
  data-category={category}
  data-industry={industry}
  data-type={kind}
  data-logo-type={logoType}
  data-title={title}
  hidden={hidden}
>
  <a
    class="card-link"
    href={href}
    data-astro-prefetch
    data-reveal={lead ? undefined : ''}
    style={lead ? undefined : `--reveal-delay:${delay}ms`}
  >
    <div class="card-media" data-vt={`work-${project.id}`}>
      <Picture
        src={cover}
        alt={coverAlt || `${title} presentation cover`}
        formats={['webp']}
        fallbackFormat="webp"
        widths={[480, 900, 1400]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        style={placeholder}
      />
    </div>
    {/* Museum-label caption: quiet, stacked, secondary to the image. */}
    <div class="card-caption">
      <h3 class="card-title">{title}</h3>
      <p class="card-meta">{meta}</p>
    </div>
  </a>
</li>

<style>
  .card-link {
    display: block;
    text-decoration: none;
  }

  /* Hairline frame — these are plates on a wall, and a light cover against
     warm paper needs an edge or it bleeds into the page. The frame lifts
     into a soft shadow on hover so the card rises toward the cursor
     instead of only zooming inside its own box. */
  .card-media {
    /* The cover is shown whole, at whatever proportion it was made in — a
       presentation cover cropped to a house ratio loses the composition it
       was designed with. */
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-paper-raised);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .card-media :global(img) {
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card-caption {
    padding-block-start: var(--space-sm);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    display: inline-block;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    padding-block-end: 2px;
    /* Same clock as the image zoom — one gesture, one landing. */
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .card-meta {
    margin-block-start: var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  @media (hover: hover) {
    .card-link:hover .card-media {
      box-shadow: var(--image-frame-hover), var(--shadow-lift);
    }

    .card-link:hover .card-media :global(img) {
      transform: scale(1.02);
    }

    .card-link:hover .card-title {
      background-size: 100% 2px;
    }
  }

  /* Keyboard users get the same affordance as mouse users */
  .card-link:focus-visible .card-title {
    background-size: 100% 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link:hover .card-media :global(img) {
      transform: none;
    }
  }
</style>
