---
import { Picture } from 'astro:assets';
import { getCategory } from '@/data/categories';
import { lqipStyle } from '@/lib/lqip';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  /** Above-the-fold cards load eagerly with high priority. */
  eager?: boolean;
  /** Stagger position for the entrance reveal. */
  index?: number;
}

const { project, eager = false, index = 0 } = Astro.props;
const { title, category, year, cover } = project.data;
const categoryLabel = getCategory(category).title;
const href = `/work/${project.id}/`;
const delay = (index % 4) * 60;
const placeholder = await lqipStyle(cover);
---

{
  /* Eager cards skip the scroll reveal so their high-priority fetch paints
    immediately instead of arriving invisible. */
}
<li class="card" data-category={category}>
  <a
    class="card-link"
    href={href}
    data-astro-prefetch
    data-reveal={eager ? undefined : ''}
    style={eager ? undefined : `--reveal-delay:${delay}ms`}
  >
    <div class="card-media" data-vt={`work-${project.id}`}>
      <Picture
        src={cover}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1360px) 592px, (min-width: 680px) 45vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        style={placeholder}
      />
    </div>
    {/* Museum-label caption: quiet, stacked, secondary to the image. */}
    <div class="card-caption">
      <h3 class="card-title">{title}</h3>
      <p class="card-meta">{categoryLabel} · {year}</p>
    </div>
  </a>
</li>

<style>
  .card-link {
    display: block;
    text-decoration: none;
  }

  .card-media {
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-line);
  }

  .card-media :global(img) {
    width: 100%;
    height: auto;
    transition: transform 700ms var(--ease-out);
  }

  .card-caption {
    padding-block-start: var(--space-sm);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    display: inline-block;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    padding-block-end: 2px;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .card-meta {
    margin-block-start: var(--space-3xs);
    color: var(--color-ink-mute);
    font-size: var(--text-sm);
  }

  @media (hover: hover) {
    .card-link:hover .card-media :global(img) {
      transform: scale(1.02);
    }

    .card-link:hover .card-title {
      background-size: 100% 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link:hover .card-media :global(img) {
      transform: none;
    }
  }
</style>
