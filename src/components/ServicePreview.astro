---
import WorkGrid from '@/components/WorkGrid.astro';
import type { Category } from '@/data/categories';
import type { ReadyProject } from '@/lib/projects';

/**
 * One service on the homepage: what it is, what it gets you, and the two
 * strongest examples — then out to that service's own page for the rest.
 *
 * The homepage's job is to establish taste quickly and hand off, not to be
 * the whole portfolio. Every project stacked here made a page long enough
 * that the call to action arrived after the visitor had stopped reading.
 *
 * The heading is the service name and nothing else — no count, no strapline.
 * This is a portfolio: the work is the argument, and a row of covers under a
 * name says more than a sentence explaining the name would.
 *
 * EVERY service renders, including one with nothing published. An empty
 * section is not a failure state here; it says the studio offers the thing
 * and has not shown it yet, which is true and is what a visitor scanning
 * the range needs to know.
 *
 * There is nothing to filter in a set of two, so the facets live on the
 * service page (see SectionFilters), where the full set is.
 */
interface Props {
  category: Category;
  /** Every project in this service — the preview and the count both derive from it. */
  projects: ReadyProject[];
  /** How many to show before handing off. */
  count?: number;
  /** The very first card on the page paints instantly (it is the LCP). */
  lead?: boolean;
}

const { category, projects, count = 2, lead = false } = Astro.props;

const headingId = `section-${category.id}`;
// The first by `order`, so which two appear is a content decision.
const preview = projects.slice(0, count);
const remaining = projects.length - preview.length;
---

<section class="preview" aria-labelledby={headingId}>
  <div class="container">
    <h2 id={headingId} class="preview-title" data-reveal>{category.title}</h2>

    {
      preview.length > 0 && (
        <div class="preview-body">
          <WorkGrid projects={preview} eagerCount={lead ? 2 : 0} leadFirst={lead} labelled />
        </div>
      )
    }

    <p class="preview-more" data-reveal>
      <a class="link-arrow" href={`/${category.id}/`} data-astro-prefetch>
        {
          /* Names what is behind the link. A bare "See all" makes the visitor
            click to find out whether it is worth clicking — and on a service
            with nothing published yet it would be a promise the page cannot
            keep. */
        }
        {
          preview.length === 0
            ? `About ${category.title}`
            : remaining > 0
              ? `See all ${projects.length} ${category.title} projects`
              : `About ${category.title}`
        }
      </a>
    </p>
  </div>
</section>

<style>
  .preview {
    padding-block: var(--space-3xl);
    border-block-start: 1px solid var(--color-line);
  }

  /* ServiceNav already draws a rule under itself, so the first preview must
     not draw a second one 1px below it. */
  :global(.servicenav) + .preview {
    border-block-start: none;
  }

  /* Set at section scale, not heading scale. With the page stripped to the
     work, these five names are the structure of the whole site — they should
     land with the same confidence as the hero, one step down. */
  .preview-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }

  .preview-body {
    margin-block-start: var(--space-xl);
  }

  .preview-more {
    margin-block-start: var(--space-lg);
  }
</style>
