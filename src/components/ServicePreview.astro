---
import WorkGrid from '@/components/WorkGrid.astro';
import type { Category } from '@/data/categories';
import type { ReadyProject } from '@/lib/projects';

/**
 * One service on the homepage: what it is, what it gets you, and the two
 * strongest examples — then out to that service's own page for the rest.
 *
 * The homepage's job is to establish taste quickly and hand off, not to be
 * the whole portfolio. Every project stacked here made a page long enough
 * that the call to action arrived after the visitor had stopped reading.
 *
 * The heading is the service name and nothing else — no count, no strapline.
 * This is a portfolio: the work is the argument, and a row of covers under a
 * name says more than a sentence explaining the name would.
 *
 * EVERY service renders, including one with nothing published. An empty
 * section is not a failure state here; it says the studio offers the thing
 * and has not shown it yet, which is true and is what a visitor scanning
 * the range needs to know.
 *
 * There is nothing to filter in a set of two, so the facets live on the
 * service page (see SectionFilters), where the full set is.
 */
interface Props {
  category: Category;
  /** Every project in this service — the preview and the count both derive from it. */
  projects: ReadyProject[];
  /** How many to show before handing off. */
  count?: number;
  /** The very first card on the page paints instantly (it is the LCP). */
  lead?: boolean;
  /**
   * How the work qualifies. A service with no case study of its own can still
   * have shipped inside other projects, and saying which is which is the
   * difference between evidence and a claim — the service page has always
   * drawn that line, so the homepage draws it in the same words.
   */
  directCount?: number;
  viaExtrasCount?: number;
  /** Position among the sections that have work — printed as the section number. */
  index?: number;
}

const {
  category,
  projects,
  count = 2,
  lead = false,
  directCount = projects.length,
  viaExtrasCount = 0,
  index = 0,
} = Astro.props;

/** Everything shown came in through an extra — so the row needs saying. */
const allViaExtras = directCount === 0 && viaExtrasCount > 0;

const headingId = `section-${category.id}`;
// The first by `order`, so which two appear is a content decision.
const preview = projects.slice(0, count);
const remaining = projects.length - preview.length;
---

<section class="preview" aria-labelledby={headingId}>
  <div class="container">
    {
      /* Numbered, and the count said out loud.
 
        These five names are the structure of the site, and a stack of five
        display headings with nothing between them reads as five separate
        pages that happen to share a scroll. A numeral and a count turn it
        into one document with sections — the visitor knows where they are and
        how much is left, which is the whole job of a running head. The number
        is the section's position; nothing is typed to get it. */
    }
    <div class="preview-head" data-reveal>
      <span class="preview-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h2 id={headingId} class="preview-title">{category.title}</h2>
      {
        projects.length > 0 && (
          <span class="preview-count">
            {projects.length} {projects.length === 1 ? 'project' : 'projects'}
          </span>
        )
      }
    </div>

    {
      preview.length > 0 && (
        <div class="preview-body">
          {allViaExtras && (
            <p class="preview-secondary-label" data-reveal>
              Delivered as part of these identity projects
            </p>
          )}
          <WorkGrid projects={preview} eagerCount={lead ? 2 : 0} leadFirst={lead} labelled />
        </div>
      )
    }

    <p class="preview-more" data-reveal>
      <a class="link-arrow" href={`/${category.id}/`} data-astro-prefetch>
        {
          /* Names what is behind the link. A bare "See all" makes the visitor
            click to find out whether it is worth clicking — and on a service
            with nothing published yet it would be a promise the page cannot
            keep. */
        }
        {
          preview.length === 0
            ? `About ${category.title}`
            : remaining > 0
              ? `See all ${projects.length} ${category.title} projects`
              : `About ${category.title}`
        }
      </a>
    </p>
  </div>
</section>

<style>
  .preview-secondary-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin-block-end: var(--space-sm);
  }

  .preview {
    padding-block: var(--space-3xl);
    border-block-start: 1px solid var(--color-line);
  }

  /* ServiceNav already draws a rule under itself, so the first preview must
     not draw a second one 1px below it. */
  :global(.servicenav) + .preview {
    border-block-start: none;
  }

  /* The numeral hangs outside the title's optical edge on a wide screen, the
     way a running head sits in a margin — inline with it below that, where
     there is no margin to hang into. */
  .preview-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--space-sm);
  }

  .preview-index {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .preview-count {
    justify-self: end;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-mute);
  }

  @media (min-width: 1200px) {
    .preview-head {
      /* The numeral in the margin, the rule running to the far edge under the
         whole head — a section opening, not a heading with a badge. */
      margin-inline-start: -3.25rem;
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
      column-gap: 0;
    }
  }

  /* Set at section scale, not heading scale. With the page stripped to the
     work, these five names are the structure of the whole site — they should
     land with the same confidence as the hero, one step down. */
  .preview-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }

  .preview-body {
    margin-block-start: var(--space-xl);
  }

  .preview-more {
    margin-block-start: var(--space-lg);
  }
</style>
