---
import { ACTIVE_CATEGORIES } from '@/data/categories';
import type { CategoryId } from '@/data/categories';

/**
 * Services as a set-in-type index: the name at display scale, the promise
 * beside it, the whole row a link.
 *
 * Deliberately not cards. The rest of the page already uses numbered ledger
 * rows for the process and the expectations; a third numbered list would read
 * as a tic. Scale is what separates this section from those.
 *
 * Every row goes to a page that sells the service on its own terms, so a
 * service with no published work yet is still a real destination — no
 * "0 projects" dead end, and no disabled navigation.
 */
interface Props {
  /** Project counts per service; shown only where there is work to see. */
  counts?: Partial<Record<CategoryId, number>>;
}

const { counts = {} } = Astro.props;
---

<ul class="services" role="list">
  {
    ACTIVE_CATEGORIES.map((c, i) => {
      const count = counts[c.id] ?? 0;
      return (
        <li class="service" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <a class="service-link" href={`/${c.id}/`} data-astro-prefetch>
            <span class="service-name">
              {c.title}
              {count > 0 && (
                <span class="service-count" aria-label={`${count} projects`}>
                  {count}
                </span>
              )}
            </span>
            <span class="service-outcome">{c.outcome ?? c.description}</span>
            <span class="service-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .services {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) 0 0;
    border-block-start: 1px solid var(--color-line);
  }

  .service {
    border-block-end: 1px solid var(--color-line);
  }

  .service-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-lg);
    padding-block: var(--space-md);
    text-decoration: none;
    transition: padding-inline-start var(--duration-base) var(--ease-out);
  }

  @media (min-width: 900px) {
    .service-link {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto;
      align-items: center;
    }
  }

  .service-name {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-ink);
    transition: color var(--duration-base) var(--ease-out);
  }

  /* Raised like a footnote marker, never competing with the name */
  .service-count {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    align-self: start;
  }

  .service-outcome {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .service-arrow {
    grid-column: -1;
    grid-row: 1;
    font-size: var(--text-xl);
    color: var(--color-ink-mute);
    transition:
      translate var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  @media (min-width: 900px) {
    .service-arrow {
      grid-row: auto;
    }
  }

  @media (hover: hover) {
    /* The row steps toward the reader rather than lighting up — quieter, and
       it makes the whole strip feel like a physical index card moving. */
    .service-link:hover {
      padding-inline-start: var(--space-sm);
    }

    .service-link:hover .service-name {
      color: var(--color-accent);
    }

    .service-link:hover .service-arrow {
      translate: 0.35em 0;
      color: var(--color-accent);
    }
  }

  .service-link:focus-visible .service-arrow {
    translate: 0.35em 0;
    color: var(--color-accent);
  }
</style>
