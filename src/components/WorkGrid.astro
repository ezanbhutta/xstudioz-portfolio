---
import ProjectCard from '@/components/ProjectCard.astro';
import type { ReadyProject } from '@/lib/projects';

interface Props {
  projects: ReadyProject[];
  /** How many cards start above the fold and should load eagerly. */
  eagerCount?: number;
  /** Screen-reader heading that keeps the document outline sequential. */
  heading?: string;
  /**
   * `editorial` — a four-card magazine rhythm on a twelve-column field, each
   * plate a different width and offset. For fixed sets (home, service pages)
   * where nothing is hidden and the sequence is known.
   *
   * `grid` — an even two-column field with the right column dropped by one
   * beat. For the All Work page, where filtering hides cards and an
   * asymmetric rhythm would collapse into holes.
   */
  rhythm?: 'editorial' | 'grid';
  /** Marks the grid for the All Work filter script. */
  filterable?: boolean;
  /** The first card paints instantly rather than scroll-revealing. */
  leadFirst?: boolean;
}

const {
  projects,
  eagerCount = 2,
  heading = 'Projects',
  rhythm = 'editorial',
  filterable = false,
  leadFirst = false,
} = Astro.props;
---

<div class="work" data-work-grid={filterable ? '' : undefined}>
  <h2 class="visually-hidden">{heading}</h2>
  <ul class:list={['work-grid', `work-grid--${rhythm}`]} role="list">
    {
      projects.map((project, i) => (
        <ProjectCard
          project={project}
          index={i}
          eager={i < eagerCount}
          lead={leadFirst && i === 0}
          size={rhythm === 'editorial' && i % 4 === 0 ? 'feature' : 'default'}
          sizes={
            rhythm === 'editorial'
              ? '(min-width: 1100px) 46vw, (min-width: 680px) 45vw, 92vw'
              : '(min-width: 1360px) 592px, (min-width: 680px) 45vw, 92vw'
          }
        />
      ))
    }
  </ul>
</div>

<script>
  // Name the clicked card for the cross-document view transition only at
  // interaction time — statically naming every card makes the browser
  // snapshot all of them on navigation to pair just one.
  document.addEventListener('click', (event) => {
    const media = (event.target as HTMLElement)
      .closest('.card-link')
      ?.querySelector<HTMLElement>('[data-vt]');
    if (media?.dataset.vt) {
      // Clear stale names first — bfcache restores keep inline styles, and
      // every stale name is an extra snapshot on the next navigation.
      for (const el of document.querySelectorAll<HTMLElement>('[data-vt]')) {
        el.style.viewTransitionName = '';
      }
      media.style.viewTransitionName = media.dataset.vt;
    }
  });

  // Pair the RETURN trip too: arriving back from a project page, name that
  // project's card before first render so the cover morphs home instead of
  // fading out alone.
  addEventListener('pagereveal', () => {
    const nav = (window as { navigation?: { activation?: { from?: { url?: string } } } })
      .navigation;
    const from = nav?.activation?.from?.url ?? document.referrer;
    const slug = from?.match(/\/work\/([^/]+)\//)?.[1];
    const media = slug && document.querySelector<HTMLElement>(`[data-vt="work-${slug}"]`);
    if (media) media.style.viewTransitionName = `work-${slug}`;
  });
</script>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl) var(--space-xl);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* --- Even field: the All Work page ------------------------------------- */
  @media (min-width: 680px) {
    .work-grid--grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Editorial offset — the right column starts lower, so pairs never sit
       in a rigid row and each cover gets its own moment. Counts only visible
       cards so it survives filtering, and only engages once four are showing:
       with two or three cards the stagger reads as a broken grid rather than
       a rhythm, which is exactly how a thin filter result used to look. */
    .work-grid--grid:global(:has(> li:nth-child(4 of :not([hidden])))) {
      padding-block-end: var(--space-2xl);
    }

    .work-grid--grid:global(:has(> li:nth-child(4 of :not([hidden]))))
      > :global(li:nth-child(even of :not([hidden]))) {
      transform: translateY(var(--space-2xl));
    }
  }

  /* --- Magazine rhythm: home and service pages --------------------------- *
     A four-card cycle on a twelve-column field. No two consecutive plates
     share a width or a baseline, which is what stops a portfolio grid from
     reading as a product catalogue. Fixed sets only — see the `rhythm` prop. */
  @media (min-width: 680px) and (max-width: 1099px) {
    .work-grid--editorial {
      grid-template-columns: 1fr 1fr;
    }

    .work-grid--editorial > :global(li:nth-child(even)) {
      transform: translateY(var(--space-2xl));
    }

    .work-grid--editorial {
      padding-block-end: var(--space-2xl);
    }
  }

  @media (min-width: 1100px) {
    .work-grid--editorial {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-xl);
      row-gap: var(--space-3xl);
    }

    .work-grid--editorial > :global(li) {
      align-self: start;
    }

    .work-grid--editorial > :global(li:nth-child(4n + 1)) {
      grid-column: 1 / span 7;
    }

    .work-grid--editorial > :global(li:nth-child(4n + 2)) {
      grid-column: 8 / span 5;
      margin-block-start: var(--space-3xl);
    }

    .work-grid--editorial > :global(li:nth-child(4n + 3)) {
      grid-column: 1 / span 5;
    }

    .work-grid--editorial > :global(li:nth-child(4n + 4)) {
      grid-column: 7 / span 6;
      margin-block-start: var(--space-2xl);
    }
  }
</style>
