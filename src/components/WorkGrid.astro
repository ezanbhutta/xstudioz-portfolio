---
import ProjectCard from '@/components/ProjectCard.astro';
import type { ReadyProject } from '@/lib/projects';

interface Props {
  projects: ReadyProject[];
  /** How many cards start above the fold and should load eagerly. */
  eagerCount?: number;
  /** Screen-reader heading that keeps the document outline sequential. */
  heading?: string;
  /** Marks the grid for a filter script (All Work, or one homepage section). */
  filterable?: boolean;
  /** The first card paints instantly rather than scroll-revealing. */
  leadFirst?: boolean;
  /** Omit the visually-hidden heading where a real one already precedes it. */
  labelled?: boolean;
}

const {
  projects,
  eagerCount = 2,
  heading = 'Projects',
  filterable = false,
  leadFirst = false,
  labelled = false,
} = Astro.props;
---

{
  /* A bento field: a wide tile beside a narrow one, alternating which side is
    wide. Every tile keeps the covers' own 16:9, so the artwork is never
    letterboxed or cropped and the bento comes from WIDTH alone — a narrow
    tile is simply half as wide and half as tall as its neighbour. */
}
<div class="work" data-work-grid={filterable ? '' : undefined}>
  {!labelled && <h2 class="visually-hidden">{heading}</h2>}
  <ul class="work-grid" role="list">
    {
      projects.map((project, i) => (
        <ProjectCard
          project={project}
          index={i}
          eager={i < eagerCount}
          lead={leadFirst && i === 0}
        />
      ))
    }
  </ul>
</div>

<script>
  // Name the clicked card for the cross-document view transition only at
  // interaction time — statically naming every card makes the browser
  // snapshot all of them on navigation to pair just one.
  document.addEventListener('click', (event) => {
    const media = (event.target as HTMLElement)
      .closest('.card-link')
      ?.querySelector<HTMLElement>('[data-vt]');
    if (media?.dataset.vt) {
      // Clear stale names first — bfcache restores keep inline styles, and
      // every stale name is an extra snapshot on the next navigation.
      for (const el of document.querySelectorAll<HTMLElement>('[data-vt]')) {
        el.style.viewTransitionName = '';
      }
      media.style.viewTransitionName = media.dataset.vt;
    }
  });

  // Pair the RETURN trip too: arriving back from a project page, name that
  // project's card before first render so the cover morphs home instead of
  // fading out alone.
  addEventListener('pagereveal', () => {
    const nav = (window as { navigation?: { activation?: { from?: { url?: string } } } })
      .navigation;
    const from = nav?.activation?.from?.url ?? document.referrer;
    const slug = from?.match(/\/work\/([^/]+)\//)?.[1];
    const media = slug && document.querySelector<HTMLElement>(`[data-vt="work-${slug}"]`);
    if (media) media.style.viewTransitionName = `work-${slug}`;
  });
</script>

<style>
  /**
   * A wall, not a bento.
   *
   * The 7 + 5 bento was designed against 16:9 deck covers, where "half as
   * wide" is also "half as tall" and two tiles in a row end within a hundred
   * pixels of each other. The work is not that shape. Four of the five
   * published covers are brand boards around 1542x2100 — portrait, ratio 0.70
   * — and at 1440 the split put an 796x1042 tile beside a 568x744 one: a
   * 300px step at the foot of every row, then a hole before the next row
   * cleared the taller of the two. A grid of ragged blocks.
   *
   * Columns instead of grid tracks. Each column flows independently, so tiles
   * of any height stack without leaving holes and every board keeps its own
   * proportions — nothing is cropped to make a row line up, which is the
   * whole point when the thing in the box is somebody's identity system.
   *
   * Column order also happens to be the right order: the browser fills column
   * one top to bottom before column two, which is exactly the sequence the
   * DOM is in, so reading order, tab order and visual order agree. A row-major
   * grid gets that wrong the moment the tiles are different heights.
   */
  .work-grid {
    columns: 1;
    column-gap: clamp(1rem, 2.5vw, 2.25rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-grid > :global(li) {
    /* A card must never be split across the column break. */
    break-inside: avoid;
    /* The gap between boards down a column. Margin rather than `gap`, which
       multi-column layout does not have in the block direction. */
    margin-block-end: var(--space-3xl);
  }

  /* Astro inlines this component's <script> as an element inside the <ul>.
     It has no box, but it can still take a column slot's worth of nothing at
     the foot of a column if it is allowed to break. */
  .work-grid > :global(script) {
    display: none;
  }

  /* Two boards abreast is the most this work can take: at 1440 that is 682px
     each, and a 682px board is 892px tall. Three would be 447px, which is a
     thumbnail of a document. */
  @media (min-width: 900px) {
    .work-grid {
      columns: 2;
    }
  }
</style>
