---
import ProjectCard from '@/components/ProjectCard.astro';
import { SITE } from '@/config/site';
import type { CategoryId } from '@/data/categories';
import type { ReadyProject } from '@/lib/projects';

interface Props {
  projects: ReadyProject[];
  /** How many cards start above the fold and should load eagerly. */
  eagerCount?: number;
  /** Set on the home grid so the filter script can find it. */
  filterable?: boolean;
  /** Screen-reader heading that keeps the document outline sequential. */
  heading?: string;
  /**
   * Category pre-selected on first paint (home defaults to Logo Design).
   * Other cards still render — hidden — so the filter script can reveal
   * them without a network round trip.
   */
  initialCategory?: CategoryId | 'all';
}

const {
  projects,
  eagerCount = 2,
  filterable = false,
  heading = 'Projects',
  initialCategory = 'all',
} = Astro.props;

let visibleCount = 0;
const cards = projects.map((project) => {
  const shown = initialCategory === 'all' || project.data.category === initialCategory;
  return { project, shown, vi: shown ? visibleCount++ : -1 };
});
---

<div class="work" data-work-grid={filterable ? '' : undefined}>
  <h2 class="visually-hidden">{heading}</h2>
  <p class="visually-hidden" role="status" data-filter-status></p>
  <ul class="work-grid" role="list">
    {
      cards.map(({ project, shown, vi }, i) => (
        <ProjectCard
          project={project}
          index={shown ? vi : i}
          eager={shown && vi < eagerCount}
          hidden={!shown}
          lead={vi === 0}
        />
      ))
    }
  </ul>
  <p class="work-empty" data-work-empty hidden={visibleCount > 0}>
    No projects in this category yet. Pick another category above, or
    <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer"
      >ask about this service on Fiverr <span aria-hidden="true">↗</span></a
    >.
  </p>
</div>

<script>
  // Name the clicked card for the cross-document view transition only at
  // interaction time — statically naming all 14 cards makes the browser
  // snapshot every one of them on navigation to pair just one.
  document.addEventListener('click', (event) => {
    const media = (event.target as HTMLElement)
      .closest('.card-link')
      ?.querySelector<HTMLElement>('[data-vt]');
    if (media?.dataset.vt) {
      // Clear stale names first — bfcache restores keep inline styles, and
      // every stale name is an extra snapshot on the next navigation.
      for (const el of document.querySelectorAll<HTMLElement>('[data-vt]')) {
        el.style.viewTransitionName = '';
      }
      media.style.viewTransitionName = media.dataset.vt;
    }
  });

  // Pair the RETURN trip too: arriving back from a project page, name that
  // project's card before first render so the cover morphs home instead of
  // fading out alone.
  addEventListener('pagereveal', () => {
    const nav = (window as { navigation?: { activation?: { from?: { url?: string } } } })
      .navigation;
    const from = nav?.activation?.from?.url ?? document.referrer;
    const slug = from?.match(/\/work\/([^/]+)\//)?.[1];
    const media = slug && document.querySelector<HTMLElement>(`[data-vt="work-${slug}"]`);
    if (media) media.style.viewTransitionName = `work-${slug}`;
  });
</script>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl) var(--space-xl);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 680px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
    }

    /* Editorial offset — the right column starts lower, so pairs never sit
       in a rigid row and each cover gets its own moment. Only on the full
       home grid: with two or three cards on a category page the offset
       reads as a mistake, not a rhythm. Counts only visible cards so it
       survives filtering (no-op in older browsers). */
    [data-work-grid] .work-grid {
      padding-block-end: var(--space-2xl);
    }

    [data-work-grid] .work-grid > :global(li:nth-child(even of :not([hidden]))) {
      transform: translateY(var(--space-2xl));
    }
  }

  .work-empty {
    color: var(--color-ink-soft);
    padding-block: var(--space-2xl);
  }

  .work-empty a {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
    text-decoration-color: var(--color-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .work-empty a:hover {
      color: var(--color-accent);
    }
  }
</style>
