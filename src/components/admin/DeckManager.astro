---
/**
 * The deck: upload it, then manage the pages in it.
 *
 * What this replaces was a file input and a submit button at the very bottom
 * of a four-thousand-pixel form, below the save button, with the note "a long
 * deck can take a minute; do not close the tab". There was no way to see the
 * pages, so there was no way to fix one. A single wrong page meant re-exporting
 * the PDF and re-uploading all thirty-six.
 *
 * Three things follow from that:
 *
 *   - The pages are visible. You cannot manage what you cannot see, and a deck
 *     is the actual deliverable on a case study page.
 *   - Upload reports progress. "Do not close the tab" is what you write when
 *     the interface cannot say how far along it is; a 60 MB file over a slow
 *     connection is minutes of nothing.
 *   - Adding pages does not mean replacing the deck. Append is a separate
 *     choice, because "I have three more slides" and "here is the new deck"
 *     are different sentences.
 *
 * Every page operation saves on the spot. This section is deliberately not
 * part of the surrounding form: dragging a page and then losing it because you
 * navigated away without pressing Save would be indefensible, and nesting a
 * second form inside the first is invalid HTML anyway.
 */
import type { DeckPage } from '@/lib/deck';
import { LOGO_TYPES } from '@/data/filters';

interface Props {
  slug: string;
  pages: DeckPage[];
  /** Filename of the PDF this deck came from, when one is recorded. */
  pdf?: string | null;
  /**
   * How the project reads its images. Only the wording and the per-image
   * fields change — upload, reorder, delete and set-cover are identical for
   * both, because a set of icons arrives as one PDF exactly like a deck does.
   */
  layout?: 'deck' | 'icons';
}

const { slug, pages, pdf, layout = 'deck' } = Astro.props;

/**
 * Only the tile labels still branch here. Every other wording is both
 * variants in the markup, shown by `data-layout` on the root — so the Layout
 * select in the form below switches this section live, with no save and no
 * request.
 */
const icons = layout === 'icons';
---

<section
  class="deck"
  data-deck
  data-slug={slug}
  data-layout={layout}
  aria-labelledby="deck-heading"
>
  <div class="deck-head">
    <div>
      <h2 id="deck-heading">
        <span data-deck-only>The deck</span><span data-icons-only>The set</span>
      </h2>
      <p class="deck-sub">
        {
          pages.length === 0 ? (
            <>
              Nothing here yet. Upload a PDF —
              <span data-deck-only> every page becomes a page of the case study.</span>
              <span data-icons-only> every page becomes one sheet of the set.</span>
            </>
          ) : (
            <>
              {pages.length}
              <span data-deck-only> page{pages.length === 1 ? '' : 's'}</span>
              <span data-icons-only> sheet{pages.length === 1 ? '' : 's'}</span>. Drag to reorder —
              each change saves immediately.
            </>
          )
        }
        {pdf && <span class="deck-pdf">From {pdf}</span>}
      </p>
    </div>
  </div>

  {/* --- Upload ---------------------------------------------------------- */}
  <form
    class="up"
    method="POST"
    action={`/admin/project/${slug}/upload/`}
    enctype="multipart/form-data"
    data-up
  >
    <div class="up-drop" data-drop>
      <input
        class="up-file"
        type="file"
        name="pdf"
        id="deck-pdf"
        accept="application/pdf,.pdf"
        required
        data-file
      />
      <label class="up-label" for="deck-pdf">
        <span class="up-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26">
            <path
              d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="up-text">
          <strong data-drop-name>Choose a PDF</strong>
          <span class="up-hint">or drop one here · 60 MB max</span>
        </span>
      </label>
    </div>

    <fieldset class="up-mode">
      <legend class="up-legend">What to do with it</legend>
      <label class="up-radio">
        <input type="radio" name="mode" value="replace" checked />
        <span>
          <strong>
            Replace the <span data-deck-only>deck</span><span data-icons-only>set</span>
          </strong>
          <span class="up-note">
            {
              pages.length > 0 ? (
                <>
                  Removes all {pages.length}
                  <span data-deck-only> pages</span>
                  <span data-icons-only> sheets</span> and rebuilds the cover.
                </>
              ) : (
                <>
                  Builds the <span data-deck-only>deck</span>
                  <span data-icons-only>set</span> and its cover.
                </>
              )
            }
          </span>
        </span>
      </label>
      <label class="up-radio">
        <input type="radio" name="mode" value="append" disabled={pages.length === 0} />
        <span>
          <strong>Add to the end</strong>
          <span class="up-note">
            {
              pages.length === 0
                ? 'Nothing to add to yet.'
                : 'Keeps everything already here, and the cover.'
            }
          </span>
        </span>
      </label>
    </fieldset>

    <div class="up-go">
      <button class="btn" type="submit" data-up-submit>Upload</button>
      {/* Only meaningful once JS is driving the request. */}
      <div class="up-prog" data-prog hidden>
        <div class="up-bar"><span data-bar></span></div>
        <p class="up-stat" data-stat></p>
      </div>
    </div>
    <p class="up-warn" data-up-nojs>
      Large decks take a minute or two to render. Keep this tab open until it finishes.
    </p>
  </form>

  {/* --- Pages ----------------------------------------------------------- */}
  {
    pages.length > 0 && (
      <>
        <p class="deck-help" id="deck-help">
          Drag{' '}
          <>
            <span data-deck-only>a page</span>
            <span data-icons-only>a sheet</span>
          </>{' '}
          to move it. With the keyboard: focus one, press Space to pick it up, arrow keys to move,
          Space to drop. The star makes it the grid cover; the lines open
          <span data-deck-only> its description</span>
          <span data-icons-only> its name, kind and description</span>.
        </p>

        <ol class="pages" data-pages aria-describedby="deck-help">
          {pages.map((page, i) => (
            <li
              class="page"
              draggable="true"
              tabindex="0"
              data-page
              data-src={page.src}
              aria-label={`${icons ? 'Icon' : 'Page'} ${i + 1}`}
            >
              <span class="page-no" data-no aria-hidden="true">
                {i + 1}
              </span>

              {page.display ? (
                <img
                  class="page-img"
                  src={page.display.src}
                  srcset={page.display.srcset}
                  sizes="180px"
                  width={page.display.width}
                  height={page.display.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                /* The row exists but its file does not resolve. Saying so beats
                   a broken-image icon, which looks like the admin is broken. */
                <span class="page-missing">Image missing</span>
              )}

              <div class="page-tools">
                <button
                  class="page-btn"
                  type="button"
                  data-cover
                  aria-label={`Make page ${i + 1} the grid cover`}
                  title="Use as grid cover"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                    <path
                      d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.6 9.7l5.8-.8z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <button
                  class="page-btn"
                  type="button"
                  data-alt-open
                  aria-label={`Describe page ${i + 1}`}
                  title="Description"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                    <path
                      d="M4 6h16M4 12h16M4 18h10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
                <button
                  class="page-btn page-btn--danger"
                  type="button"
                  data-del
                  aria-label={`Delete page ${i + 1}`}
                  title="Delete"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                    <path
                      d="M5 7h14M10 7V5h4v2m-7 0 1 12h8l1-12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </div>

              <div class="page-meta" hidden data-alt-wrap>
                <div data-icons-only>
                  {/* A sheet can hold a group of marks, and which group is
                      exactly what the project's single logo type cannot
                      express. Always in the DOM so switching Layout in the
                      form below reveals these immediately, with nothing typed
                      lost by switching back. Saved on blur, like the
                      description. */}
                  <div class="page-fields">
                    <label class="page-field">
                      <span class="page-alt-label">Name</span>
                      <input
                        class="page-alt-input"
                        type="text"
                        data-label
                        maxlength="120"
                        value={page.label}
                        placeholder="e.g. Sunrise Yoga"
                      />
                    </label>

                    <label class="page-field">
                      <span class="page-alt-label">Kind</span>
                      <select class="page-alt-input" data-logo-type>
                        <option value="">— not set —</option>
                        {LOGO_TYPES.map((t) => (
                          <option value={t} selected={page.logoType === t}>
                            {t}
                          </option>
                        ))}
                      </select>
                    </label>
                  </div>
                </div>

                <label class="page-field">
                  <span class="page-alt-label">
                    {icons ? 'Describe it for a screen reader' : 'What is on this page?'}
                  </span>
                  <textarea class="page-alt-input" rows="2" data-alt maxlength="400">
                    {page.alt}
                  </textarea>
                </label>
              </div>
            </li>
          ))}
        </ol>
      </>
    )
  }

  {
    /* Every operation reports here, once, for people who cannot see the grid
      rearrange itself. */
  }
  <p class="deck-live" role="status" aria-live="polite" data-live></p>
</section>

<script>
  /**
   * Deck management.
   *
   * Reorder, delete and describe all POST to /admin/project/<slug>/pages/ and
   * save on the spot. Upload goes over XHR purely for `upload.onprogress` —
   * fetch() still cannot report how many bytes have been sent, and on a 60 MB
   * PDF that is the difference between a progress bar and a frozen tab.
   */
  type Deck = HTMLElement & { dataset: { slug: string } };

  for (const deck of document.querySelectorAll<Deck>('[data-deck]')) {
    const slug = deck.dataset.slug;
    const live = deck.querySelector<HTMLElement>('[data-live]')!;
    const list = deck.querySelector<HTMLOListElement>('[data-pages]');

    const say = (message: string) => {
      live.textContent = message;
    };

    const post = async (body: Record<string, unknown>) => {
      const res = await fetch(`/admin/project/${slug}/pages/`, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'That did not save.');
      return data;
    };

    /** Renumber the badges so the visible order is the saved order. */
    const renumber = () => {
      if (!list) return;
      const items = [...list.querySelectorAll<HTMLElement>('[data-page]')];
      for (const [i, item] of items.entries()) {
        item.querySelector('[data-no]')!.textContent = String(i + 1);
        item.setAttribute('aria-label', `Page ${i + 1}`);
      }
      return items;
    };

    const saveOrder = async () => {
      if (!list) return;
      const order = [...list.querySelectorAll<HTMLElement>('[data-page]')].map(
        (el) => el.dataset.src!,
      );
      try {
        await post({ action: 'reorder', order });
        say('Order saved.');
      } catch (error) {
        // The DOM already moved, so a failure here means the screen and the
        // database disagree. Reloading is the honest fix — silently leaving a
        // wrong order on screen would have the operator believe it saved.
        say(`${(error as Error).message} Reloading to show what is actually stored.`);
        setTimeout(() => location.reload(), 1500);
      }
    };

    // --- Drag to reorder ---------------------------------------------------
    let dragged: HTMLElement | null = null;

    list?.addEventListener('dragstart', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-page]');
      if (!item) return;
      dragged = item;
      item.classList.add('is-dragging');
      event.dataTransfer!.effectAllowed = 'move';
      // Firefox does not start a drag unless something is set.
      event.dataTransfer!.setData('text/plain', item.dataset.src!);
    });

    list?.addEventListener('dragover', (event) => {
      event.preventDefault();
      const over = (event.target as HTMLElement).closest<HTMLElement>('[data-page]');
      if (!over || !dragged || over === dragged) return;
      // Insert before or after depending on which way the page is travelling,
      // so the placeholder lands where the pointer is rather than always left.
      const after = dragged.compareDocumentPosition(over) & Node.DOCUMENT_POSITION_FOLLOWING;
      over.parentNode!.insertBefore(dragged, after ? over.nextSibling : over);
    });

    list?.addEventListener('dragend', () => {
      if (!dragged) return;
      dragged.classList.remove('is-dragging');
      dragged = null;
      renumber();
      void saveOrder();
    });

    // --- Keyboard reorder --------------------------------------------------
    // The ARIA pattern: Space picks a page up, arrows move it, Space drops it.
    // Without this the whole feature is mouse-only, and reordering a 36-page
    // deck is exactly the sort of long mechanical task where that hurts most.
    let held: HTMLElement | null = null;

    list?.addEventListener('keydown', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-page]');
      if (!item) return;

      if (event.key === ' ' || event.key === 'Enter') {
        event.preventDefault();
        if (held === item) {
          held.classList.remove('is-held');
          held = null;
          say('Page dropped.');
          void saveOrder();
        } else {
          held?.classList.remove('is-held');
          held = item;
          item.classList.add('is-held');
          say(`Page ${item.querySelector('[data-no]')!.textContent} picked up.`);
        }
        return;
      }

      if (event.key === 'Escape' && held) {
        event.preventDefault();
        held.classList.remove('is-held');
        held = null;
        say('Cancelled. Reloading to show the saved order.');
        location.reload();
        return;
      }

      const back = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
      const forward = event.key === 'ArrowRight' || event.key === 'ArrowDown';
      if (!back && !forward) return;
      event.preventDefault();

      if (!held) {
        // Not carrying anything — arrows just walk the grid.
        const items = [...list.querySelectorAll<HTMLElement>('[data-page]')];
        const next = items[items.indexOf(item) + (back ? -1 : 1)];
        next?.focus();
        return;
      }

      const sibling = back ? held.previousElementSibling : held.nextElementSibling;
      if (!sibling) return;
      held.parentNode!.insertBefore(back ? held : sibling, back ? sibling : held);
      renumber();
      held.focus();
      say(`Moved to position ${held.querySelector('[data-no]')!.textContent}.`);
    });

    // --- Delete ------------------------------------------------------------
    list?.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-del]');
      if (!button) return;
      const item = button.closest<HTMLElement>('[data-page]')!;
      const number = item.querySelector('[data-no]')!.textContent;

      // Deleting is immediate and there is no undo anywhere in this admin, so
      // it asks. Everything else here is reversible by dragging it back.
      if (!confirm(`Delete page ${number}? This cannot be undone.`)) return;

      item.classList.add('is-going');
      try {
        await post({ action: 'delete', src: item.dataset.src });
        item.remove();
        const left = renumber()?.length ?? 0;
        say(`Page ${number} deleted. ${left} left.`);
        if (left === 0) location.reload();
      } catch (error) {
        item.classList.remove('is-going');
        say((error as Error).message);
      }
    });

    // --- Use as the grid cover ---------------------------------------------
    list?.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-cover]');
      if (!button) return;
      const item = button.closest<HTMLElement>('[data-page]')!;
      const number = item.querySelector('[data-no]')!.textContent;

      button.setAttribute('aria-busy', 'true');
      say(`Building a cover from page ${number}…`);
      try {
        await post({ action: 'cover', src: item.dataset.src });
        // The old cover file is overwritten at the same path, so the browser
        // still holds the previous bytes. Reloading is the only honest way to
        // show what the grid will now display.
        say(`Page ${number} is now the grid cover. Reloading…`);
        location.reload();
      } catch (error) {
        button.removeAttribute('aria-busy');
        say((error as Error).message);
      }
    });

    // --- Describe ----------------------------------------------------------
    list?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-alt-open]');
      if (!button) return;
      const item = button.closest<HTMLElement>('[data-page]')!;
      const wrap = item.querySelector<HTMLElement>('[data-alt-wrap]')!;
      wrap.hidden = !wrap.hidden;
      // The first field in the panel, whichever it is: an icon set opens on
      // its name, a deck straight onto the description.
      if (!wrap.hidden) wrap.querySelector<HTMLElement>('input, select, textarea')?.focus();
    });

    // Saved on blur rather than per keystroke: one request when the operator
    // is finished typing, not one per character.
    list?.addEventListener(
      'blur',
      async (event) => {
        const field = event.target as HTMLTextAreaElement;
        if (!field.matches('[data-alt]')) return;
        const item = field.closest<HTMLElement>('[data-page]')!;
        const value = field.value.trim();
        if (value === field.defaultValue.trim()) return;
        try {
          await post({ action: 'alt', src: item.dataset.src, alt: value });
          field.defaultValue = value;
          say('Description saved.');
        } catch (error) {
          say((error as Error).message);
        }
      },
      true,
    );

    /**
     * An icon's name and kind, saved as one thing.
     *
     * Both live on the same row and are read together, so they go in one
     * request: two would let a dropped connection store the name of a mark
     * whose kind never arrived. The name saves on blur like the description;
     * the kind saves the moment it is chosen, because a select has no typing
     * to finish waiting for.
     */
    const saveMeta = async (item: HTMLElement) => {
      const label = item.querySelector<HTMLInputElement>('[data-label]');
      const kind = item.querySelector<HTMLSelectElement>('[data-logo-type]');
      if (!label && !kind) return;
      try {
        await post({
          action: 'meta',
          src: item.dataset.src,
          label: label?.value ?? '',
          logoType: kind?.value ?? '',
        });
        if (label) label.defaultValue = label.value;
        say(label?.value ? `“${label.value.trim()}” saved.` : 'Icon saved.');
      } catch (error) {
        say((error as Error).message);
      }
    };

    list?.addEventListener(
      'blur',
      (event) => {
        const field = event.target as HTMLInputElement;
        if (!field.matches('[data-label]')) return;
        if (field.value.trim() === field.defaultValue.trim()) return;
        void saveMeta(field.closest<HTMLElement>('[data-page]')!);
      },
      true,
    );

    list?.addEventListener('change', (event) => {
      const field = event.target as HTMLElement;
      if (!field.matches('[data-logo-type]')) return;
      void saveMeta(field.closest<HTMLElement>('[data-page]')!);
    });

    // --- Upload ------------------------------------------------------------
    const form = deck.querySelector<HTMLFormElement>('[data-up]');
    const file = deck.querySelector<HTMLInputElement>('[data-file]');
    const drop = deck.querySelector<HTMLElement>('[data-drop]');
    const name = deck.querySelector<HTMLElement>('[data-drop-name]');
    const prog = deck.querySelector<HTMLElement>('[data-prog]');
    const bar = deck.querySelector<HTMLElement>('[data-bar]');
    const stat = deck.querySelector<HTMLElement>('[data-stat]');
    const submit = deck.querySelector<HTMLButtonElement>('[data-up-submit]');
    const warn = deck.querySelector<HTMLElement>('[data-up-nojs]');

    // The "keep this tab open" note is for the no-JS form post. With a real
    // progress bar it is just noise.
    if (warn) warn.hidden = true;

    const showName = () => {
      const chosen = file?.files?.[0];
      if (name) {
        name.textContent = chosen
          ? `${chosen.name} · ${(chosen.size / 1024 / 1024).toFixed(1)} MB`
          : 'Choose a PDF';
      }
    };
    file?.addEventListener('change', showName);
    showName();

    for (const type of ['dragenter', 'dragover']) {
      drop?.addEventListener(type, (event) => {
        event.preventDefault();
        drop.classList.add('is-over');
      });
    }
    for (const type of ['dragleave', 'drop']) {
      drop?.addEventListener(type, () => drop.classList.remove('is-over'));
    }
    drop?.addEventListener('drop', (event) => {
      event.preventDefault();
      const dropped = (event as DragEvent).dataTransfer?.files?.[0];
      if (!dropped || !file) return;
      const bag = new DataTransfer();
      bag.items.add(dropped);
      file.files = bag.files;
      showName();
    });

    // --- Uploading, in three steps -----------------------------------------
    //
    // The deck used to render inside the upload request. On this host that is
    // not survivable: a 3.2 MB deck came back 504 from the proxy, then 503 on
    // retry — the render outlived the gateway, and a big enough one took the
    // process with it. Nothing about a single request can be tuned out of that
    // shape, so the browser drives it instead.
    //
    //   1. POST the PDF     → how many pages it has
    //   2. POST per page    → rasterise that one page
    //   3. POST finish      → promote the pages, write the database
    //
    // Every request is short whatever the deck's size, and the bar moves on a
    // count the server reports rather than filling and then hanging on silence.

    const endpoint = form?.action ?? `/admin/project/${slug}/upload/`;

    const setBar = (percent: number) => {
      bar!.style.inlineSize = `${percent}%`;
    };

    /**
     * What came back, when it was not JSON.
     *
     * A gateway error is an HTML page, and it never reached this route. "The
     * server sent something unexpected" is not a sentence anyone can act on;
     * the status and the first line of the body are.
     */
    const describe = (status: number, statusText: string, text: string) => {
      const first = text
        .replace(/<[^>]*>/g, ' ')
        .trim()
        .split(/\s{2,}|\n/)[0];
      return (
        `The server replied ${status || 'nothing'}` +
        (statusText ? ` (${statusText})` : '') +
        '.' +
        (first ? ` Server said: ${first.slice(0, 120)}` : '')
      );
    };

    type Step = {
      ok?: boolean;
      error?: string;
      total?: number;
      done?: number;
      message?: string;
      /** Set by the server when the failure was the host being momentarily
       *  out of room, rather than anything wrong with the deck. */
      retryable?: boolean;
    };

    /** Step one. XHR rather than fetch, purely for `upload.onprogress`. */
    const sendPdf = (data: FormData) =>
      new Promise<number>((resolve, reject) => {
        const request = new XMLHttpRequest();

        request.upload.addEventListener('progress', (e) => {
          if (!e.lengthComputable) return;
          const percent = Math.round((e.loaded / e.total) * 100);
          setBar(percent);
          stat!.textContent =
            percent < 100 ? `Uploading — ${percent}%` : 'Uploaded. Reading the deck…';
        });

        request.addEventListener('load', () => {
          let payload: Step;
          try {
            payload = JSON.parse(request.responseText) as Step;
          } catch {
            reject(new Error(describe(request.status, request.statusText, request.responseText)));
            return;
          }
          if (request.status === 200 && payload.ok && typeof payload.total === 'number') {
            resolve(payload.total);
          } else {
            reject(new Error(payload.error ?? 'The upload failed.'));
          }
        });

        request.addEventListener('error', () =>
          reject(new Error('The connection dropped before the file finished.')),
        );

        request.open('POST', endpoint);
        request.setRequestHeader('accept', 'application/json');
        request.send(data);
      });

    /** Steps two and three, which are both small JSON calls. */
    const act = async (body: Record<string, unknown>): Promise<Step> => {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(body),
      });
      const text = await res.text();
      let payload: Step;
      try {
        payload = JSON.parse(text) as Step;
      } catch {
        // Not from this route — a proxy answered instead. Worth another go if
        // it was a server-side failure; a 4xx page means the request itself is
        // wrong and repeating it changes nothing.
        const error = new Error(describe(res.status, res.statusText, text)) as Error & {
          retryable?: boolean;
        };
        error.retryable = res.status >= 500;
        throw error;
      }
      if (!res.ok || !payload.ok) {
        const error = new Error(payload.error ?? 'That step failed.') as Error & {
          retryable?: boolean;
        };
        // The server knows the difference between "this deck is wrong" and
        // "the host was momentarily out of threads". Believe it.
        error.retryable = payload.retryable === true;
        throw error;
      }
      return payload;
    };

    /**
     * Render one page, forgiving a few stumbles.
     *
     * One blip should not throw away a deck that is thirty pages in, and on a
     * shared plan a blip is routine: the account hits its thread ceiling, the
     * host says no, and the same page renders fine a second later. Backing off
     * a little further each time is what lets it clear.
     *
     * A refusal the server calls deterministic — a page outside the deck, an
     * upload that has since expired — is not retried. The same answer would
     * come back, more slowly.
     */
    const ATTEMPTS = 4;

    const renderPage = async (index: number): Promise<Step> => {
      for (let attempt = 1; ; attempt++) {
        try {
          return await act({ action: 'render', index });
        } catch (error) {
          // A rejected fetch is a TypeError and means the request never
          // completed, which is the most retryable failure there is.
          const retryable =
            (error as { retryable?: boolean }).retryable ?? error instanceof TypeError;
          if (!retryable || attempt === ATTEMPTS) throw error;
          stat!.textContent = `Page ${index} needs another go — waiting for the server (${attempt}/${ATTEMPTS - 1})…`;
          await new Promise((wait) => setTimeout(wait, attempt * 1500));
        }
      }
    };

    /** Closing the tab mid-deck abandons it halfway. Worth a prompt. */
    const holdTab = (event: BeforeUnloadEvent) => {
      event.preventDefault();
    };

    const run = async (data: FormData) => {
      // Where it got to, so a failure can say honestly whether the deck on the
      // site was touched. Everything before 'finish' is staged and invisible.
      let stage: 'send' | 'render' | 'finish' = 'send';

      submit!.disabled = true;
      submit!.textContent = 'Uploading…';
      prog!.hidden = false;
      setBar(0);
      window.addEventListener('beforeunload', holdTab);

      try {
        const total = await sendPdf(data);
        stage = 'render';
        setBar(0);

        for (let index = 1; index <= total; index++) {
          stat!.textContent = `Rendering — page ${index} of ${total}`;
          // One page at a time. Two at once would halve the wall clock and
          // double the memory and CPU on a two-core shared box, which is the
          // thing that took the process down to begin with.
          const step = await renderPage(index);
          setBar(Math.round(((step.done ?? index) / total) * 100));
        }

        stage = 'finish';
        stat!.textContent = `Publishing ${total} page${total === 1 ? '' : 's'}…`;
        const finished = await act({ action: 'finish' });

        setBar(100);
        stat!.textContent = `${finished.message ?? 'Published.'} Reloading…`;
        window.removeEventListener('beforeunload', holdTab);
        location.reload();
      } catch (error) {
        window.removeEventListener('beforeunload', holdTab);
        setBar(0);
        // Not cancelled on purpose. Whatever rendered stays staged out of
        // sight, and the next upload clears the staging area before it starts —
        // so a retry costs nothing and an abandoned attempt costs disk.
        stat!.textContent =
          (error as Error).message + (stage === 'finish' ? '' : ' The deck was not changed.');
        submit!.disabled = false;
        submit!.textContent = 'Upload';
      }
    };

    form?.addEventListener('submit', (event) => {
      if (!file?.files?.length) return; // let the browser's own validation speak
      event.preventDefault();
      void run(new FormData(form));
    });
  }
</script>

<style>
  /* The same card every other section of the editor is, with one difference:
     it is the only one that saves on its own, so it is the only one allowed
     to sit above the form rather than inside it. */
  .deck {
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 1.35rem;
    margin-block: 0 1.75rem;
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-sm);
  }

  /* The layout switch, done in CSS.
     Both wordings and the per-sheet fields are always in the DOM, so flipping
     Layout in the form below is instant, costs no request, and cannot lose
     anything typed into a field it hides. */
  [data-layout='deck'] [data-icons-only],
  [data-layout='icons'] [data-deck-only] {
    display: none;
  }

  .page-fields {
    display: grid;
    gap: 0.4rem;
  }

  .deck-head h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .deck-sub {
    color: var(--color-ink-soft);
    font-size: 0.85rem;
    margin: 0.3rem 0 0;
  }

  .deck-pdf {
    display: block;
    color: var(--color-ink-mute);
    font-size: 0.8rem;
  }

  /* --- Upload ------------------------------------------------------------ */
  .up {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.2rem;
  }

  @media (min-width: 760px) {
    .up {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .up-go {
      grid-column: 1 / -1;
    }
  }

  .up-drop {
    position: relative;
    border: 1.5px dashed var(--color-line-control);
    border-radius: 12px;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .up-drop.is-over {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  /* Visually hidden but still the control that gets focus and validation. */
  .up-file {
    position: absolute;
    inset: 0;
    opacity: 0;
    inline-size: 100%;
    block-size: 100%;
    cursor: pointer;
  }

  .up-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.1rem;
    pointer-events: none;
  }

  .up-file:focus-visible + .up-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 12px;
  }

  .up-icon {
    color: var(--color-accent);
    flex: none;
  }

  .up-text strong {
    display: block;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .up-hint {
    color: var(--color-ink-mute);
    font-size: 0.78rem;
  }

  .up-mode {
    border: 0;
    padding: 0;
    margin: 0;
    /* A fieldset's intrinsic minimum is its content, which overflows a grid
       column that was told to be able to shrink. */
    min-inline-size: 0;
    display: grid;
    gap: 0.5rem;
  }

  .up-legend {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-mute);
    padding: 0;
    margin-block-end: 0.2rem;
  }

  .up-radio {
    display: flex;
    gap: 0.55rem;
    align-items: start;
    padding: 0.4rem 0.5rem;
    border-radius: 9px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .up-radio:hover {
    background: var(--color-accent-wash);
  }

  .up-radio input {
    accent-color: var(--color-accent-deep);
    margin-block-start: 0.15rem;
  }

  .up-radio:has(input:disabled) {
    cursor: default;
    opacity: 0.55;
  }

  .up-radio:has(input:disabled):hover {
    background: none;
  }

  .up-radio:has(input:disabled) {
    opacity: 0.5;
    cursor: default;
  }

  .up-radio strong {
    display: block;
    font-weight: 600;
  }

  .up-note {
    color: var(--color-ink-mute);
    font-size: 0.78rem;
  }

  .up-go {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .up-prog {
    flex: 1 1 14rem;
    min-inline-size: 0;
  }

  .up-bar {
    block-size: 6px;
    border-radius: 999px;
    background: var(--color-line-strong);
    overflow: hidden;
  }

  .up-bar span {
    display: block;
    block-size: 100%;
    inline-size: 0;
    background: var(--gradient-accent);
    transition: inline-size 160ms ease;
  }

  .up-stat {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    margin: 0.35rem 0 0;
  }

  .up-warn {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--color-ink-mute);
    margin: 0;
  }

  /* --- Pages ------------------------------------------------------------- */
  .deck-help {
    font-size: 0.8rem;
    color: var(--color-ink-mute);
    margin-block: 1.4rem 0.6rem;
    padding-block-start: 1.2rem;
    border-block-start: 1px solid var(--color-line);
  }

  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.8rem;
    /* Each tile owns its height. Opening the metadata panel makes one tile
       much taller, and stretching — the grid default — would drag every other
       tile in its row down with it, leaving a row of thumbnails floating in
       empty space. */
    align-items: start;
  }

  .page {
    position: relative;
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    overflow: hidden;
    background: var(--image-bg);
    cursor: grab;
  }

  .page:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .page.is-dragging {
    opacity: 0.35;
    cursor: grabbing;
  }

  /* Held by the keyboard — needs to read as "picked up" without a pointer. */
  .page.is-held {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--color-accent-wash);
  }

  .page.is-going {
    opacity: 0.4;
    pointer-events: none;
  }

  .page-img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .page-missing {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 0.5rem;
    font-size: 0.75rem;
    text-align: center;
    color: var(--color-danger);
    background: var(--color-paper-sunken);
  }

  .page-no {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-start: 0.4rem;
    min-inline-size: 1.5rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 65%);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
  }

  .page-tools {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-end: 0.4rem;
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  /* Touch has no hover, so the controls would be unreachable. */
  @media (hover: none) {
    .page-tools {
      opacity: 1;
    }
  }

  .page:hover .page-tools,
  .page:focus-within .page-tools {
    opacity: 1;
  }

  .page-btn {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 0;
    border-radius: 6px;
    background: rgb(0 0 0 / 70%);
    color: #fff;
    cursor: pointer;
  }

  .page-btn:hover {
    background: rgb(0 0 0 / 88%);
  }

  .page-btn[aria-busy='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-btn--danger:hover {
    background: var(--color-danger-fill);
  }

  /* Holds every per-image field. One disclosure rather than one per field:
     these are read and edited together, and three separate toggles on a tile
     the size of a thumbnail would be unusable. */
  .page-meta {
    display: grid;
    gap: 0.4rem;
    padding: 0.5rem;
    background: var(--color-paper-raised);
    border-block-start: 1px solid var(--color-line);
  }

  .page-field {
    display: block;
  }

  .page-alt-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-ink-mute);
    margin-block-end: 0.25rem;
  }

  .page-alt-input {
    inline-size: 100%;
    font: inherit;
    font-size: 0.78rem;
  }

  textarea.page-alt-input {
    resize: vertical;
  }

  .deck-live {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    margin-block: 0.9rem 0;
    min-block-size: 1.2em;
  }
</style>
