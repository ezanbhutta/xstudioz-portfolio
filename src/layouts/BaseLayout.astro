---
import { SITE } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { existsSync } from 'node:fs';

// Pixel-exact favicon generated from src/assets/logo-original.* when present
// (see scripts/generate-og.mjs); the vector fallback ships otherwise.
const hasPngFavicon = existsSync('public/favicon.png');

interface Props {
  /** Full document title. The site name is appended unless it already appears. */
  title: string;
  description: string;
  /** Absolute URL for og:image. Defaults to the brand card. */
  ogImage?: string;
  /** Alt text for the social card image. */
  ogImageAlt?: string;
  /** Rendered dimensions of the social card image. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  /** Error/utility pages: emit noindex and skip canonical/og:url. */
  noindex?: boolean;
  /** Page structured data, rendered as a JSON-LD script in <head>. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt = `${SITE.name}, independent design studio`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url);
const ogImageUrl = ogImage ?? new URL('/og.png', SITE.url).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    {/* --color-paper; keep in sync with src/styles/tokens.css */}
    <meta name="theme-color" content="#09090b" />

    {
      hasPngFavicon ? (
        <link rel="icon" href="/favicon.png" type="image/png" />
      ) : (
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      )
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />

    <script is:inline>
      // Marks JS availability before first paint so reveal styles only apply
      // when the observer that resolves them is guaranteed to run.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal — adds .is-visible once, then lets CSS do the motion.
      const revealed = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window) || revealed.length === 0) {
        revealed.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          // Start the reveal BEFORE the card reaches the viewport: a positive
          // bottom margin grows the observed box downward, so a fast scroll
          // lands on finished artwork instead of on a card still fading in.
          // (The old -4% did the opposite — it delayed the trigger.)
          { threshold: 0, rootMargin: '0px 0px 25% 0px' },
        );
        revealed.forEach((el) => io.observe(el));
      }

      /**
       * Same-page anchors scroll on our own clock rather than the browser's.
       *
       * Native `scroll-behavior: smooth` picks its duration from the distance
       * travelled, so "View the work ↓" on a long page is a slow ride to the
       * bottom. This is a fixed, fast curve instead: 380–620ms whatever the
       * distance, on an ease-out that arrives quickly and settles.
       *
       * This ONLY runs on anchor clicks. The wheel, the trackpad and the
       * scrollbar are never touched, so nothing here is scroll-jacking — the
       * page always scrolls at the speed the reader's own input asks for.
       */
      const still = matchMedia('(prefers-reduced-motion: reduce)');

      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
        const id = link?.getAttribute('href')?.slice(1);
        if (!link || !id || event.metaKey || event.ctrlKey || event.shiftKey) return;

        const target = document.getElementById(id);
        if (!target) return;
        event.preventDefault();

        // Clear the sticky header, and whatever else is stuck below it.
        const offset =
          parseFloat(getComputedStyle(document.documentElement).scrollPaddingBlockStart) || 0;
        const to = Math.max(0, target.getBoundingClientRect().top + scrollY - offset);

        const land = () => {
          history.replaceState(null, '', `#${id}`);
          // Focus follows the eye, or the next Tab starts from the old place.
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        };

        if (still.matches) {
          scrollTo(0, to);
          land();
          return;
        }

        const from = scrollY;
        const distance = to - from;
        const duration = Math.min(620, Math.max(380, Math.abs(distance) * 0.4));
        const start = performance.now();

        const step = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          // easeOutQuint: covers most of the distance early, then settles
          scrollTo(0, from + distance * (1 - Math.pow(1 - t, 5)));
          if (t < 1) requestAnimationFrame(step);
          else land();
        };
        requestAnimationFrame(step);
      });
    </script>
  </body>
</html>
