---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
---

<BaseLayout
  title="Page not found"
  description="This page doesn’t exist. Explore the XStudioz portfolio instead."
  noindex
>
  <section class="container page-hero notfound">
    <p class="overline">404</p>
    <h1 class="page-title">This page doesn’t exist<span class="accent-dot">.</span></h1>
    <p class="page-lede">The work does. Start from the portfolio, or pick a service:</p>

    <ul class="notfound-links" role="list">
      {
        ACTIVE_CATEGORIES.map((c) => (
          <li>
            <a href={`/${c.id}/`} data-astro-prefetch>
              {c.navLabel ?? c.title}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="notfound-actions">
      <a class="button button--primary" href="/" data-astro-prefetch>See the work</a>
      <a
        class="button button--outline"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hire on Fiverr <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-3xl);
    min-height: 50vh;
  }

  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
  }

  /* Same chip language as the work filters */
  .notfound-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding: 0.375rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .notfound-links a:hover {
      background: var(--color-paper-sunken);
      color: var(--color-ink);
    }
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }
</style>
