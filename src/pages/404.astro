---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES } from '@/data/categories';
---

<BaseLayout
  title="Page not found"
  description="This page doesn’t exist. Explore the XStudioz portfolio instead."
  noindex
>
  <section class="container page-hero notfound">
    <p class="overline">404</p>
    <h1 class="page-title">This page doesn’t exist<span class="accent-dot">.</span></h1>
    <p class="page-lede">The work does. Start from the portfolio, or jump into a category:</p>
    <ul class="notfound-categories" role="list">
      {
        CATEGORIES.map((c) => (
          <li>
            <a href={`/${c.id}/`}>{c.title}</a>
          </li>
        ))
      }
    </ul>
    <div class="notfound-actions">
      <a class="button button--primary" href="/">View all work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-3xl);
    min-height: 50vh;
  }

  .notfound-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
  }

  .notfound-categories a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding: 0.375rem 1rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .notfound-categories a:hover {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }
</style>
