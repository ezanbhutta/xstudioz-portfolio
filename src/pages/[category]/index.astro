---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import SectionFilters from '@/components/SectionFilters.astro';
import ServiceNav from '@/components/ServiceNav.astro';
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES, CATEGORIES, type Category } from '@/data/categories';
import { getSortedProjects, projectsForService, metaDescription } from '@/lib/projects';
import { siteGraph, ORGANIZATION_ID, WEBSITE_ID } from '@/lib/schema';

/**
 * A service page, not a filtered gallery.
 *
 * This is the answer to "Stationery leads to a 0-projects page": the page
 * states the promise, makes the argument, and then shows the work — only if
 * work exists. A service with nothing published yet is still a complete,
 * useful page rather than an empty grid.
 *
 * Related work comes from two honest places: projects tagged with this
 * service, and projects that *included* it as an extra element (a guidelines
 * project with a Stationery Design Kit is real stationery work). See
 * `relatedExtras` in src/data/categories.json.
 */
// Every category keeps its URL — turning a service off removes it from
// navigation, not from the web, so existing links never 404.
const category = CATEGORIES.find((c) => c.id === Astro.params.category) as Category | undefined;

if (!category) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const allProjects = await getSortedProjects();
const { direct, viaExtras } = projectsForService(allProjects, category);
const others = ACTIVE_CATEGORIES.filter((c) => c.id !== category.id);

const description = metaDescription(category.outcome, category.description);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'Service',
      name: category.title,
      description: category.description,
      url: new URL(`/${category.id}/`, SITE.url).href,
      provider: { '@id': ORGANIZATION_ID },
      serviceType: category.title,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.name, item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: category.title },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: `${category.title} | ${SITE.name}`,
      description: category.description,
      url: new URL(`/${category.id}/`, SITE.url).href,
      isPartOf: { '@id': WEBSITE_ID },
    },
  ],
};
---

<BaseLayout title={`${category.title}`} description={description} jsonLd={jsonLd}>
  <article>
    <header class="container page-hero service-hero">
      <h1 class="page-title service-title">{category.title}</h1>
      {category.outcome && <p class="service-outcome">{category.outcome}</p>}
      {
        /* This line has always existed and has only ever reached <head> —
          metaDescription and two JSON-LD nodes. It is the sentence that says
          what the client walks away with, so it belongs on the page. */
      }
      {category.description && <p class="service-description">{category.description}</p>}
      {category.intro && <p class="page-lede service-intro">{category.intro}</p>}
      <div class="service-actions">
        <a
          class="button button--primary"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Start a {category.navLabel ?? category.title} project <span aria-hidden="true">↗</span>
        </a>
        {
          direct.length + viaExtras.length > 0 && (
            <a class="button button--outline" href="#service-work">
              See the work <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </header>

    {
      /* What you get, answered before the work rather than after it. The
        case study's closing band links straight to this anchor. */
      category.deliverables && category.deliverables.length > 0 && (
        <section
          id="includes"
          class="container service-includes"
          aria-labelledby="includes-heading"
        >
          <h2 id="includes-heading" class="overline">
            What's included
          </h2>
          <ul class="spec-list service-includes-list">
            {category.deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    <ServiceNav current={category.id} />

    {
      direct.length + viaExtras.length > 0 ? (
        <section id="service-work" class="section section--ruled" aria-labelledby="work-heading">
          <div class="container">
            <div class="section-head">
              <p class="overline">Selected work</p>
              <h2 id="work-heading" class="section-title">
                {category.title} in practice<span class="accent-dot">.</span>
              </h2>
            </div>

            {direct.length > 0 && (
              /* Filters and the grid they act on share one scope element, so
                the script pairs them without a global selector — and the
                secondary "delivered as part of" grid below stays untouched
                by them. */
              <div class="service-grid" data-facet-scope>
                <SectionFilters
                  category={category}
                  projects={direct}
                  scopeId={`service-${category.id}`}
                />
                <WorkGrid projects={direct} heading={`${category.title} projects`} eagerCount={1} />
                <p class="service-none" data-empty hidden>
                  No {category.title} projects match that combination.{' '}
                  <button type="button" class="service-none-reset" data-reset>
                    Clear the filters
                  </button>
                  .
                </p>
                <p class="visually-hidden" role="status" data-status />
              </div>
            )}

            {viaExtras.length > 0 && (
              <div class="service-grid service-grid--secondary">
                <p class="service-secondary-label">
                  {direct.length > 0 ? 'Also delivered as part of' : 'Delivered as part of'} these
                  identity projects
                </p>
                <WorkGrid
                  projects={viaExtras}
                  heading={`Projects including ${category.title}`}
                  eagerCount={0}
                />
              </div>
            )}
          </div>
        </section>
      ) : (
        <section class="section section--ruled" aria-labelledby="work-heading">
          <div class="container">
            <div class="section-head">
              <p class="overline">Selected work</p>
              <h2 id="work-heading" class="section-title">
                Nothing published here yet<span class="accent-dot">.</span>
              </h2>
              <p class="section-lede">
                {category.title} is offered and delivered. It just has no standalone case study on
                the site so far. The identity work below shows the standard the craft is held to,
                and the same hands do this.
              </p>
            </div>
          </div>
        </section>
      )
    }

    <nav class="section section--tight container other-services" aria-labelledby="other-heading">
      <h2 id="other-heading" class="overline other-heading">Other services</h2>
      <ul class="other-list" role="list">
        {
          others.map((c) => (
            <li>
              <a class="other-link" href={`/${c.id}/`} data-astro-prefetch>
                {c.title} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</BaseLayout>

<style>
  .service-description {
    font-size: var(--text-md);
    color: var(--color-ink-soft);
    max-width: var(--measure);
    margin-block-start: var(--space-sm);
  }

  .service-includes {
    padding-block: var(--space-lg) 0;
    /* Anchored from the case study's closing band, so it must not land under
       the sticky header. */
    scroll-margin-block-start: var(--header-h);
  }

  .service-includes-list {
    margin-block-start: var(--space-sm);
    max-inline-size: var(--measure-wide);
  }

  .service-hero {
    /* ServiceNav sits immediately below and carries its own rule, so the
       hero does not need to reserve space of its own. */
    padding-block-end: var(--space-xl);
  }

  .service-title {
    margin-block-end: var(--space-md);
  }

  /* The promise sits between the title and the argument, at statement scale */
  .service-outcome {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    /* Ink, not accent. A promise set in purple reads as a highlighter pen;
       set in the same ink as the headline it reads as the studio saying it.
       Colour on this site belongs to the artwork. */
    color: var(--color-ink);
    max-width: var(--measure-statement);
    margin-block-end: var(--space-md);
  }

  .service-intro {
    max-width: var(--measure);
  }

  .service-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .overline-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .overline-link:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }

  .service-grid {
    margin-block-start: var(--space-2xl);
  }

  /* The filter row sits above the grid it acts on, separated from it rather
     than from the heading it belongs to. */
  .service-grid :global(.facets) {
    padding-block-end: var(--space-lg);
  }

  .service-none {
    padding-block: var(--space-2xl);
    color: var(--color-ink-soft);
  }

  .service-none-reset {
    font: inherit;
    color: var(--color-ink);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .service-grid--secondary {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-line);
  }

  .service-secondary-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    margin-block-end: var(--space-lg);
    max-width: var(--measure);
  }

  .service-all {
    margin-block-start: var(--space-xl);
  }

  .other-heading {
    margin-block-end: var(--space-md);
  }

  .other-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .other-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--control-h);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .other-link:hover {
      color: var(--color-accent);
    }
  }
</style>
