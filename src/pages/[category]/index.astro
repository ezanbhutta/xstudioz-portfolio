---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FilterBar from '@/components/FilterBar.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { SITE } from '@/config/site';
import { CATEGORIES } from '@/data/categories';
import { getSortedProjects, countByCategory, logoIndustries } from '@/lib/projects';
import { siteGraph, WEBSITE_ID } from '@/lib/schema';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const allProjects = await getSortedProjects();
const counts = countByCategory(allProjects);
const industries = logoIndustries(allProjects);
const projects = allProjects.filter((p) => p.data.category === category.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CollectionPage',
      name: `${category.title} | ${SITE.name}`,
      description: category.description,
      url: new URL(`/${category.id}/`, SITE.url).href,
      isPartOf: { '@id': WEBSITE_ID },
    },
  ],
};
---

<BaseLayout
  title={`${category.title} Portfolio`}
  description={category.description}
  jsonLd={jsonLd}
>
  <section class="page-hero container">
    <p class="overline">
      {projects.length}
      {projects.length === 1 ? 'project' : 'projects'}
    </p>
    <h1 class="page-title">{category.title}</h1>
    <p class="page-lede">{category.description}</p>
  </section>

  <section aria-label={`${category.title} projects`}>
    <FilterBar
      counts={counts}
      total={allProjects.length}
      active={category.id}
      industries={industries}
    />
    <div class="container category-grid">
      <WorkGrid projects={projects} eagerCount={2} />
    </div>
  </section>
</BaseLayout>

<style>
  .category-grid {
    padding-block-start: var(--space-xl);
  }
</style>
