---
/**
 * Project list — the admin's home.
 *
 * This was a five-column table of text. Three things were wrong with it:
 *
 *   - No images. The list of a *design* portfolio showed no design. Finding
 *     the Zion deck meant reading eight titles rather than recognising it.
 *   - Position was a number typed inside each project's own editor, so
 *     rearranging the grid was: open a project, guess a number, save, go back,
 *     open the next one, find the numbers now collide. The order lives here,
 *     so it should be changed here.
 *   - No way to search. Fine at eight projects, useless at fifty, and this is
 *     a list that only grows.
 *
 * Ordered the way the grid orders them, because that is the order the editor
 * is thinking in when they come here to move something.
 *
 * The counts across the top are the one thing this screen knows that nobody
 * could work out by looking: a project with no pages is dropped by
 * `getSortedProjects`, so it is not on the site at all. That used to be
 * findable only by reading every row's metadata, or by noticing the work grid
 * was one short.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listProjects } from '@/lib/admin-data';
import { CATEGORIES } from '@/data/categories';

const projects = await listProjects();
const titleOf = (id: string) => CATEGORIES.find((c) => c.id === id)?.title ?? id;
const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');

/**
 * "2 sheet s".
 *
 * Built here rather than in the template because JSX puts a space between two
 * adjacent expressions, so a count, a noun and its plural written as three
 * neighbouring braces come out with gaps in the middle of the word.
 */
const countOf = (n: number, layout: string) =>
  `${n} ${layout === 'icons' ? 'sheet' : 'page'}${n === 1 ? '' : 's'}`;

/** No pages means no cover and no gallery, which means it never renders. */
const hidden = projects.filter((p) => p.pages === 0);
const live = projects.length - hidden.length;
---

<AdminLayout title="Projects" eyebrow="Portfolio" heading="Projects">
  <p slot="lede">Everything here is the live site. There is no publish step and no undo.</p>

  <a class="btn" slot="actions" href="/admin/project/new/">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
      ><path d="M12 5v14M5 12h14"></path></svg
    >
    New project
  </a>

  {saved && <p class="flash ok">Saved &ldquo;{saved}&rdquo;. It is live now.</p>}
  {
    deleted && (
      <p class="flash ok">Deleted &ldquo;{deleted}&rdquo;. Its image files were left on disk.</p>
    )
  }

  {
    projects.length > 0 && (
      <div class="stats">
        <div class="stat">
          <span class="stat-n">{projects.length}</span>
          <span class="stat-l">In the admin</span>
        </div>
        <div class="stat">
          <span class="stat-n">{live}</span>
          <span class="stat-l">Live on the site</span>
        </div>
        <div class:list={['stat', hidden.length > 0 && 'is-warn']}>
          <span class="stat-n">{hidden.length}</span>
          <span class="stat-l">Hidden — no pages</span>
        </div>
      </div>
    )
  }

  {
    /* Naming them is the whole value. "1 hidden" tells an operator something
       is wrong; this tells them which project and takes them to it. */
    hidden.length > 0 && (
      <p class="flash bad">
        <span>
          {hidden.length === 1 ? 'One project has' : `${hidden.length} projects have`} no pages
          uploaded, so {hidden.length === 1 ? 'it does' : 'they do'} not appear on the site at all:{' '}
          {hidden.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/admin/project/${p.slug}/`}>{p.title}</a>
            </>
          ))}
          .
        </span>
      </p>
    )
  }

  {
    projects.length > 1 && (
      <div class="find">
        <label class="vh" for="project-search">
          Search projects
        </label>
        <svg class="find-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="6.5" />
          <path d="m16 16 4.5 4.5" stroke-linecap="round" />
        </svg>
        {/* type=search for the browser's own clear button and history */}
        <input
          id="project-search"
          class="find-input"
          type="search"
          placeholder="Filter by name, service or industry"
          autocomplete="off"
          data-search
        />
      </div>
    )
  }

  {
    projects.length > 0 && (
      <p class="list-help" id="list-help">
        <strong>Drag a row</strong> to change where it sits on the site. With the keyboard: focus a
        row, Space to pick it up, arrows to move, Space to drop.
      </p>
    )
  }

  {/* data-find is lowercased once here so filtering never re-derives it */}
  <ol class="plist" data-list aria-describedby="list-help">
    {
      projects.map((p, i) => (
        <li
          class="prow"
          draggable="true"
          tabindex="0"
          data-row
          data-slug={p.slug}
          data-find={`${p.title} ${titleOf(p.category)} ${p.industry ?? ''} ${p.slug}`.toLowerCase()}
          aria-label={`${p.title}, position ${i + 1}`}
        >
          <span class="prow-handle" aria-hidden="true">
            <svg viewBox="0 0 10 16" focusable="false">
              <circle cx="2.5" cy="3" r="1.15" />
              <circle cx="7.5" cy="3" r="1.15" />
              <circle cx="2.5" cy="8" r="1.15" />
              <circle cx="7.5" cy="8" r="1.15" />
              <circle cx="2.5" cy="13" r="1.15" />
              <circle cx="7.5" cy="13" r="1.15" />
            </svg>
            <span class="prow-pos" data-pos>
              {i + 1}
            </span>
          </span>

          <span class="prow-thumb">
            {p.thumb ? (
              <img
                src={p.thumb.src}
                srcset={p.thumb.srcset}
                sizes="128px"
                width={p.thumb.width}
                height={p.thumb.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              /* No cover resolves — usually a project whose deck was never
                 uploaded. It is also the reason it is invisible on the site. */
              <span class="prow-nothumb">No cover</span>
            )}
          </span>

          <span class="prow-main">
            <a class="prow-title" href={`/admin/project/${p.slug}/`}>
              {p.title}
            </a>
            <span class="prow-meta">
              {titleOf(p.category)}
              {p.industry && <> · {p.industry}</>}
            </span>
            <span class="prow-tags">
              {p.pages === 0 ? (
                <span class="chip warn">Hidden — no pages</span>
              ) : (
                <span class="chip live">Live · {countOf(p.pages, p.layout)}</span>
              )}
              {p.layout === 'icons' && <span class="chip accent">Icon set</span>}
            </span>
          </span>

          <span class="prow-go">
            <a class="prow-edit" href={`/admin/project/${p.slug}/`}>
              Edit
            </a>
            {p.pages > 0 && (
              <a href={`/work/${p.slug}/`} target="_blank" rel="noopener">
                View ↗
              </a>
            )}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="list-live" role="status" aria-live="polite" data-live></p>

  {/* Only reachable once a search has hidden everything */}
  <p class="list-none" data-empty hidden>Nothing matches that.</p>

  {
    projects.length === 0 && (
      <div class="deck-soon">
        <h2>Nothing here yet</h2>
        <p>
          &ldquo;New project&rdquo; adds one. It stays off the site until its deck is uploaded on
          the screen after.
        </p>
      </div>
    )
  }
</AdminLayout>

<script>
  /**
   * Search and reorder.
   *
   * The same interaction as the deck manager, deliberately: an operator who
   * has learned to drag pages should not have to learn a second thing to drag
   * projects. Pointer and keyboard both, for the same reason.
   */
  const list = document.querySelector<HTMLOListElement>('[data-list]');
  const live = document.querySelector<HTMLElement>('[data-live]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  const say = (message: string) => {
    if (live) live.textContent = message;
  };

  const rows = () => [...(list?.querySelectorAll<HTMLElement>('[data-row]') ?? [])];

  /** Positions shown must match positions stored, or the numbers are a lie. */
  const renumber = () => {
    for (const [i, row] of rows().entries()) {
      row.querySelector('[data-pos]')!.textContent = String(i + 1);
      row.setAttribute(
        'aria-label',
        `${row.querySelector('.prow-title')!.textContent}, position ${i + 1}`,
      );
    }
  };

  const saveOrder = async () => {
    const order = rows().map((r) => r.dataset.slug!);
    try {
      const res = await fetch('/admin/reorder/', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({ order }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'That did not save.');
      say('Order saved — the site is updated.');
    } catch (error) {
      // The rows already moved, so screen and database now disagree. Reload
      // rather than leave a wrong order looking saved.
      say(`${(error as Error).message} Reloading to show what is actually stored.`);
      setTimeout(() => location.reload(), 1500);
    }
  };

  // --- Search ---------------------------------------------------------------
  // Filtering in the browser, not on the server: the whole list is already
  // here, and a round trip per keystroke to re-sort eight rows would be slower
  // and would lose the drag state.
  search?.addEventListener('input', () => {
    const term = search.value.trim().toLowerCase();
    let shown = 0;
    for (const row of rows()) {
      const hit = term === '' || row.dataset.find!.includes(term);
      row.hidden = !hit;
      if (hit) shown++;
    }
    if (empty) empty.hidden = shown > 0;
    // Dragging while filtered would compute an order from a partial list and
    // silently move everything that is hidden.
    list?.classList.toggle('is-filtered', term !== '');
    say(term === '' ? '' : `${shown} of ${rows().length} shown.`);
  });

  // --- Drag -----------------------------------------------------------------
  let dragged: HTMLElement | null = null;

  list?.addEventListener('dragstart', (event) => {
    if (list.classList.contains('is-filtered')) {
      event.preventDefault();
      say('Clear the search before reordering — dragging a filtered list would move hidden rows.');
      return;
    }
    const row = (event.target as HTMLElement).closest<HTMLElement>('[data-row]');
    if (!row) return;
    dragged = row;
    row.classList.add('is-dragging');
    event.dataTransfer!.effectAllowed = 'move';
    event.dataTransfer!.setData('text/plain', row.dataset.slug!);
  });

  list?.addEventListener('dragover', (event) => {
    event.preventDefault();
    const over = (event.target as HTMLElement).closest<HTMLElement>('[data-row]');
    if (!over || !dragged || over === dragged) return;
    const after = dragged.compareDocumentPosition(over) & Node.DOCUMENT_POSITION_FOLLOWING;
    over.parentNode!.insertBefore(dragged, after ? over.nextSibling : over);
  });

  list?.addEventListener('dragend', () => {
    if (!dragged) return;
    dragged.classList.remove('is-dragging');
    dragged = null;
    renumber();
    void saveOrder();
  });

  // --- Keyboard -------------------------------------------------------------
  let held: HTMLElement | null = null;

  list?.addEventListener('keydown', (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('[data-row]');
    if (!row) return;

    if (event.key === ' ' || event.key === 'Enter') {
      // Enter on a link inside the row should follow the link.
      if ((event.target as HTMLElement).tagName === 'A') return;
      event.preventDefault();
      if (list!.classList.contains('is-filtered')) {
        say('Clear the search before reordering.');
        return;
      }
      if (held === row) {
        held.classList.remove('is-held');
        held = null;
        say('Dropped.');
        void saveOrder();
      } else {
        held?.classList.remove('is-held');
        held = row;
        row.classList.add('is-held');
        say(`${row.querySelector('.prow-title')!.textContent} picked up.`);
      }
      return;
    }

    if (event.key === 'Escape' && held) {
      event.preventDefault();
      held.classList.remove('is-held');
      held = null;
      location.reload();
      return;
    }

    const back = event.key === 'ArrowUp' || event.key === 'ArrowLeft';
    const forward = event.key === 'ArrowDown' || event.key === 'ArrowRight';
    if (!back && !forward) return;
    event.preventDefault();

    if (!held) {
      const all = rows().filter((r) => !r.hidden);
      const next = all[all.indexOf(row) + (back ? -1 : 1)];
      next?.focus();
      return;
    }

    const sibling = back ? held.previousElementSibling : held.nextElementSibling;
    if (!sibling) return;
    held.parentNode!.insertBefore(back ? held : sibling, back ? sibling : held);
    renumber();
    held.focus();
    say(`Moved to position ${held.querySelector('[data-pos]')!.textContent}.`);
  });
</script>

<style>
  /* --- The counts ---------------------------------------------------------
     Three facts, sized so the numbers are read before the words. The third is
     the only one that matters on a bad day, so it is the only one that can
     change colour. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.7rem;
    margin-block-end: 1.5rem;
  }

  .stat {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-sm);
  }

  .stat-n {
    display: block;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-l {
    display: block;
    margin-block-start: 0.15rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .stat.is-warn {
    border-color: color-mix(in srgb, var(--color-danger) 45%, transparent);
    background: color-mix(in srgb, var(--color-danger) 8%, var(--color-paper-raised));
  }

  .stat.is-warn .stat-n,
  .stat.is-warn .stat-l {
    color: var(--color-danger);
  }

  /* --- Search ------------------------------------------------------------- */
  .find {
    position: relative;
    margin-block-end: 1.1rem;
  }

  .find-icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.8rem;
    transform: translateY(-50%);
    inline-size: 1rem;
    block-size: 1rem;
    fill: none;
    stroke: var(--color-ink-mute);
    stroke-width: 1.7;
    pointer-events: none;
  }

  .find-input {
    inline-size: 100%;
    padding-inline-start: 2.35rem;
  }

  .list-help {
    font-size: 0.8rem;
    color: var(--color-ink-mute);
    margin: 0 0 0.6rem;
  }

  .list-help strong {
    color: var(--color-ink-soft);
  }

  /* --- Rows ---------------------------------------------------------------- */
  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .prow {
    display: grid;
    grid-template-columns: 1.5rem 128px minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem 0.6rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 13px;
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-sm);
    cursor: grab;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .prow:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--glow-card), var(--shadow-sm);
  }

  .prow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .prow.is-dragging {
    opacity: 0.35;
    cursor: grabbing;
  }

  .prow.is-held {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--color-accent-wash);
  }

  /* Reordering a filtered list would move rows nobody can see. */
  .plist.is-filtered .prow {
    cursor: default;
  }

  .plist.is-filtered .prow-handle svg {
    opacity: 0.2;
  }

  /* The row has always been draggable; nothing said so except the cursor,
     which is invisible until you are already on it. */
  .prow-handle {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }

  .prow-handle svg {
    inline-size: 0.62rem;
    block-size: 1rem;
    fill: var(--color-ink-mute);
    opacity: 0.55;
  }

  .prow:hover .prow-handle svg {
    opacity: 1;
  }

  .prow-pos {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-mute);
  }

  .prow-thumb {
    display: block;
    inline-size: 128px;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--image-bg);
    box-shadow: var(--image-frame);
  }

  .prow-thumb img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .prow-nothumb {
    display: grid;
    place-items: center;
    block-size: 100%;
    font-size: 0.7rem;
    color: var(--color-ink-mute);
  }

  .prow-main {
    min-inline-size: 0;
    display: grid;
    gap: 0.2rem;
  }

  .prow-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .prow-title:hover {
    color: var(--color-accent);
  }

  .prow-meta {
    font-size: 0.8rem;
    color: var(--color-ink-mute);
  }

  .prow-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: 0.15rem;
  }

  .prow-go {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.83rem;
    white-space: nowrap;
  }

  .prow-edit {
    color: var(--color-ink-mute);
  }

  .list-live {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    min-block-size: 1.2em;
    margin-block: 0.8rem 0;
  }

  .list-none {
    color: var(--color-ink-mute);
    margin-block-start: 1rem;
  }

  /* On a phone the thumbnail and the drag handle compete for the same row */
  @media (max-width: 640px) {
    .prow {
      grid-template-columns: 1.5rem 84px minmax(0, 1fr);
      row-gap: 0.5rem;
    }

    .prow-thumb {
      inline-size: 84px;
    }

    .prow-go {
      grid-column: 2 / -1;
    }
  }
</style>
