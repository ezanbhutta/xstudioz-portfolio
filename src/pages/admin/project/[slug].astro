---
/**
 * Edit one project.
 *
 * Field for field this is the old Sveltia form, hints included — the editor
 * should not have to relearn anything because the storage moved. Everything
 * optional stays optional, and an empty narrative field still hides its
 * section rather than printing an empty heading.
 *
 * The one rule worth repeating in the UI: nothing here may be filled in with a
 * guess. `context`, `challenge` and `outcome` are statements about a real
 * client's business.
 *
 * The client quote is deliberately not collected here. The column and the
 * case study's rendering of it both remain, so anything already stored keeps
 * showing and restoring the fields is a template change — but there is no way
 * to type one in, which is the point.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import DeckManager from '@/components/admin/DeckManager.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import {
  getProject,
  saveProject,
  deleteProject,
  validateProject,
  EXTRA_OPTIONS,
  type FieldErrors,
} from '@/lib/admin-data';
import { listPages } from '@/lib/deck';
import { CATEGORIES, type CategoryId } from '@/data/categories';
import { LOGO_TYPES, GUIDELINE_TYPES, TYPE_FILTERS } from '@/data/filters';
import { getSortedProjects } from '@/lib/content';

const routeSlug = Astro.params.slug!;
const isNew = routeSlug === 'new';

let errors: FieldErrors = {};
let submitted: FormData | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('_action') === 'delete' && !isNew) {
    await deleteProject(routeSlug);
    return Astro.redirect(`/admin/?deleted=${encodeURIComponent(routeSlug)}`, 303);
  }

  errors = validateProject(form, isNew);
  const slug = isNew ? String(form.get('slug') ?? '').trim() : routeSlug;

  // A new project cannot reuse a slug: the insert would silently overwrite the
  // existing one, because the save is an upsert keyed on it.
  if (isNew && slug && !errors.slug && (await getProject(slug))) {
    errors.slug = 'A project already uses this URL.';
  }

  if (Object.keys(errors).length === 0) {
    await saveProject(form, slug);
    // A new project goes to its own editor rather than back to the list. The
    // deck is the next thing wanted every time, and it can only be uploaded
    // once the project exists — bouncing to the list means finding the project
    // again to do the half of the job that is actually left.
    return isNew
      ? Astro.redirect(`/admin/project/${slug}/?created=1`, 303)
      : Astro.redirect(`/admin/?saved=${encodeURIComponent(String(form.get('title')))}`, 303);
  }
  submitted = form;
}

const existing = isNew ? undefined : await getProject(routeSlug);
if (!isNew && !existing) return Astro.redirect('/admin/', 303);

const images = isNew ? [] : await listPages(routeSlug);

/** Prefer what was just typed (so a failed save keeps the edits), then the row. */
const val = (name: string, fallback: unknown = ''): string => {
  if (submitted) {
    const v = submitted.get(name);
    return typeof v === 'string' ? v : '';
  }
  return fallback == null ? '' : String(fallback);
};

const jsonArr = (raw: unknown): string[] => {
  if (Array.isArray(raw)) return raw as string[];
  try {
    const p = JSON.parse(String(raw ?? '[]'));
    return Array.isArray(p) ? p : [];
  } catch {
    return [];
  }
};

const listVal = (name: string, raw: unknown): string =>
  submitted ? val(name) : jsonArr(raw).join('\n');

const checkedExtras = submitted
  ? submitted.getAll('extras').map(String)
  : jsonArr(existing?.extras);

// Industries already in use, so a new project joins an existing group rather
// than starting a category of one.
const industries = [
  ...new Set((await getSortedProjects()).map((p) => p.data.industry).filter(Boolean)),
].sort() as string[];

const justCreated = Astro.url.searchParams.get('created') !== null;
const uploaded = Astro.url.searchParams.get('uploaded');
const uploadError = Astro.url.searchParams.get('uploadError');

const currentIndustry = val('industry', existing?.industry);
const title = isNew ? 'New project' : (existing?.title ?? routeSlug);

/**
 * The two choices the rest of the form answers to.
 *
 * Both are rendered server-side into the state they imply, so the form is
 * already correct on arrival and stays correct with JavaScript off. The script
 * at the bottom only keeps it correct while the operator changes its mind.
 */
const currentCategory = val('category', existing?.category ?? CATEGORIES[0].id);
const currentLayout = val('layout', existing?.layout ?? 'deck') === 'icons' ? 'icons' : 'deck';

/**
 * Which type dropdown a service actually uses, read from the same table the
 * public filters read. A guidelines type on a logo project is a field that can
 * only ever be wrong, and the operator had no way to know that from looking at
 * it — the hint said "Brand Guidelines projects only" underneath a control
 * that was always there.
 *
 * The logo type stays for every service: it filters Logo Design, and on
 * everything else it names the mark the work was built around, which the case
 * study prints as "Mark".
 */
const guidelineTypeApplies = (category: string) =>
  TYPE_FILTERS[category as CategoryId]?.key === 'guidelineType';

/**
 * How much is in each optional section.
 *
 * Every one of these fields is optional and most projects use few of them, so
 * they open only when they hold something and otherwise announce what they
 * are and stay out of the way. The count is what makes a closed section
 * honest: "Story — empty" is a fact, where a bare collapsed heading is a place
 * something might be hiding.
 */
const filled = (...values: unknown[]) => values.filter((v) => String(v ?? '').trim() !== '').length;

const storyFields = [
  val('context', existing?.context),
  val('challenge', existing?.challenge),
  val('direction', existing?.direction),
  listVal('delivered', existing?.delivered),
  val('outcome', existing?.outcome),
];
const linkFields = [
  val('website', existing?.website),
  val('instagram', existing?.instagram),
  val('facebook', existing?.facebook),
  val('linkedin', existing?.linkedin),
  listVal('other_links', existing?.other_links),
];
const storyCount = filled(...storyFields);
const linkCount = filled(...linkFields);
const extrasCount =
  checkedExtras.length + filled(listVal('extras_custom', existing?.extras_custom));

/** A section opens if it has content, or if a failed save put an error in it. */
const anyError = Object.keys(errors).length > 0;

/**
 * What is still missing, said out loud.
 *
 * Each of these is a fact the editor already had and never mentioned. The
 * expensive one is the first: `getSortedProjects` drops a project with no
 * images, so a project can be saved, look complete, and simply not be on the
 * site — and the only way to find out was to go and look at the grid. The
 * others are smaller but the same shape: quiet omissions that nothing on this
 * screen was ever going to point at.
 *
 * Only ever computed, never guessed. A check that is satisfied says so rather
 * than disappearing, because "no warnings" and "nothing checked" look
 * identical otherwise.
 */
const named = images.filter((i) => i.label.trim() !== '').length;

const readiness = isNew
  ? []
  : [
      images.length === 0
        ? { ok: false, label: 'Not on the site', note: 'It has no pages, so nothing renders it.' }
        : {
            ok: true,
            label: 'Live on the site',
            count: images.length,
            note: `${images.length} ${currentLayout === 'icons' ? 'sheet' : 'page'}${images.length === 1 ? '' : 's'} published.`,
          },
      existing?.cover_alt
        ? { ok: true, label: 'Cover described', note: 'The grid thumbnail has alt text.' }
        : {
            ok: false,
            label: 'Cover not described',
            note: 'A screen reader announces nothing for the thumbnail on the work grid.',
          },
      ...(currentLayout === 'icons' && images.length > 0
        ? [
            named === images.length
              ? { ok: true, label: 'Every sheet named', note: 'All captions are filled in.' }
              : {
                  ok: false,
                  label: `${named} of ${images.length} sheets named`,
                  note: 'An unnamed sheet shows no caption under it on the case study.',
                },
          ]
        : []),
    ];
---

<AdminLayout title={title} eyebrow={isNew ? 'New project' : 'Editing'} heading={title}>
  <p slot="lede" class="sub" data-sub-count={isNew ? undefined : String(images.length)}>
    {
      isNew
        ? 'Fill this in and save. The deck is uploaded on the next screen — a project stays off the site until it has one.'
        : `${images.length} ${currentLayout === 'icons' ? 'sheet' : 'page'}${images.length === 1 ? '' : 's'}. Saving publishes immediately.`
    }
  </p>

  {
    /* The live page, from the screen that changes it. Only once there is one:
       a project with no pages is dropped by getSortedProjects, so the link
       would be a 404 and the operator would be told nothing about why. */
    !isNew && images.length > 0 && (
      <a
        class="btn ghost sm"
        slot="actions"
        href={`/work/${routeSlug}/`}
        target="_blank"
        rel="noopener"
      >
        View live page ↗
      </a>
    )
  }

  {
    readiness.length > 0 && (
      <ul class="ready">
        {readiness.map((r) => (
          <li class:list={['ready-item', r.ok ? 'is-ok' : 'is-todo']}>
            <span class="ready-mark" aria-hidden="true">
              {r.ok ? '✓' : '!'}
            </span>
            <span>
              <strong>{r.label}</strong>
              <span
                class="ready-note"
                data-ready-count={'count' in r ? String(r.count) : undefined}
              >
                {r.note}
              </span>
            </span>
          </li>
        ))}
      </ul>
    )
  }

  {
    justCreated && (
      <p class="flash ok">
        Project created. Upload its deck below — it stays off the site until it has one.
      </p>
    )
  }
  {uploaded && <p class="flash ok">{uploaded}</p>}
  {uploadError && <p class="flash bad">{uploadError}</p>}

  {
    Object.keys(errors).length > 0 && (
      <p class="flash bad">Nothing was saved — check the fields marked below.</p>
    )
  }

  {
    /* The deck sits above the form, not below it. It is what an operator comes
       here to change, and it was previously the last thing on a 4,000px page —
       below the save button, which is why it read as "there is no upload". It
       saves on its own, so it must not be inside the form either. */
    !isNew ? (
      <DeckManager
        slug={routeSlug}
        pages={images}
        pdf={existing?.pdf}
        layout={existing?.layout === 'icons' ? 'icons' : 'deck'}
      />
    ) : (
      /* Uploading needs a project to attach pages to, so it cannot happen
         before the first save. Saying that here — in the place the upload will
         appear — beats an empty space that reads as a missing feature. */
      <section class="deck-soon">
        <h2>The deck</h2>
        <p>
          Save this project first. The PDF upload appears right here, and every page becomes a page
          of the case study.
        </p>
      </section>
    )
  }

  <form method="POST" data-editor>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">Basics</h2>
      </div>

      {
        isNew && (
          <label>
            <span class="lab">URL slug</span>
            <span class="hint">
              Becomes /work/&lt;slug&gt;/. Lowercase, hyphens, no spaces. Cannot be changed later.
            </span>
            <input
              type="text"
              name="slug"
              value={val('slug')}
              aria-invalid={errors.slug ? 'true' : undefined}
              required
            />
            {errors.slug && <span class="err">{errors.slug}</span>}
          </label>
        )
      }

      <label>
        <span class="lab">Title</span>
        <input
          type="text"
          name="title"
          value={val('title', existing?.title)}
          aria-invalid={errors.title ? 'true' : undefined}
          required
        />
        {errors.title && <span class="err">{errors.title}</span>}
      </label>

      <div class="grid2">
        <label>
          <span class="lab">Service</span>
          <select name="category" aria-invalid={errors.category ? 'true' : undefined} required>
            {
              CATEGORIES.map((c) => (
                <option value={c.id} selected={val('category', existing?.category) === c.id}>
                  {c.title}
                </option>
              ))
            }
          </select>
          {errors.category && <span class="err">{errors.category}</span>}
        </label>

        <label>
          <span class="lab">Layout</span>
          <span class="hint">
            How the case study shows its images. A deck reads in one column, in order. A set lays
            them out as a grid, each with its own name and kind.
          </span>
          <select name="layout">
            <option value="deck" selected={val('layout', existing?.layout ?? 'deck') !== 'icons'}>
              Deck — pages of a document
            </option>
            <option value="icons" selected={val('layout', existing?.layout ?? 'deck') === 'icons'}>
              Icon set — a grid of separate marks
            </option>
          </select>
        </label>
      </div>

      <div class="grid2">
        <label>
          <span class="lab">Logo type</span>
          <span class="hint" data-logo-hint>
            {
              currentCategory === 'logo-design'
                ? 'The kind of mark this project is. Powers the Type filter on Logo Design.'
                : 'The kind of mark this work was built around. Shown on the case study as “Mark”.'
            }
          </span>
          <select name="logo_type">
            <option value="">— none —</option>
            {
              LOGO_TYPES.map((t) => (
                <option value={t} selected={val('logo_type', existing?.logo_type) === t}>
                  {t}
                </option>
              ))
            }
          </select>
        </label>

        {
          /* Only Brand Guidelines uses this — TYPE_FILTERS says so, and the
            public Type filter reads the same table. Hidden rather than
            removed, so switching service away and back does not quietly drop
            a value that was already saved. */
        }
        <label data-when-guidelines hidden={!guidelineTypeApplies(currentCategory)}>
          <span class="lab">Guidelines type</span>
          <span class="hint">How complete the guidelines document is.</span>
          <select name="guideline_type">
            <option value="">— none —</option>
            {
              GUIDELINE_TYPES.map((t) => (
                <option value={t} selected={val('guideline_type', existing?.guideline_type) === t}>
                  {t}
                </option>
              ))
            }
          </select>
        </label>
      </div>

      <label>
        <span class="lab">Industry</span>
        <span class="hint">
          Reuse an existing spelling where one fits — two projects sharing a spelling group
          together, a typo makes a category of one. Type a new one to start a group.
        </span>
        <input type="text" name="industry" value={currentIndustry} list="industries" />
        <datalist id="industries">
          {industries.map((i) => <option value={i} />)}
        </datalist>
      </label>
    </section>

    <details class="fold" open={extrasCount > 0}>
      <summary>
        <span class="fold-title">Extra elements</span>
        <span class="fold-count">{extrasCount === 0 ? 'none' : `${extrasCount} ticked`}</span>
      </summary>
      <p class="legend-note">
        Anything included beyond the core sections. Listed on the case study, so tick them
        accurately.
      </p>
      {
        /* A real group, so a screen reader reads the question before the
          twelve answers rather than twelve unrelated checkboxes. */
      }
      <fieldset class="bare">
        <legend class="vh">Extra elements included in this project</legend>
        <div class="checks">
          {
            EXTRA_OPTIONS.map((e) => (
              <label>
                <input
                  type="checkbox"
                  name="extras"
                  value={e}
                  checked={checkedExtras.includes(e)}
                />
                <span>{e}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <label>
        <span class="lab">Custom extras</span>
        <span class="hint">Anything the list above does not cover, one per line.</span>
        <textarea name="extras_custom">{listVal('extras_custom', existing?.extras_custom)}</textarea
        >
      </label>
    </details>

    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">Copy</h2>
      </div>

      <label>
        <span class="lab">Details</span>
        <span class="hint">
          A sentence or two. Shown on the case study and used as its meta description.
        </span>
        <textarea name="summary" aria-invalid={errors.summary ? 'true' : undefined} required
          >{val('summary', existing?.summary)}</textarea
        >
        {errors.summary && <span class="err">{errors.summary}</span>}
      </label>

      <label>
        <span class="lab">One-line intent</span>
        <span class="hint">
          The strategic idea in about 70 characters. The standfirst on the case study.
        </span>
        <input type="text" name="intent" value={val('intent', existing?.intent)} />
      </label>
    </section>

    <details class="fold" open={storyCount > 0 || anyError}>
      <summary>
        <span class="fold-title">Story</span>
        <span class="fold-count">
          {storyCount === 0 ? 'empty' : `${storyCount} of ${storyFields.length} written`}
        </span>
      </summary>
      <p class="legend-note">
        Every field optional — an empty one hides its section. Never fill these with a guess: they
        are statements about a real client's business.
      </p>

      <label>
        <span class="lab">Client &amp; context</span>
        <textarea name="context">{val('context', existing?.context)}</textarea>
      </label>
      <label>
        <span class="lab">The challenge</span>
        <textarea name="challenge">{val('challenge', existing?.challenge)}</textarea>
      </label>
      <label>
        <span class="lab">Creative direction</span>
        <textarea name="direction">{val('direction', existing?.direction)}</textarea>
      </label>
      <label>
        <span class="lab">What was delivered</span>
        <span class="hint">
          One per line. Leave empty and it is built from the project type plus its extras.
        </span>
        <textarea name="delivered">{listVal('delivered', existing?.delivered)}</textarea>
      </label>
      <label>
        <span class="lab">Verified outcome</span>
        <span class="hint">
          ONLY a result the client actually reported. Empty hides the section; an invented one is a
          lie a client can check.
        </span>
        <textarea name="outcome">{val('outcome', existing?.outcome)}</textarea>
      </label>
    </details>

    <details class="fold" open={linkCount > 0}>
      <summary>
        <span class="fold-title">Links</span>
        <span class="fold-count">{linkCount === 0 ? 'none' : `${linkCount} set`}</span>
      </summary>
      <div class="grid2">
        <label>
          <span class="lab">Brand website</span>
          <input type="text" name="website" value={val('website', existing?.website)} />
        </label>
        <label>
          <span class="lab">Instagram</span>
          <input type="text" name="instagram" value={val('instagram', existing?.instagram)} />
        </label>
        <label>
          <span class="lab">Facebook</span>
          <input type="text" name="facebook" value={val('facebook', existing?.facebook)} />
        </label>
        <label>
          <span class="lab">LinkedIn</span>
          <input type="text" name="linkedin" value={val('linkedin', existing?.linkedin)} />
        </label>
      </div>
      <label>
        <span class="lab">Other links</span>
        <span class="hint">One per line — TikTok, Behance, X…</span>
        <textarea name="other_links">{listVal('other_links', existing?.other_links)}</textarea>
      </label>
    </details>

    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">Grid cover</h2>
      </div>
      <p class="panel-note" data-cover-note>
        {
          currentLayout === 'icons'
            ? 'The cover is the first sheet. Star any other in the set above to use that instead. This is what a screen reader announces for the thumbnail on the work grid.'
            : 'The cover is page one of the deck. Star any other page above to use that instead. This is what a screen reader announces for the thumbnail on the work grid.'
        }
      </p>
      <label>
        <span class="lab">Cover alt text</span>
        <span class="hint">Describe what the grid thumbnail shows.</span>
        <input type="text" name="cover_alt" value={val('cover_alt', existing?.cover_alt)} />
      </label>
    </section>

    <SaveBar
      label={isNew ? 'Create project — then add the deck' : 'Save — publishes immediately'}
      cancelHref="/admin/"
    />
  </form>

  {
    /* Set apart and named, because it is the one control on this screen with
       no undo behind it and it used to sit loose under the save bar. */
    !isNew && (
      <section class="danger-zone">
        <div>
          <h2 class="panel-title">Delete this project</h2>
          <p class="panel-note">
            It disappears from the live site immediately and cannot be brought back. Its uploaded
            image files are left on disk.
          </p>
        </div>
        <form
          method="POST"
          onsubmit="return confirm('Delete this project? It disappears from the live site immediately. This cannot be undone.')"
        >
          <input type="hidden" name="_action" value="delete" />
          <button class="btn danger" type="submit">
            Delete project
          </button>
        </form>
      </section>
    )
  }
</AdminLayout>

<script>
  /**
   * The form answers to two of its own fields.
   *
   * Service decides whether a guidelines type is a real question or a control
   * that can only ever be wrong, and what the logo type is being asked for.
   * Layout decides whether the images above are pages of a document or sheets
   * of marks, which changes what the deck manager is called, whether each
   * image can be named, and where the cover comes from.
   *
   * Both are already rendered into the right state by the server, so the page
   * is correct on arrival and stays correct with JavaScript off. This only
   * keeps it correct while the operator is still deciding — the alternative is
   * saving to find out, on a form long enough that the answer is off-screen.
   *
   * Nothing here disables or clears a field. A hidden input still submits its
   * value, so switching service away from Brand Guidelines and back finds the
   * guidelines type exactly as it was rather than silently blanked.
   */
  const form = document.querySelector<HTMLFormElement>('[data-editor]');
  const category = form?.querySelector<HTMLSelectElement>('select[name="category"]');
  const layout = form?.querySelector<HTMLSelectElement>('select[name="layout"]');

  if (form && category) {
    const guidelines = form.querySelector<HTMLElement>('[data-when-guidelines]');
    const logoHint = form.querySelector<HTMLElement>('[data-logo-hint]');

    const applyCategory = () => {
      // Brand Guidelines is the only service with a guidelines type, which is
      // the same rule TYPE_FILTERS gives the public filters.
      if (guidelines) guidelines.hidden = category.value !== 'brand-guidelines';
      if (logoHint) {
        logoHint.textContent =
          category.value === 'logo-design'
            ? 'The kind of mark this project is. Powers the Type filter on Logo Design.'
            : 'The kind of mark this work was built around. Shown on the case study as “Mark”.';
      }
    };

    category.addEventListener('change', applyCategory);
    applyCategory();
  }

  if (form && layout) {
    const deck = document.querySelector<HTMLElement>('[data-deck]');
    const coverNote = form.querySelector<HTMLElement>('[data-cover-note]');
    const sub = document.querySelector<HTMLElement>('[data-sub-count]');

    const applyLayout = () => {
      const icons = layout.value === 'icons';

      // The deck manager reads this to swap its own wording and reveal the
      // per-sheet name and kind. Those fields are always in the DOM, so the
      // switch costs no request and nothing typed is lost by flipping back.
      if (deck) deck.dataset.layout = icons ? 'icons' : 'deck';

      if (coverNote) {
        coverNote.textContent = icons
          ? 'The cover is the first sheet. Star any other in the set above to use that instead. This is what a screen reader announces for the thumbnail on the work grid.'
          : 'The cover is page one of the deck. Star any other page above to use that instead. This is what a screen reader announces for the thumbnail on the work grid.';
      }

      const noun = icons ? 'sheet' : 'page';

      if (sub) {
        const n = Number(sub.dataset.subCount ?? '0');
        sub.textContent = `${n} ${noun}${n === 1 ? '' : 's'}. Saving publishes immediately.`;
      }

      // The readiness strip counts the same images by the same name. Leaving
      // it saying "pages" while everything else says "sheets" reads as two
      // parts of the screen disagreeing about what is on it.
      const ready = document.querySelector<HTMLElement>('[data-ready-count]');
      if (ready) {
        const n = Number(ready.dataset.readyCount ?? '0');
        ready.textContent = `${n} ${noun}${n === 1 ? '' : 's'} published.`;
      }
    };

    layout.addEventListener('change', applyLayout);
    applyLayout();
  }
</script>

<style>
  /* --- Readiness ----------------------------------------------------------
     Three facts about this project, above everything that can change them. */
  .ready {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .ready-item {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-paper-raised);
    font-size: 0.83rem;
  }

