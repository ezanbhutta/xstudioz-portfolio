---
/**
 * Brand and links.
 *
 * Rendered from the rows that exist rather than a hardcoded field list, so a
 * setting added to the database appears here without a code change. The labels
 * and hints below are the ones the old CMS showed; a key with no entry falls
 * back to its own name, which is ugly but never hides a field.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import SaveBar from '@/components/admin/SaveBar.astro';
import { listSettings, saveSettings } from '@/lib/admin-data';
import { listRebuildTargets } from '@/lib/image-maintenance';

const META: Record<string, { label: string; hint?: string; multiline?: boolean }> = {
  name: { label: 'Studio name' },
  url: {
    label: 'Production URL',
    hint: 'No trailing slash. Canonicals, the sitemap and social cards all derive from it — if this is wrong, search engines are told the wrong address.',
  },
  headline: {
    label: 'Homepage headline',
    hint: 'The one line a first-time visitor reads. Say what they get, not what you do.',
  },
  lede: {
    label: 'Homepage paragraph',
    hint: 'Two lines under the headline. Concrete: what is designed, and what is handed over.',
    multiline: true,
  },
  tagline: { label: 'Tagline' },
  description: { label: 'Site description', multiline: true },
  fiverrUrl: {
    label: 'Fiverr profile URL',
    hint: 'Every "Hire on Fiverr" button on the site points here.',
  },
  linkedinUrl: {
    label: 'Studio LinkedIn URL',
    hint: 'When filled, "Connect on LinkedIn" appears site-wide. Empty hides it.',
  },
  behanceUrl: { label: 'Behance URL', hint: 'Optional. Footer only when filled.' },
  instagramUrl: { label: 'Instagram URL', hint: 'Optional. Footer only when filled.' },
  locale: { label: 'Locale' },
};

/**
 * What belongs with what.
 *
 * The list was thirteen identical text fields in database order, which put the
 * production URL — the one setting that can break every canonical on the site
 * — between a tagline and a Fiverr link. Grouping does not change what is
 * saved; it changes how long it takes to find the field you came for.
 */
const GROUPS: { title: string; note: string; keys: string[] }[] = [
  {
    title: 'Identity',
    note: 'The studio\u2019s name and address, and the words search engines and social cards quote.',
    keys: ['name', 'url', 'tagline', 'description', 'locale'],
  },
  {
    title: 'Homepage',
    note: 'The first two things a visitor reads, above everything else on the site.',
    keys: ['headline', 'lede'],
  },
  {
    title: 'Where to hire and follow',
    note: 'An empty field hides its link everywhere rather than printing a dead one.',
    keys: ['fiverrUrl', 'linkedinUrl', 'behanceUrl', 'instagramUrl'],
  },
];

let saved = false;
if (Astro.request.method === 'POST') {
  await saveSettings(await Astro.request.formData());
  saved = true;
}

const settings = await listSettings();

const grouped = new Set(GROUPS.flatMap((g) => g.keys));
const ungrouped = settings.filter((s) => !grouped.has(s.setting_key));

/**
 * How much of the portfolio is on the current image ladder.
 *
 * Counted rather than assumed, because the answer changes on its own: every
 * upload adds an image already up to date, and every change to the ladder puts
 * every existing image behind it again.
 */
const images = await listRebuildTargets();
const behind = images.filter((i) => !i.formats.includes('avif')).length;
---

<AdminLayout title="Settings" eyebrow="Site" heading="Brand & links">
  <p slot="lede">
    Used across every page of the public site. Changes are live the moment they are saved.
  </p>

  {saved && <p class="flash ok">Saved. Live now.</p>}

  <form method="POST" data-editor>
    {
      GROUPS.map(({ title, note, keys }) => {
        // In the group's order, not the database's: "Studio name" before
        // "Locale" is the difference between a form and a dump of a table.
        const fields = keys
          .map((k) => settings.find((s) => s.setting_key === k))
          .filter((s): s is (typeof settings)[number] => Boolean(s));
        // A group with nothing in it is a heading over empty space. Settings
        // are read from the rows that exist, so this is a real possibility.
        return fields.length === 0 ? null : (
          <section class="panel">
            <div class="panel-head">
              <h2 class="panel-title">{title}</h2>
            </div>
            <p class="panel-note">{note}</p>
            {fields.map(({ setting_key, setting_value }) => {
              const meta = META[setting_key] ?? { label: setting_key };
              return (
                <label>
                  <span class="lab">{meta.label}</span>
                  {meta.hint && <span class="hint">{meta.hint}</span>}
                  {meta.multiline ? (
                    <textarea name={setting_key}>{setting_value}</textarea>
                  ) : (
                    <input type="text" name={setting_key} value={setting_value} />
                  )}
                </label>
              );
            })}
          </section>
        );
      })
    }

    {
      /* Anything the groups above do not name. A setting added to the database
         has always appeared here without a code change, and grouping must not
         be the thing that quietly stops that. */
      ungrouped.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h2 class="panel-title">Other</h2>
          </div>
          <p class="panel-note">
            Settings in the database that this screen has no description for. They still save.
          </p>
          {ungrouped.map(({ setting_key, setting_value }) => (
            <label>
              <span class="lab">{META[setting_key]?.label ?? setting_key}</span>
              <input type="text" name={setting_key} value={setting_value} />
            </label>
          ))}
        </section>
      )
    }

    <SaveBar label="Save — live immediately" />
  </form>

  {
    /* Outside the form on purpose: it saves nothing, and a button inside a
      form guarded against unsaved changes would ask to confirm on the way. */
  }
  <section class="panel maint">
    <div class="panel-head">
      <h2 class="panel-title">Image variants</h2>
    </div>
    <p class="panel-note">
      Every uploaded image is written at four widths in WebP and AVIF, so a phone downloads a
      quarter of what a desktop does and a modern browser downloads about a third less again. Images
      published before a width or a format existed do not have it until they are rebuilt — which
      reads the widest file already on disk, so no PDF is needed and nothing published changes.
    </p>

    <p class="maint-state" data-maint-state>
      {
        images.length === 0
          ? 'No uploaded images yet.'
          : behind === 0
            ? `All ${images.length} images are on the current ladder.`
            : `${behind} of ${images.length} image${images.length === 1 ? '' : 's'} ${behind === 1 ? 'is' : 'are'} missing widths or AVIF.`
      }
    </p>

    {
      images.length > 0 && (
        <div class="maint-go">
          <button class="btn ghost" type="button" data-maint-run>
            Rebuild image variants
          </button>
          <div class="maint-prog" data-maint-prog hidden>
            <div class="maint-bar">
              <span data-maint-bar />
            </div>
            <p class="maint-log" data-maint-log />
          </div>
        </div>
      )
    }
  </section>
</AdminLayout>

<script>
  /**
   * One image per request, in order, reporting as it goes.
   *
   * The same loop the deck upload uses: the work is bounded per request, so
   * nothing here can outlive a gateway, and a hundred and forty encodes are
   * visible as they happen rather than as a spinner that either finishes or
   * does not.
   */
  const run = document.querySelector<HTMLButtonElement>('[data-maint-run]');
  const prog = document.querySelector<HTMLElement>('[data-maint-prog]');
  const bar = document.querySelector<HTMLElement>('[data-maint-bar]');
  const log = document.querySelector<HTMLElement>('[data-maint-log]');
  const state = document.querySelector<HTMLElement>('[data-maint-state]');

  const post = async (body: unknown) => {
    const res = await fetch('/admin/images/rebuild/', {
      method: 'POST',
      headers: { 'content-type': 'application/json', accept: 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error ?? 'That failed.');
    return data;
  };

  run?.addEventListener('click', async () => {
    run.disabled = true;
    run.textContent = 'Rebuilding…';
    if (prog) prog.hidden = false;
    let written = 0;
    let skipped = 0;
    try {
      const { total } = await post({ action: 'list' });
      for (let i = 0; i < total; i++) {
        if (log) log.textContent = `Image ${i + 1} of ${total}…`;
        const r = await post({ action: 'one', index: i });
        written += r.wrote ?? 0;
        if (r.skipped) {
          skipped++;
          console.warn(`[rebuild] ${r.src}: ${r.skipped}`);
        }
        if (bar) bar.style.inlineSize = `${Math.round(((i + 1) / total) * 100)}%`;
      }
      if (log) {
        log.textContent =
          `Done — ${written} file${written === 1 ? '' : 's'} written` +
          (skipped ? `, ${skipped} skipped (see the console).` : '.');
      }
      // The count above is now wrong, and it is the thing being fixed.
      if (state) state.textContent = 'Rebuilt. Reload to see the current count.';
      run.textContent = 'Rebuild again';
    } catch (error) {
      if (log) log.textContent = (error as Error).message;
      run.textContent = 'Rebuild image variants';
    } finally {
      run.disabled = false;
    }
  });
</script>

<style>
  .maint {
    margin-block-start: 2rem;
    padding-block-end: 1.35rem;
  }

  .maint-state {
    margin: 0 0 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .maint-go {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .maint-prog {
    flex: 1 1 14rem;
    min-inline-size: 0;
  }

  .maint-bar {
    block-size: 0.4rem;
    border-radius: 999px;
    background: var(--color-line);
    overflow: hidden;
  }

  .maint-bar span {
    display: block;
    inline-size: 0;
    block-size: 100%;
    border-radius: 999px;
    background: var(--gradient-accent);
    transition: inline-size 200ms ease;
  }

  .maint-log {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: var(--color-ink-mute);
  }
</style>
