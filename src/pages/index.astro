---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicePreview from '@/components/ServicePreview.astro';
import ServiceNav from '@/components/ServiceNav.astro';
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
import { getSortedProjects, industriesOf } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const industries = industriesOf(projects);

/**
 * One preview per service that has published work, in the order services are
 * listed in src/data/categories.json — so the running order is a content
 * edit, and the strongest body of work leads simply by being listed first.
 *
 * Each preview shows PREVIEW_COUNT projects and hands off to that service's
 * own page for the rest, where the filters live too. The homepage establishes
 * taste and points; it is not the whole portfolio.
 *
 * Services with nothing published are named in one line further down instead
 * of getting a block each. Three empty headings in a row cost more attention
 * than they return, and the visitor met them at exactly the moment they were
 * deciding whether to message. The line still says plainly that there is no
 * case study yet, and each name links to a page that sells the service.
 */
const PREVIEW_COUNT = 2;

const sections = ACTIVE_CATEGORIES.map((category) => ({
  category,
  projects: projects.filter((p) => p.data.category === category.id),
}));

const withWork = sections.filter((s) => s.projects.length > 0);
const withoutWork = sections.filter((s) => s.projects.length === 0).map((s) => s.category);

// Only counts that are true by construction. Nothing here is a claim that
// needs backing up — they are literally the length of what is on the site.
const facts = [
  { label: 'Projects published', value: String(projects.length).padStart(2, '0') },
  { label: 'Industries served', value: String(industries.length).padStart(2, '0') },
  { label: 'Ordered through', value: 'Fiverr' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="hero-heading">
    <p class="overline" data-enter style="--enter-step:0">Logo &amp; Brand Identity Studio</p>
    <h1 id="hero-heading" class="hero-title" data-enter style="--enter-step:1">
      {SITE.headline}
    </h1>

    <div class="hero-body">
      <div class="hero-pitch" data-enter style="--enter-step:2">
        <p class="hero-lede">{SITE.lede}</p>
        <div class="hero-actions">
          <a
            class="button button--primary button--lg"
            href={SITE.fiverrUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Start on Fiverr <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--outline button--lg" href="#work"
            >View the work <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>

      {
        /* A spec block, the way a studio annotates a plate: the numbers that
          answer "are these people real?" before the visitor scrolls. Both
          counts are computed from what is actually published. */
      }
      <dl class="hero-facts" data-enter style="--enter-step:3">
        {
          facts.map((f) => (
            <div class="hero-fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <ServiceNav />

  {
    /* The portfolio, split by what a buyer came to buy — two examples each,
      then out to the service page for the rest. */
  }
  <div id="work">
    {
      withWork.map(({ category, projects: items }, i) => (
        <ServicePreview category={category} projects={items} count={PREVIEW_COUNT} lead={i === 0} />
      ))
    }

    {
      withoutWork.length > 0 && (
        <section class="also" aria-labelledby="also-heading">
          <div class="container also-inner">
            <h2 id="also-heading" class="also-label">
              Also offered — no case study published yet
            </h2>
            <ul class="also-list" role="list">
              {withoutWork.map((c) => (
                <li>
                  <a class="also-link" href={`/${c.id}/`} data-astro-prefetch>
                    {c.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Tighter than a marketing hero on purpose: this is a portfolio, so the
     first real work should be reachable in one short scroll, not two. */
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .hero-title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-xs) var(--space-xl);
    /* Long enough to say something, short enough to break in two lines */
    max-width: 16ch;
  }

  /* Pitch left, spec block right — asymmetric, and it puts the proof beside
     the claim instead of underneath it. */
  .hero-body {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero-body {
      grid-template-columns: minmax(0, var(--measure)) auto;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  @media (max-width: 419px) {
    .hero-actions {
      display: grid;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero-facts {
      display: grid;
      gap: var(--space-md);
      padding-inline-start: var(--space-lg);
      border-inline-start: 1px solid var(--color-line);
    }
  }

  .hero-fact dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }

  /* One quiet line, not three empty sections. Says what else is on offer,
     says honestly that there is nothing published behind it yet, and hands
     the visitor to a page that can actually sell it. */
  .also {
    padding-block: var(--space-lg);
    border-block-start: 1px solid var(--color-line);
  }

  .also-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
  }

  .also-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .also-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .also-link {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.3em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .also-link:hover {
      color: var(--color-accent);
      text-decoration-color: var(--color-accent);
    }
  }
</style>
