---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FilterBar from '@/components/FilterBar.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { SITE } from '@/config/site';
import { getSortedProjects, countByCategory } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const counts = countByCategory(projects);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} — Logos, Brand Identity & Motion`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container">
    <p class="overline">Independent Design Studio</p>
    <h1 class="hero-title">Identity, crafted<br />with intent<span class="accent-dot">.</span></h1>
    <p class="page-lede">
      Logos, brand identities and visual systems for ambitious businesses — designed quietly, built
      to last.
    </p>
    <div class="hero-actions">
      <a
        class="button button--primary"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hire on Fiverr <span aria-hidden="true">↗</span>
      </a>
      <a class="button button--outline" href="#work"
        >View the work <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>

  <section id="work" class="work-section" aria-label="Portfolio">
    <FilterBar counts={counts} total={projects.length} enhanced />
    <div class="container work-container">
      <WorkGrid projects={projects} eagerCount={2} filterable heading="Selected work" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl);
  }

  .hero-title {
    font-size: var(--text-display);
    margin-block: var(--space-md);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  .work-container {
    padding-block-start: var(--space-xl);
  }
</style>
