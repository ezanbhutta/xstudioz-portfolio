---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicePreview from '@/components/ServicePreview.astro';
import ServiceNav from '@/components/ServiceNav.astro';
import CoverMarquee from '@/components/CoverMarquee.astro';
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
import { getSortedProjects, industriesOf, projectsForService } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const industries = industriesOf(projects);

/**
 * One preview per service that has published work, in the order services are
 * listed in src/data/categories.json — so the running order is a content
 * edit, and the strongest body of work leads simply by being listed first.
 *
 * Each preview shows PREVIEW_COUNT projects and hands off to that service's
 * own page for the rest, where the filters live too. The homepage establishes
 * taste and points; it is not the whole portfolio.
 *
 * A service with nothing published gets a line, not a section. It used to get
 * the same full-height band as a service with work — a heading, air, and a
 * link — which measured 411px each. On a site where two of five services have
 * no case study of their own that is 800px of the home page spent saying
 * "nothing here", twice, between bodies of work a visitor came to see. The
 * range still gets stated, one row of links wide, below the work rather than
 * interrupting it.
 */
const PREVIEW_COUNT = 2;

/**
 * A service's work, counted the way the service's own page counts it.
 *
 * This filtered on `category` alone, which is only half the rule. A project
 * that carried Stationery or a Social Media Kit as an extra is real evidence
 * for that service — `projectsForService` says so, `[category]/index.astro`
 * has always used it, and this page never did. The consequence was visible:
 * Stationery and Social Media rendered as a heading over empty space here
 * while their own pages showed three covers and two, one click away.
 */
const allSections = ACTIVE_CATEGORIES.map((category) => {
  const { direct, viaExtras } = projectsForService(projects, category);
  return { category, direct, viaExtras, projects: [...direct, ...viaExtras] };
});

const sections = allSections.filter((s) => s.projects.length > 0);
const alsoOffered = allSections.filter((s) => s.projects.length === 0).map((s) => s.category);

// Only counts that are true by construction. Nothing here is a claim that
// needs backing up — they are literally the length of what is on the site.
const facts = [
  { label: 'Projects published', value: String(projects.length).padStart(2, '0') },
  { label: 'Industries served', value: String(industries.length).padStart(2, '0') },
  { label: 'Ordered through', value: 'Fiverr' },
];

/**
 * The headline turns on its last word, so the gradient has one job and one
 * place. Splitting here rather than storing markup in the config keeps
 * site.json plain text that anyone can edit in the CMS.
 */
const words = SITE.headline.trim().split(' ');
const headlineLead = words.slice(0, -1).join(' ');
const headlineTurn = words.at(-1) ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-say">
      <p class="overline" data-enter style="--enter-step:0">Logo &amp; Brand Identity Studio</p>
      <h1 id="hero-heading" class="hero-title" data-enter style="--enter-step:1">
        {headlineLead}{' '}<span class="accent-text">{headlineTurn}</span>
      </h1>

      <p class="hero-lede" data-enter style="--enter-step:2">{SITE.lede}</p>

      <div class="hero-actions" data-enter style="--enter-step:3">
        <a
          class="button button--primary button--lg"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Start on Fiverr <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--outline button--lg" href="#work"
          >View the work <span aria-hidden="true">↓</span></a
        >
      </div>

      {
        /* A spec block, the way a studio annotates a plate: the numbers that
          answer "are these people real?" before the visitor scrolls. Both
          counts are computed from what is actually published. */
      }
    </div>

    {/* The work itself, in the first screen, before anyone has to scroll */}
    <div class="hero-show" data-enter style="--enter-step:2">
      <CoverMarquee projects={projects} />
    </div>

    {
      /* A sibling of the words rather than the last thing inside them.
        
        Inside `.hero-say` this sat between the buttons and the covers, and on
        a phone — where the hero is one column — that put ~180px of counts in
        front of the only work on the screen. Below the covers it costs the
        fold nothing and still reads before the first scroll ends. */
    }
    <dl class="hero-facts" data-enter style="--enter-step:4">
      {
        facts.map((f) => (
          <div class="hero-fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ServiceNav />

  {
    /* The portfolio, split by what a buyer came to buy — two examples each,
      then out to the service page for the rest. */
  }
  <div id="work">
    {
      sections.map(({ category, direct, viaExtras, projects: items }, i) => (
        <ServicePreview
          category={category}
          projects={items}
          directCount={direct.length}
          viaExtrasCount={viaExtras.length}
          count={PREVIEW_COUNT}
          lead={i === 0}
        />
      ))
    }

    {
      /* The rest of the range, in one row.
 
        Said rather than dropped: a visitor scanning what the studio does
        should see all five services whether or not each has a case study.
        Said once, though, and after the work — a band per empty service put
        the two things with nothing to show between the two things that did. */
    }
    {
      alsoOffered.length > 0 && (
        <section class="also" aria-labelledby="also-heading">
          <div class="container">
            <p class="overline" id="also-heading" data-reveal>
              Also offered
            </p>
            <ul class="also-list" role="list" data-reveal>
              {alsoOffered.map((c) => (
                <li>
                  <a class="also-link" href={`/${c.id}/`} data-astro-prefetch>
                    {c.title} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="also-note" data-reveal>
              Delivered, with no standalone case study on the site yet. Each page says exactly what
              it includes.
            </p>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* The range, stated once and quietly. Matches the service page's own
     "Other services" row rather than inventing a second treatment for the
     same idea. */
  .also {
    padding-block: var(--space-2xl);
    border-block-start: 1px solid var(--color-line);
  }

  .also-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    list-style: none;
    padding: 0;
    margin-block: var(--space-sm) 0;
  }

  .also-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--control-h);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .also-link:hover {
      color: var(--color-ink);
    }
  }

  .also-note {
    margin-block-start: var(--space-2xs);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-mute);
  }

  /* Two columns: what the studio says on the left, what it has made on the
     right. Below 1100px the marquee drops under the words rather than
     squeezing both into half a phone. */
  .hero {
    display: grid;
    /* Tighter than --space-2xl below the two-column breakpoint: 88px of air
       between the words and the covers is 88px of fold spent on nothing. */
    gap: var(--space-lg);
    grid-template-areas: 'say' 'show' 'facts';
    align-items: center;
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .hero-say {
    grid-area: say;
  }
  .hero-show {
    grid-area: show;
  }
  .hero-facts {
    grid-area: facts;
  }

  @media (min-width: 1100px) {
    .hero {
      /* The work takes the larger half — barely. It was the smaller one AND
         split in two, so a cover came out at 260px: narrower than the phone
         this same page is read on. Most of the gain is in dropping to one
         lane, so the split only has to stop working against it; pushed
         further, the headline fell to four lines in a 369px column at 1100px
         and the words started paying for the pictures. */
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-areas: 'say show' 'facts show';
      align-items: center;
      gap: var(--space-3xl);
    }

    /* The words centre against the covers; the covers fill the hero. Left at
       `center` the lane sat 414px tall in the middle of a 1038px row with a
       third of the first screen empty above it. */
    .hero-show {
      align-self: stretch;
      position: relative;
      min-block-size: clamp(26rem, 58vh, 40rem);
    }
  }

  /* Sized for half a screen, not a full one: at --text-display this ran to
     five lines and pushed the lede below the fold. */
  .hero-title {
    font-size: clamp(2.75rem, 1.6rem + 4vw, 5rem);
    letter-spacing: var(--tracking-display);
    line-height: 0.96;
    margin-block: var(--space-xs) var(--space-lg);
    max-width: 15ch;
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  @media (max-width: 419px) {
    .hero-actions {
      display: grid;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--color-line);
  }

  .hero-fact dt {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
</style>
