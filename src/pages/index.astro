---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FilterBar from '@/components/FilterBar.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { SITE } from '@/config/site';
import { getSortedProjects, countByCategory, industriesByCategory } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const counts = countByCategory(projects);
const industries = industriesByCategory(projects);
// Distinct industries across the whole portfolio, for the hero spec block.
const industryCount = new Set(projects.map((p) => p.data.industry).filter(Boolean)).size;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container">
    <p class="overline" data-enter style="--enter-step:0">Logo &amp; Brand Identity Studio</p>
    <h1 class="hero-title" data-enter style="--enter-step:1">
      Where your brand meets<br />creative ideas<span class="accent-dot">.</span>
    </h1>
    <div class="hero-body" data-enter style="--enter-step:2">
      <p class="hero-lede">
        Your brand deserves more than a logo. We design identities that stand out, get remembered,
        and win you customers.
      </p>
      {
        /* A spec block, the way a studio annotates a plate: the numbers that
          answer "are these people real?" before the visitor scrolls. */
      }
      <dl class="hero-facts">
        <div class="hero-fact">
          <dt>Projects</dt>
          <dd>{String(projects.length).padStart(2, '0')}</dd>
        </div>
        <div class="hero-fact">
          <dt>Industries</dt>
          <dd>{String(industryCount).padStart(2, '0')}</dd>
        </div>
        <div class="hero-fact">
          <dt>Delivery</dt>
          <dd>Fiverr</dd>
        </div>
      </dl>
    </div>
    <div class="hero-actions" data-enter style="--enter-step:3">
      <a
        class="button button--primary"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hire on Fiverr <span aria-hidden="true">↗</span>
      </a>
      <a class="button button--outline" href="#work"
        >View the work <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>

  <section id="work" class="work-section" aria-label="Portfolio">
    <FilterBar
      counts={counts}
      total={projects.length}
      industries={industries}
      active="logo-design"
      enhanced
    />
    <div class="container work-container">
      <WorkGrid
        projects={projects}
        eagerCount={2}
        filterable
        heading="Selected work"
        initialCategory="logo-design"
      />
    </div>
  </section>

  <section class="container process" aria-labelledby="process-heading">
    <p class="overline">Our process</p>
    <h2 id="process-heading" class="process-title">
      With you from start to finish<span class="accent-dot">.</span>
    </h2>
    <p class="process-lede">Four steps, one goal. Your vision, exactly how you pictured it.</p>
    {
      /* Ledger rows, not feature cards: each step is a full-width rule with
        the numeral in the margin — reads as a printed index, and stays
        legible at one column on a phone instead of shrinking to four. */
    }
    <ol class="process-steps" role="list">
      {
        [
          ['Listen', 'It starts with your story. Your goals, your audience, your taste.'],
          ['Conceptualize', 'Rough ideas become real directions for your brand.'],
          ['Create', 'The strongest idea gets crafted into clean, polished visuals.'],
          ['Refine', 'We fine-tune with you until it feels exactly right.'],
        ].map(([name, text], i) => (
          <li class="process-step">
            <span class="process-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="process-step-title">{name}</h3>
            <p class="process-step-text">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  /* Tighter than a marketing hero on purpose: this is a portfolio, so the
     first row of work should be reachable in one short scroll, not two. */
  .hero {
    padding-block: var(--space-2xl) var(--space-2xl);
  }

  .hero-title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-2xs) var(--space-lg);
  }

  /* Lede left, spec block right — asymmetric, and it puts proof beside the
     claim instead of under it. */
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) auto;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .hero-facts {
    display: flex;
    gap: var(--space-lg);
    margin: 0;
    padding-block-start: var(--space-3xs);
  }

  .hero-fact dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 899px) {
    .hero-body {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .work-container {
    padding-block-start: var(--space-xl);
  }

  .process {
    margin-block-start: var(--space-3xl);
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--space-2xl);
  }

  .process-title {
    font-size: var(--text-3xl);
    margin-block: var(--space-3xs) var(--space-md);
  }

  .process-lede {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .process-steps {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
    border-block-start: 1px solid var(--color-line);
  }

  /* Numeral in the margin, name in the second column, description in the
     third — an index, not a card. The row rule does the separating work, so
     nothing needs a box. */
  .process-step {
    display: grid;
    grid-template-columns: 4rem minmax(9rem, 14rem) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-line);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) {
    .process-step:hover {
      background: var(--color-paper-raised);
    }
  }

  .process-num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    letter-spacing: var(--tracking-wide);
  }

  .process-step-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .process-step-text {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  @media (max-width: 719px) {
    .process-step {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-2xs) var(--space-sm);
      padding-block: var(--space-sm);
    }

    .process-step-text {
      grid-column: 2;
      font-size: var(--text-sm);
    }
  }
</style>
