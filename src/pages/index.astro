---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedStrip from '@/components/FeaturedStrip.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import ServicesIndex from '@/components/ServicesIndex.astro';
import TrustSection from '@/components/TrustSection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import BriefSection from '@/components/BriefSection.astro';
import { SITE } from '@/config/site';
import { getSortedProjects, featuredProjects, countByCategory, industriesOf } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const counts = countByCategory(projects);
const industries = industriesOf(projects);

// The opening three, and then everything else — no cover appears twice on
// the page, which is what stops a small portfolio from looking padded.
const featured = featuredProjects(projects, 3);
const featuredIds = new Set(featured.map((p) => p.id));
const rest = projects.filter((p) => !featuredIds.has(p.id)).slice(0, 6);

// Only counts that are true by construction. Nothing here is a claim that
// needs backing up — they are literally the length of what is on the site.
const facts = [
  { label: 'Projects published', value: String(projects.length).padStart(2, '0') },
  { label: 'Industries served', value: String(industries.length).padStart(2, '0') },
  { label: 'Ordered through', value: 'Fiverr' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="hero-heading">
    <p class="overline" data-enter style="--enter-step:0">Logo &amp; Brand Identity Studio</p>
    <h1 id="hero-heading" class="hero-title" data-enter style="--enter-step:1">
      {SITE.headline}
    </h1>

    <div class="hero-body">
      <div class="hero-pitch" data-enter style="--enter-step:2">
        <p class="hero-lede">{SITE.lede}</p>
        <div class="hero-actions">
          <a
            class="button button--primary button--lg"
            href={SITE.fiverrUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Start on Fiverr <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--outline button--lg" href="#selected-work"
            >Explore selected work <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>

      {
        /* A spec block, the way a studio annotates a plate: the numbers that
          answer "are these people real?" before the visitor scrolls. Both
          counts are computed from what is actually published. */
      }
      <dl class="hero-facts" data-enter style="--enter-step:3">
        {
          facts.map((f) => (
            <div class="hero-fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container featured" aria-label="Featured projects">
        <FeaturedStrip projects={featured} />
      </section>
    )
  }

  <section id="selected-work" class="section section--ruled" aria-labelledby="selected-heading">
    <div class="container">
      <div class="section-head work-head">
        <div>
          <p class="overline">Selected work</p>
          <h2 id="selected-heading" class="section-title">
            Identity systems, start to finish<span class="accent-dot">.</span>
          </h2>
        </div>
        <a class="link-arrow work-head-link" href="/work/" data-astro-prefetch>
          View all {projects.length} projects
        </a>
      </div>

      {
        rest.length > 0 ? (
          <div class="work-body">
            <WorkGrid projects={rest} heading="Selected work" eagerCount={0} rhythm="editorial" />
          </div>
        ) : (
          <p class="work-none">
            More work is being prepared. In the meantime,{' '}
            <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer">
              ask about a project on Fiverr <span aria-hidden="true">↗</span>
            </a>
            .
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-head">
        <p class="overline">Services</p>
        <h2 id="services-heading" class="section-title">
          What you can commission<span class="accent-dot">.</span>
        </h2>
        <p class="section-lede">
          Start with a mark, or take the whole system. Every service page lists exactly what lands
          in your hands.
        </p>
      </div>
      <ServicesIndex counts={counts} />
    </div>
  </section>

  <TrustSection facts={facts.slice(0, 2)} />

  <section class="section section--ruled" aria-labelledby="process-heading">
    <div class="container">
      <ProcessSection />
      <p class="process-more">
        <a class="link-arrow" href="/process/" data-astro-prefetch>
          See the full process, stage by stage
        </a>
      </p>
    </div>
  </section>

  <BriefSection />
</BaseLayout>

<style>
  /* Tighter than a marketing hero on purpose: this is a portfolio, so the
     first real work should be reachable in one short scroll, not two. */
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .hero-title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-xs) var(--space-xl);
    /* Long enough to say something, short enough to break in two lines */
    max-width: 16ch;
  }

  /* Pitch left, spec block right — asymmetric, and it puts the proof beside
     the claim instead of underneath it. */
  .hero-body {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero-body {
      grid-template-columns: minmax(0, var(--measure)) auto;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  @media (max-width: 419px) {
    .hero-actions {
      display: grid;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero-facts {
      display: grid;
      gap: var(--space-md);
      padding-inline-start: var(--space-lg);
      border-inline-start: 1px solid var(--color-line);
    }
  }

  .hero-fact dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }

  .featured {
    padding-block-end: var(--space-xl);
  }

  /* Heading left, escape hatch right — the "see everything" affordance sits
     on the same line as the promise it qualifies. */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md);
    max-width: none;
  }

  .work-head-link {
    white-space: nowrap;
  }

  .work-body {
    margin-block-start: var(--space-2xl);
  }

  .work-none {
    margin-block-start: var(--space-xl);
    color: var(--color-ink-soft);
  }

  .work-none a {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
    text-decoration-color: var(--color-accent);
  }

  .process-more {
    margin-block-start: var(--space-lg);
  }
</style>
