---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategorySection from '@/components/CategorySection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import BriefSection from '@/components/BriefSection.astro';
import { SITE } from '@/config/site';
import { ACTIVE_CATEGORIES } from '@/data/categories';
import { getSortedProjects, industriesOf } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const industries = industriesOf(projects);

// One section per service, in the order services are listed in
// src/data/categories.json. A service with nothing published still gets its
// row — it just says so instead of showing an empty grid.
const sections = ACTIVE_CATEGORIES.map((category) => ({
  category,
  projects: projects.filter((p) => p.data.category === category.id),
}));

// The first card on the page is the mobile LCP: it loads eagerly and paints
// instead of scroll-revealing.
const firstWithWork = sections.findIndex((s) => s.projects.length > 0);

// Only counts that are true by construction. Nothing here is a claim that
// needs backing up — they are literally the length of what is on the site.
const facts = [
  { label: 'Projects published', value: String(projects.length).padStart(2, '0') },
  { label: 'Industries served', value: String(industries.length).padStart(2, '0') },
  { label: 'Ordered through', value: 'Fiverr' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="hero-heading">
    <p class="overline" data-enter style="--enter-step:0">Logo &amp; Brand Identity Studio</p>
    <h1 id="hero-heading" class="hero-title" data-enter style="--enter-step:1">
      {SITE.headline}
    </h1>

    <div class="hero-body">
      <div class="hero-pitch" data-enter style="--enter-step:2">
        <p class="hero-lede">{SITE.lede}</p>
        <div class="hero-actions">
          <a
            class="button button--primary button--lg"
            href={SITE.fiverrUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Start on Fiverr <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--outline button--lg" href="#work"
            >View the work <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>

      {
        /* A spec block, the way a studio annotates a plate: the numbers that
          answer "are these people real?" before the visitor scrolls. Both
          counts are computed from what is actually published. */
      }
      <dl class="hero-facts" data-enter style="--enter-step:3">
        {
          facts.map((f) => (
            <div class="hero-fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    /* The portfolio, split by what a buyer came to buy. Each service owns a
      section, filters its own work, and links to its own page. */
  }
  <div id="work">
    {
      sections.map(({ category, projects: items }, i) => (
        <CategorySection
          category={category}
          projects={items}
          eagerCount={i === firstWithWork ? 2 : 0}
          leadFirst={i === firstWithWork}
        />
      ))
    }
  </div>

  <section class="section section--ruled" aria-labelledby="process-heading">
    <div class="container">
      <ProcessSection />
      <p class="process-more">
        <a class="link-arrow" href="/process/" data-astro-prefetch>
          See the full process, stage by stage
        </a>
      </p>
    </div>
  </section>

  <BriefSection />
</BaseLayout>

<style>
  /* Tighter than a marketing hero on purpose: this is a portfolio, so the
     first real work should be reachable in one short scroll, not two. */
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .hero-title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-xs) var(--space-xl);
    /* Long enough to say something, short enough to break in two lines */
    max-width: 16ch;
  }

  /* Pitch left, spec block right — asymmetric, and it puts the proof beside
     the claim instead of underneath it. */
  .hero-body {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero-body {
      grid-template-columns: minmax(0, var(--measure)) auto;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .hero-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  @media (max-width: 419px) {
    .hero-actions {
      display: grid;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero-facts {
      display: grid;
      gap: var(--space-md);
      padding-inline-start: var(--space-lg);
      border-inline-start: 1px solid var(--color-line);
    }
  }

  .hero-fact dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }

  .process-more {
    margin-block-start: var(--space-lg);
  }
</style>
