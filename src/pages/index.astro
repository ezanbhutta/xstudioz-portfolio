---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FilterBar from '@/components/FilterBar.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { SITE } from '@/config/site';
import { getSortedProjects, countByCategory } from '@/lib/projects';
import { siteGraph } from '@/lib/schema';

const projects = await getSortedProjects();
const counts = countByCategory(projects);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': siteGraph(),
};
---

<BaseLayout
  title={`${SITE.name} | Logo & Brand Identity Design`}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <section class="hero container">
    <p class="overline">Logo & Brand Identity Studio</p>
    <h1 class="hero-title">
      Where your brand meets<br />creative ideas<span class="accent-dot">.</span>
    </h1>
    <p class="page-lede">
      Your brand deserves more than a logo. We design identities that stand out, get remembered, and
      win you customers.
    </p>
    <div class="hero-actions">
      <a
        class="button button--primary"
        href={SITE.fiverrUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hire on Fiverr <span aria-hidden="true">↗</span>
      </a>
      <a class="button button--outline" href="#work"
        >View the work <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>

  <section id="work" class="work-section" aria-label="Portfolio">
    <FilterBar counts={counts} total={projects.length} enhanced />
    <div class="container work-container">
      <WorkGrid projects={projects} eagerCount={2} filterable heading="Selected work" />
    </div>
  </section>

  <section class="container process" aria-labelledby="process-heading">
    <p class="overline">Our process</p>
    <h2 id="process-heading" class="process-title">
      With you from start to finish<span class="accent-dot">.</span>
    </h2>
    <p class="process-lede">Four steps, one goal. Your vision, exactly how you pictured it.</p>
    <ol class="process-steps" role="list">
      <li class="process-step">
        <span class="process-num" aria-hidden="true">01</span>
        <h3 class="process-step-title">Listen</h3>
        <p class="process-step-text">
          It starts with your story. Your goals, your audience, your taste.
        </p>
      </li>
      <li class="process-step">
        <span class="process-num" aria-hidden="true">02</span>
        <h3 class="process-step-title">Conceptualize</h3>
        <p class="process-step-text">Rough ideas become real directions for your brand.</p>
      </li>
      <li class="process-step">
        <span class="process-num" aria-hidden="true">03</span>
        <h3 class="process-step-title">Create</h3>
        <p class="process-step-text">
          The strongest idea gets crafted into clean, polished visuals.
        </p>
      </li>
      <li class="process-step">
        <span class="process-num" aria-hidden="true">04</span>
        <h3 class="process-step-title">Refine</h3>
        <p class="process-step-text">We fine-tune with you until it feels exactly right.</p>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-section) var(--space-3xl);
  }

  .hero-title {
    font-size: var(--text-display);
    margin-block: var(--space-2xs) var(--space-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  .work-container {
    padding-block-start: var(--space-xl);
  }

  .process {
    margin-block-start: var(--space-section);
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--space-3xl);
  }

  .process-title {
    font-size: var(--text-3xl);
    margin-block: var(--space-3xs) var(--space-md);
  }

  .process-lede {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
  }

  /* Ghost numerals — tonal, not chromatic, so no interface element carries
     more color authority than the work above; muted ink keeps them ≥3:1. */
  .process-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    color: var(--color-ink-mute);
    letter-spacing: var(--tracking-tight);
  }

  .process-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: normal;
    margin-block: var(--space-2xs);
  }

  .process-step-text {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 819px) {
    .process-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 479px) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
