---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { PACKAGES } from '@/data/packages';

const description =
  'Three clear ways to work with XStudioz — Starter, Identity and Signature packages with fixed scope, fast delivery and full ownership rights.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${SITE.name} design packages`,
  provider: { '@id': `${SITE.url}/#organization` },
  serviceType: 'Brand identity design',
  url: new URL('/packages/', SITE.url).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Design packages',
    itemListElement: PACKAGES.map((pkg) => ({
      '@type': 'Offer',
      name: pkg.name,
      description: pkg.summary,
    })),
  },
};
---

<BaseLayout title="Packages" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="packages-hero container">
    <p class="overline">Packages</p>
    <h1 class="packages-title">Pick a scope.<br />We craft the rest<span class="accent-dot">.</span></h1>
    <p class="packages-lede">
      Every package is delivered through Fiverr with clear milestones, source
      files and full ownership rights — no surprises, no upsells mid-project.
    </p>
  </section>

  <section class="container" aria-label="Package comparison">
    <ul class="package-grid" role="list">
      {
        PACKAGES.map((pkg) => (
          <li class:list={['package', { 'package--highlight': pkg.highlighted }]}>
            {pkg.highlighted && <p class="package-flag">Most popular</p>}
            <div class="package-head">
              <h2 class="package-name">{pkg.name}</h2>
              <p class="package-summary">{pkg.summary}</p>
              <p class="package-price">{pkg.price}</p>
            </div>
            <dl class="package-meta">
              <div>
                <dt>Delivery</dt>
                <dd>{pkg.delivery}</dd>
              </div>
              <div>
                <dt>Revisions</dt>
                <dd>{pkg.revisions}</dd>
              </div>
            </dl>
            <ul class="package-includes" role="list">
              {pkg.includes.map((item) => (
                <li>
                  <svg
                    class="check"
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8.5 6.5 12 13 4.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a
              class:list={[
                'button',
                'package-cta',
                pkg.highlighted ? 'button--paper' : 'button--primary',
              ]}
              href={pkg.href ?? SITE.fiverrUrl}
              rel="noopener"
            >
              Start {pkg.name} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="packages-note">
      Need something between two tiers? <a href={SITE.fiverrUrl} rel="noopener">Message us on Fiverr</a>
      — we’ll shape a custom offer around your scope.
    </p>
  </section>
</BaseLayout>

<style>
  .packages-hero {
    padding-block: var(--space-2xl) var(--space-2xl);
  }

  .packages-title {
    font-size: var(--text-display);
    margin-block: var(--space-sm) var(--space-md);
  }

  .accent-dot {
    color: var(--color-accent);
  }

  .packages-lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: start;
  }

  .package {
    position: relative;
    display: grid;
    gap: var(--space-md);
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    padding: var(--space-lg);
    background: var(--color-paper-raised);
  }

  .package--highlight {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .package-flag {
    position: absolute;
    top: calc(-1 * var(--space-sm));
    left: var(--space-lg);
    background: var(--color-accent);
    color: var(--color-paper);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-pill);
  }

  .package-name {
    font-size: var(--text-2xl);
    font-weight: 560;
  }

  .package-summary {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    min-height: 2.6em;
  }

  .package--highlight .package-summary {
    color: var(--color-paper-mute);
  }

  .package-price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
    margin-block-start: var(--space-sm);
  }

  .package-meta {
    display: flex;
    gap: var(--space-xl);
    margin: 0;
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-sm);
  }

  .package--highlight .package-meta {
    border-color: rgb(255 255 255 / 15%);
  }

  .package-meta dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .package--highlight .package-meta dt {
    color: var(--color-paper-mute);
  }

  .package-meta dd {
    margin: var(--space-3xs) 0 0;
    font-weight: 540;
  }

  .package-includes {
    display: grid;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }

  .package-includes li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .check {
    flex: none;
    color: var(--color-accent);
    translate: 0 2px;
  }

  .package--highlight .check {
    color: var(--color-accent-bright);
  }

  .package-cta {
    justify-content: center;
  }

  .packages-note {
    margin-block-start: var(--space-xl);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .packages-note a {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 899px) {
    .package-grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
      margin-inline: auto;
    }

    .package--highlight {
      order: -1;
    }
  }
</style>
