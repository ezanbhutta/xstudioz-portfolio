---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { PACKAGES, PROCESS_STEPS } from '@/data/packages';
import { siteGraph, ORGANIZATION_ID } from '@/lib/schema';

const description =
  'Three clear ways to work with XStudioz — Starter, Identity and Signature packages with fixed scope, fast delivery and full ownership rights.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'Service',
      name: `${SITE.name} design packages`,
      provider: { '@id': ORGANIZATION_ID },
      serviceType: 'Brand identity design',
      url: new URL('/packages/', SITE.url).href,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Design packages',
        itemListElement: PACKAGES.map((pkg) => ({
          '@type': 'Offer',
          name: pkg.name,
          description: pkg.summary,
        })),
      },
    },
  ],
};
---

<BaseLayout title="Packages" description={description} jsonLd={jsonLd}>
  <section class="page-hero container">
    <p class="overline">Packages</p>
    <h1 class="page-title">
      Pick a scope.<br />We craft the rest<span class="accent-dot">.</span>
    </h1>
    <p class="page-lede">
      Every package is delivered through Fiverr with clear milestones, source files and full
      ownership rights — no surprises, no upsells mid-project.
    </p>
  </section>

  <section class="container" aria-label="Package comparison">
    <ul class="package-grid" role="list">
      {
        PACKAGES.map((pkg) => (
          <li id={pkg.id} class:list={['package', { 'package--highlight': pkg.highlighted }]}>
            {pkg.highlighted && <p class="package-flag">Most popular</p>}
            <div class="package-head">
              <h2 class="package-name">{pkg.name}</h2>
              <p class="package-summary">{pkg.summary}</p>
              <p class="package-price">{pkg.price}</p>
            </div>
            <dl class="package-meta">
              <div>
                <dt>Delivery</dt>
                <dd>{pkg.delivery}</dd>
              </div>
              <div>
                <dt>Revisions</dt>
                <dd>{pkg.revisions}</dd>
              </div>
            </dl>
            <ul class="package-includes" role="list">
              {pkg.includes.map((item) => (
                <li>
                  <svg
                    class="check"
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8.5 6.5 12 13 4.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a
              class:list={[
                'button',
                'package-cta',
                pkg.highlighted ? 'button--paper' : 'button--primary',
              ]}
              href={pkg.href ?? SITE.fiverrUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Start {pkg.name} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="packages-note">
      Final scope and price are agreed in the Fiverr order before work starts — “from” covers extras
      like rush delivery or additional concepts, never mid-project surprises. Need something between
      two tiers?
      <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer"
        >Message us on Fiverr <span aria-hidden="true">↗</span></a
      > and we’ll shape a custom offer.
    </p>
  </section>

  <section class="container process" aria-labelledby="process-heading">
    <p class="overline">How it works</p>
    <h2 id="process-heading" class="process-title">
      Four steps, no drama<span class="accent-dot">.</span>
    </h2>
    <ol class="process-steps" role="list">
      {
        PROCESS_STEPS.map((step, i) => (
          <li class="process-step">
            <span class="process-num" aria-hidden="true">
              0{i + 1}
            </span>
            <h3 class="process-step-title">{step.title}</h3>
            <p class="process-step-text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .package {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-md);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    background: var(--color-paper-raised);
    scroll-margin-block-start: var(--space-lg);
  }

  .package--highlight {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .package-flag {
    position: absolute;
    top: calc(-1 * var(--space-sm));
    left: var(--space-lg);
    background: var(--color-accent);
    color: var(--color-paper);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-pill);
  }

  .package-name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
  }

  .package-summary {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .package--highlight .package-summary {
    color: var(--color-paper-mute);
  }

  .package-price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-wordmark);
    letter-spacing: var(--tracking-tight);
    margin-block-start: var(--space-sm);
  }

  .package-meta {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(var(--space-sm), 4vw, var(--space-xl));
    margin: 0;
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-sm);
  }

  .package--highlight .package-meta {
    border-color: var(--color-line-on-ink);
  }

  .package-meta dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .package--highlight .package-meta dt {
    color: var(--color-paper-mute);
  }

  .package-meta dd {
    margin: var(--space-3xs) 0 0;
    font-weight: var(--weight-medium);
  }

  .package-includes {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }

  .package-includes li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .check {
    flex: none;
    color: var(--color-accent);
    translate: 0 2px;
  }

  .package--highlight .check {
    color: var(--color-accent-bright);
  }

  .package-cta {
    justify-content: center;
  }

  .packages-note {
    margin-block-start: var(--space-xl);
    color: var(--color-ink-soft);
    max-width: var(--measure-wide);
  }

  .packages-note a {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }

  .process {
    margin-block-start: var(--space-section);
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--space-3xl);
  }

  .process-title {
    font-size: var(--text-3xl);
    margin-block: var(--space-sm) var(--space-lg);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }

  .process-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    color: var(--color-accent);
    letter-spacing: var(--tracking-tight);
  }

  .process-step-title {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: normal;
    margin-block: var(--space-2xs);
  }

  .process-step-text {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  /* The 3-up grid's min-content exceeds the container below ~930px */
  @media (max-width: 929px) {
    .package-grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 819px) {
    .process-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 479px) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
