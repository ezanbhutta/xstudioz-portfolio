---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import BriefSection from '@/components/BriefSection.astro';
import { SITE } from '@/config/site';
import { STUDIO } from '@/data/studio';
import { siteGraph, ORGANIZATION_ID, WEBSITE_ID } from '@/lib/schema';

/**
 * The confidence page. Its whole job is to remove the two fears a first-time
 * client actually has: "will I get what I asked for?" and "what happens if I
 * don't like it?" — answered by naming who owns what at every stage.
 */
const description = `How a project runs at ${SITE.name}: what you provide, what is delivered at each stage, how feedback works, and how everything is handled through Fiverr.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'HowTo',
      name: `Working with ${SITE.name}`,
      description,
      url: new URL('/process/', SITE.url).href,
      step: STUDIO.process.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.summary,
      })),
    },
    {
      '@type': 'WebPage',
      name: `Process | ${SITE.name}`,
      description,
      url: new URL('/process/', SITE.url).href,
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': ORGANIZATION_ID },
    },
  ],
};
---

<BaseLayout title="Process" description={description} jsonLd={jsonLd}>
  <section class="container page-hero">
    <p class="overline">Process</p>
    <h1 class="page-title">No surprises, either way<span class="accent-dot">.</span></h1>
    <p class="page-lede">
      Most design projects go wrong for the same reason: nobody said out loud who was responsible
      for what. Here is the whole engagement, stage by stage, on both sides of the table.
    </p>
  </section>

  <section class="section section--tight section--ruled" aria-labelledby="process-heading">
    <div class="container">
      <ProcessSection detail headingId="process-heading" />
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="platform-heading">
    <div class="container platform">
      <div class="section-head">
        <p class="overline">How it runs</p>
        <h2 id="platform-heading" class="section-title">
          Everything happens on Fiverr<span class="accent-dot">.</span>
        </h2>
        <p class="section-lede">
          Not a preference — a protection. The order, the messages, the previews, the revisions and
          the final files all live in one place that neither of us controls.
        </p>
      </div>

      <ul class="platform-list" role="list">
        <li class="platform-item">
          <h3 class="platform-title">One thread, start to finish</h3>
          <p class="platform-text">
            Brief, questions, drafts, feedback and delivery stay in the same conversation. Nothing
            is scattered across email, and nothing gets lost when a project pauses.
          </p>
        </li>
        <li class="platform-item">
          <h3 class="platform-title">Payment you don't hand over blind</h3>
          <p class="platform-text">
            Fiverr holds the payment through its own order system and releases it on delivery. That
            is their process, not mine — which is exactly the point.
          </p>
        </li>
        <li class="platform-item">
          <h3 class="platform-title">A written record of the scope</h3>
          <p class="platform-text">
            What was agreed is on the order. If a request lands outside it, you will be told before
            work starts rather than billed after.
          </p>
        </li>
        <li class="platform-item">
          <h3 class="platform-title">Revisions inside the order</h3>
          <p class="platform-text">
            Feedback goes through the same thread, so every round is tied to the work it changed
            and neither of us is reconstructing a decision from memory.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <BriefSection headingId="process-brief-heading" />
</BaseLayout>

<style>
  .platform {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 1000px) {
    .platform {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }

  .platform-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 620px) {
    .platform-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .platform-item {
    border-block-start: 2px solid var(--color-ink);
    padding-block-start: var(--space-sm);
  }

  .platform-title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-2xs);
  }

  .platform-text {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
</style>
