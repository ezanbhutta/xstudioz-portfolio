---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Lightbox from '@/components/Lightbox.astro';
import BriefSection from '@/components/BriefSection.astro';
import { SITE } from '@/config/site';
import { getCategory } from '@/data/categories';
import {
  getSortedProjects,
  adjacentProjects,
  projectExtras,
  projectDeliverables,
  projectType,
  secondaryType,
  metaDescription,
  curatedPages,
} from '@/lib/projects';
import { siteGraph, ORGANIZATION_ID } from '@/lib/schema';
import { lqipStyle } from '@/lib/lqip';

/**
 * The case study.
 *
 * The shape this replaces was "one paragraph, then thirty-six slides" — a
 * deck dump that made every project the same length and buried the call to
 * action past the fold line of a very long page. Now:
 *
 *   hero → the story (only the parts that have been written) → what was
 *   delivered → six curated pages → the full deck on request → the action
 *
 * Every narrative field is optional and its section is simply absent when
 * empty, so a project with nothing but a summary still produces a clean,
 * complete page rather than a scaffold with holes in it. Nothing here is
 * generated from guesses about a real client's business.
 */
export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const {
  title,
  category,
  summary,
  intent,
  cover,
  coverAlt,
  images,
  industry,
  context,
  challenge,
  direction,
  outcome,
  testimonial,
  highlights,
} = project.data;

const categoryInfo = getCategory(category);
const kind = projectType(project.data);
const extras = projectExtras(project.data);
const deliverables = projectDeliverables(project.data);

// Page 1 is the hero; the curated set is what a visitor sees before the
// call to action. `highlights` in the CMS overrides the automatic spread.
const hero = images[0];
const heroPlaceholder = await lqipStyle(hero.src);
const curatedIndex = new Map(images.map((img, i) => [img, i]));
const curated = await Promise.all(
  curatedPages(images, highlights, 6).map(async (img) => ({
    img,
    at: curatedIndex.get(img) ?? 0,
    placeholder: await lqipStyle(img.src),
  })),
);

// One full-resolution source per page for the viewer, and one thumbnail per
// page for the full-deck drawer. Only the hero and the curated pages are
// rendered at display size inline — that is the whole weight saving, and why
// a 45-page deck now costs about as much to load as a 7-page one.
const viewerPages = await Promise.all(
  images.map(async (img) => {
    const full = await getImage({ src: img.src, width: 1600, format: 'webp' });
    return { src: full.src, alt: img.alt };
  }),
);
const THUMB_W = 400;
const thumbs = await Promise.all(
  images.map(async (img) => {
    const thumb = await getImage({ src: img.src, width: THUMB_W, format: 'webp' });
    return {
      src: thumb.src,
      alt: img.alt,
      width: THUMB_W,
      // Explicit dimensions: a 45-cell thumbnail grid without them is 45
      // layout shifts as the drawer fills in.
      height: Math.round((THUMB_W * img.src.height) / img.src.width),
    };
  }),
);

// Brand links, rendered only when set in the CMS. A social accepts a
// full link or a bare username (the platform base is prepended); a value
// that isn't a real URL is ignored rather than failing the build.
const toUrl = (value: string | undefined, platformBase?: string) => {
  const v = value?.trim().replace(/^@/, '');
  if (!v) return null;
  const href = /^https?:\/\//i.test(v)
    ? v
    : platformBase && !v.includes('.')
      ? `${platformBase}${v}`
      : `https://${v}`;
  try {
    return new URL(href);
  } catch {
    return null;
  }
};
const hostLabel = (url: URL) => url.hostname.replace(/^www\./, '');

const website = toUrl(project.data.website);
const links = [
  website && { label: `Live at ${hostLabel(website)}`, href: website.href },
  ...(
    [
      ['Instagram', project.data.instagram, 'https://instagram.com/'],
      ['Facebook', project.data.facebook, 'https://facebook.com/'],
      ['LinkedIn', project.data.linkedin, 'https://www.linkedin.com/company/'],
    ] as const
  ).map(([label, value, base]) => {
    const url = toUrl(value, base);
    return url && { label, href: url.href };
  }),
  ...(project.data.otherLinks ?? []).map((value) => {
    const url = toUrl(value);
    return url && { label: hostLabel(url), href: url.href };
  }),
].filter((l) => l !== null);

const { prev, next } = adjacentProjects(projects, project.id);

// Only the story fields that were actually written get a row.
const story = [
  ['Context', context],
  ['Challenge', challenge],
  ['Direction', direction],
].filter((row): row is [string, string] => Boolean(row[1]));

const specs = [
  ['Service', categoryInfo.title],
  ['Industry', industry],
  ['Type', kind],
  // A guidelines project is still built around a mark; naming which kind is
  // detail a designer's client notices.
  ['Mark', secondaryType(project.data)],
  ['Pages', `${images.length}`],
].filter((row): row is [string, string] => Boolean(row[1]));

// Social card + structured data use the processed cover, cropped to the
// 1.91:1 ratio large-image cards expect.
const social = await getImage({
  src: cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const socialUrl = new URL(social.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      abstract: intent,
      genre: categoryInfo.title,
      url: new URL(`/work/${project.id}/`, SITE.url).href,
      image: socialUrl,
      creator: { '@id': ORGANIZATION_ID },
      ...(industry ? { about: industry } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Work', item: `${SITE.url}/work/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryInfo.title,
          item: new URL(`/${category}/`, SITE.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};

const heroSizes = '(min-width: 1360px) 1232px, 92vw';
const heroWidths = [720, 1200, 1600];
---

<BaseLayout
  title={`${title} | ${categoryInfo.title}`}
  description={metaDescription(intent, summary)}
  ogImage={socialUrl}
  ogImageAlt={coverAlt || `${title} presentation cover`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="project">
    <header class="container project-header">
      <p class="project-back">
        <a class="back-link" href="/work/" data-back>
          <span class="back-link-arrow" aria-hidden="true">←</span> Back to work
        </a>
      </p>

      <p class="overline">
        <a class="overline-link" href={`/${category}/`} data-astro-prefetch>{categoryInfo.title}</a>
        {
          industry && (
            <span>
              <span aria-hidden="true"> · </span>
              {industry}
            </span>
          )
        }
        {
          kind && (
            <span>
              <span aria-hidden="true"> · </span>
              {kind}
            </span>
          )
        }
      </p>

      <h1 class="project-title">{title}</h1>
      {/* The value proposition, at statement scale, before any image */}
      {intent && <p class="project-intent">{intent}</p>}

      {
        links.length > 0 && (
          <p class="project-links">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        )
      }
    </header>

    {/* Hero: pairs with the grid card's view transition and loads with priority */}
    <div class="container project-hero">
      <button
        type="button"
        class="page-open media"
        data-open-page="0"
        style={`view-transition-name: work-${project.id}`}
        aria-label={`Open the ${title} presentation, page 1 of ${images.length}`}
      >
        <Picture
          src={hero.src}
          alt={hero.alt}
          formats={['webp']}
          fallbackFormat="webp"
          widths={heroWidths}
          sizes={heroSizes}
          loading="eager"
          fetchpriority="high"
          style={heroPlaceholder}
        />
        <span class="page-cue" aria-hidden="true">View full screen</span>
      </button>
    </div>

    <div class="container project-body">
      <div class="project-story">
        <section aria-labelledby="overview-heading">
          <p class="overline overline--bare story-label" id="overview-heading">Overview</p>
          <p class="project-summary">{summary}</p>
        </section>

        {
          story.map(([label, text]) => (
            <section class="story-row" aria-label={label}>
              <p class="overline overline--bare story-label">{label}</p>
              <p class="story-text">{text}</p>
            </section>
          ))
        }

        {
          outcome && (
            <section class="story-row story-row--outcome" aria-label="Outcome">
              <p class="overline overline--bare story-label">Outcome</p>
              <p class="story-text">{outcome}</p>
            </section>
          )
        }

        {
          testimonial?.quote && (
            <figure class="project-quote">
              <blockquote>
                <p>{testimonial.quote}</p>
              </blockquote>
              <figcaption>
                {testimonial.name}
                {testimonial.role && <span class="quote-role">{testimonial.role}</span>}
              </figcaption>
            </figure>
          )
        }
      </div>

      <aside class="project-spec" aria-label="Project details">
        <dl class="spec-table">
          {
            specs.map(([label, value]) => (
              <div class="spec-row">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>

        {
          deliverables.length > 0 && (
            <div class="spec-block">
              <p class="overline overline--bare spec-label">Delivered</p>
              <ul class="spec-list" role="list">
                {deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          extras.length > 0 && deliverables.length === 0 && (
            <p class="spec-tags">
              {extras.map((e) => (
                <span class="tag">{e}</span>
              ))}
            </p>
          )
        }
      </aside>
    </div>

    {
      curated.length > 0 && (
        <section class="container project-gallery" aria-labelledby="gallery-heading">
          <div class="gallery-head">
            <p class="overline">The system</p>
            <h2 id="gallery-heading" class="gallery-title">
              Selected pages<span class="accent-dot">.</span>
            </h2>
          </div>

          <div class="gallery-grid">
            {curated.map(({ img, at, placeholder }) => (
              <figure class="gallery-figure" data-reveal="wipe">
                <button
                  type="button"
                  class="page-open media"
                  data-open-page={at}
                  aria-label={`Open page ${at + 1} of ${images.length} full screen`}
                >
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    formats={['webp']}
                    fallbackFormat="webp"
                    widths={heroWidths}
                    sizes={heroSizes}
                    loading="lazy"
                    style={placeholder}
                  />
                  <span class="page-num" aria-hidden="true">
                    {String(at + 1).padStart(2, '0')}
                  </span>
                  <span class="page-cue" aria-hidden="true">
                    Enlarge
                  </span>
                </button>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      images.length > curated.length + 1 && (
        <section class="container project-deck">
          <details class="deck">
            <summary class="deck-summary">
              <span class="deck-summary-label">Explore the full deck</span>
              <span class="deck-summary-count">
                {images.length} pages <span aria-hidden="true">↓</span>
              </span>
            </summary>
            <ul class="deck-grid" role="list">
              {thumbs.map((thumb, i) => (
                <li>
                  <button
                    type="button"
                    class="deck-thumb media"
                    data-open-page={i}
                    aria-label={`Open page ${i + 1} of ${images.length} full screen`}
                  >
                    <img
                      src={thumb.src}
                      alt={thumb.alt}
                      width={thumb.width}
                      height={thumb.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="deck-thumb-num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </details>
        </section>
      )
    }

    <BriefSection
      title={`Start a ${categoryInfo.navLabel ?? categoryInfo.title} project like this.`}
      lede={`This one began as six lines in a Fiverr message. Send the same six about your business${industry ? ` — even if you are nowhere near ${industry.toLowerCase()}` : ''} — and the reply comes back with a real answer.`}
      headingId="project-brief-heading"
    />

    {
      (prev || next) && (
        <nav class="container project-nav" aria-label="More projects">
          <p class="overline project-nav-label">More work</p>
          <ul class="project-nav-list" role="list">
            {[prev, next]
              .filter((p) => p !== null)
              .map((p) => (
                <li>
                  <a class="project-nav-link" href={`/work/${p.id}/`} data-astro-prefetch>
                    <span class="project-nav-media media">
                      <Picture
                        src={p.data.cover}
                        alt=""
                        formats={['webp']}
                        fallbackFormat="webp"
                        widths={[480, 900]}
                        sizes="(min-width: 760px) 40vw, 92vw"
                        loading="lazy"
                      />
                    </span>
                    <span class="project-nav-title">{p.data.title}</span>
                    {p.data.intent && <span class="project-nav-intent">{p.data.intent}</span>}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      )
    }
  </article>

  <Lightbox pages={viewerPages} title={title} />
</BaseLayout>

<script>
  // Back returns to the exact stage the visitor left — same filters, same
  // scroll offset — by walking real history. Only visitors who arrived from
  // within the site have that history; anyone landing from a shared link or
  // search follows the href to the work index instead.
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey) return;
    if (history.length > 1 && document.referrer.startsWith(location.origin)) {
      event.preventDefault();
      history.back();
    }
  });
</script>

<style>
  .project-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .project-back {
    margin-block-end: var(--space-lg);
  }

  .back-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link-arrow {
    display: inline-block;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--color-accent);
    }

    .back-link:hover .back-link-arrow {
      translate: -0.25em 0;
    }
  }

  .overline-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .overline-link:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }

  .project-title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-2xs) var(--space-md);
  }

  /* The one line that says why this project mattered */
  .project-intent {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: var(--color-accent);
    max-width: 24ch;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .project-links a {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .project-links a:hover {
      color: var(--color-accent);
    }
  }

  /* --- Shared page control ------------------------------------------------ *
     The artwork is the button: a real <button>, so it is keyboard reachable
     and announces what it does, styled as bare artwork.                      */
  .page-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: var(--image-bg);
    border: none;
    cursor: zoom-in;
  }

  .page-open :global(img) {
    width: 100%;
    height: auto;
  }

  .page-num,
  .page-cue {
    position: absolute;
    inset-block-end: var(--space-sm);
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums;
    color: var(--color-paper);
    background: rgb(13 11 16 / 62%);
    backdrop-filter: blur(6px);
  }

  .page-num {
    inset-inline-start: var(--space-sm);
  }

  .page-cue {
    inset-inline-end: var(--space-sm);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .page-open:hover .page-cue {
      opacity: 1;
      transform: none;
    }
  }

  .page-open:focus-visible .page-cue {
    opacity: 1;
    transform: none;
  }

  /* Touch has no hover, so the cue would never appear — show it always */
  @media (hover: none) {
    .page-cue {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Story + spec ------------------------------------------------------- */
  .project-body {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-3xl);
  }

  @media (min-width: 1000px) {
    .project-body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .project-spec {
      position: sticky;
      top: 6rem;
    }
  }

  .project-story {
    display: grid;
    gap: var(--space-xl);
  }

  .story-label {
    color: var(--color-ink-mute);
    margin-block-end: var(--space-2xs);
  }

  .project-summary {
    font-size: var(--text-lg);
    max-width: var(--measure);
  }

  .story-text {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .story-row--outcome .story-text {
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .project-quote {
    margin: 0;
    border-block-start: 2px solid var(--color-ink);
    padding-block-start: var(--space-md);
    max-width: var(--measure);
  }

  .project-quote blockquote p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.4;
    letter-spacing: var(--tracking-tight);
  }

  .project-quote figcaption {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-ink-mute);
  }

  .quote-role::before {
    content: ' — ';
  }

  .spec-table {
    margin: 0;
    border-block-start: 1px solid var(--color-line);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--color-line);
  }

  .spec-row dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-mute);
    padding-block-start: 0.2em;
  }

  .spec-row dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .spec-block {
    margin-block-start: var(--space-lg);
  }

  .spec-label {
    color: var(--color-ink);
    margin-block-end: var(--space-2xs);
  }

  .spec-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }

  /* --- Curated gallery ---------------------------------------------------- */
  .project-gallery {
    padding-block-end: var(--space-3xl);
  }

  .gallery-title {
    font-size: var(--text-2xl);
    margin-block-start: var(--space-2xs);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-gallery);
    margin-block-start: var(--space-xl);
  }

  /* Pairs from the second page on: the first curated page gets the full
     measure, then the rest sit two-up, which keeps a six-page selection
     from reading as another endless scroll. */
  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
    }

    .gallery-figure:first-child {
      grid-column: 1 / -1;
    }
  }

  .gallery-figure {
    margin: 0;
  }

  /* --- The full deck ------------------------------------------------------ */
  .project-deck {
    padding-block-end: var(--space-3xl);
  }

  .deck {
    border-block: 1px solid var(--color-line);
  }

  .deck-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--control-h-lg);
    padding-block: var(--space-sm);
    cursor: pointer;
    list-style: none;
  }

  .deck-summary::-webkit-details-marker {
    display: none;
  }

  .deck-summary-label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
