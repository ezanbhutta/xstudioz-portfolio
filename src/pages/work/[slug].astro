  .gallery-count {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-soft);
  }

  /* One column, one width. The deck is a document: it reads in the order it
     was designed in, and no page is sized to imply it matters more than the
     one after it. */
  .gallery-stack {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }

  /* A chapter break gets more air than a page break, so the structure is
     legible before a word of it is read. */
  .gallery-stack[data-chaptered] {
    gap: var(--space-3xl);
  }

  .chapter {
    display: grid;
    gap: var(--space-xl);
  }

  /* Sticky against the chapter, not the page: the rule holds the top of the
     column for exactly as long as its own pages are on screen, and is pushed
     off by the next one. Its containing block is .chapter, which is why the
     wrapper is a real box rather than display: contents. */
  .chapter-mark {
    position: sticky;
    /* Pinned at the same offset every other anchor on the site lands at, so a
       followed chapter link puts the rule exactly where it will stay. The rem
       of air that offset leaves between the header and this bar is a problem
       an opaque bar creates for itself — deck pages slid through the gap
       between two fixed elements — and ::before below fills it. */
    inset-block-start: var(--sticky-offset);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm);
    margin: 0;
    padding-block: var(--space-2xs);
    /* The stack scrolls under this, so it needs a floor of its own. */
    background: var(--color-paper);
    border-block-end: 1px solid var(--color-line-strong);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* The rem between the header and the pinned bar. Container-width, which is
     exactly as wide as the artwork that would otherwise show through it. */
  .chapter-mark::before {
    content: '';
    position: absolute;
    inset-block-end: 100%;
    inset-inline: 0;
    block-size: calc(var(--sticky-offset) - var(--header-h));
    background: inherit;
  }

  .chapter-span {
    font-weight: var(--weight-medium);
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-ink-mute);
    font-variant-numeric: tabular-nums;
  }

  .chapter-index {
    margin-block-start: var(--space-md);
  }

  .chapter-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-index a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3xs);
    min-height: var(--control-h);
    padding-inline: var(--space-xs);
    padding-block: 0.375rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-line-control);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .chapter-index a:hover {
      box-shadow: inset 0 0 0 1px var(--color-ink);
      color: var(--color-ink);
    }
  }

  .chapter-index-at {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-mute);
  }

  .gallery-figure {
    margin: 0;
  }

  /* Only ever rendered when the icon has a name or a kind to print. */
  .icon-caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-block-start: var(--space-2xs);
  }

  .icon-name {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .icon-kind {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  /* --- More projects ------------------------------------------------------ */
  .project-nav {
    padding-block: var(--space-3xl);
  }

  .project-nav-label {
