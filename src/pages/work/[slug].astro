    color: var(--color-ink);
    max-width: var(--measure-statement);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .project-links a {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .project-links a:hover {
      color: var(--color-accent);
    }
  }

  /* --- Shared page control ------------------------------------------------ *
     The artwork is the button: a real <button>, so it is keyboard reachable
     and announces what it does, styled as bare artwork.                      */
  .page-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: var(--image-bg);
    border: none;
    cursor: zoom-in;
  }

  .page-open :global(img) {
    width: 100%;
    height: auto;
  }

  /**
   * The hero board, whole.
   *
   * Four of the five published covers are portrait brand boards around
   * 1542x2100. At container width that is 1272 across and 1,665 down: three
   * laptop screens to scroll past one image, and the image is a composition —
   * a mark, its mockups and its applications arranged as a single sheet. Read
   * a third at a time it is a series of unrelated crops.
   *
   * So the board is sized to the screen rather than to the column, and the
   * column centres it. A landscape cover is far shorter than the cap and is
   * untouched: `min()` only ever takes the width away from something taller
   * than the viewport allows. Nothing is cropped — the button just stops
   * being 1400px wide when the thing inside it is a poster.
   *
   * The cap leaves the header above it on screen at the same time, which is
   * the point: a title, a promise, and the whole of the work under them.
   */
  @media (min-width: 700px) {
    .project-hero .page-open {
      /* ratio x cap = the width at which the board is exactly `cap` tall. */
      --hero-cap: 78vh;
      width: auto;
      max-width: 100%;
      margin-inline: auto;
    }

    .project-hero .page-open :global(img) {
      max-block-size: var(--hero-cap);
      width: auto;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  .page-num,
  .page-cue {
    position: absolute;
    inset-block-end: var(--space-sm);
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums;
    color: #fff;
    background: rgb(5 5 7 / 78%);
    backdrop-filter: blur(6px);
  }

  .page-num {
    inset-inline-start: var(--space-sm);
  }

  .page-cue {
    inset-inline-end: var(--space-sm);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .page-open:hover .page-cue {
      opacity: 1;
      transform: none;
    }
  }

  .page-open:focus-visible .page-cue {
    opacity: 1;
    transform: none;
  }

  /* Touch has no hover, so the cue would never appear — show it always */
  @media (hover: none) {
    .page-cue {
      opacity: 1;
      transform: none;
    }
  }

  /* --- The cover ---------------------------------------------------------- *
     The hero carried no spacing of its own while it sat between the header and
     the body, which both pad generously. Now that it lands between the body and
     the gallery it has to hold its own bottom edge, or the cover butts straight
     into the "Every page" heading with nothing between them.                  */
  .project-hero {
    /* A <figure> so an icon sheet can carry its caption; figures default to a
       browser margin that would misalign it against every other container.
       
       Block-only, though. This was `margin: 0`, which also zeroed the
       `margin-inline: auto` that `.container` uses to centre itself — so the
       largest plate on the site pinned to the left edge while every other
       container centred. Measured at 1440: left 0px, right 40px, against
       20/20 for its siblings. The gap grows with the viewport, because it is
       (viewport − 1400) / 2: 260px at 1920, 580px at 2560. */
    margin-block: 0;
    margin-inline: auto;
    order: -1;
    padding-block-end: var(--space-2xl);
  }

  /* The figure shrink-wraps its board, so the door under it and the caption
     beside it line up with the artwork instead of with the page. A landscape
     cover is wider than the container and clamps back to it, unchanged. */
  @media (min-width: 700px) {
    .project-hero {
      inline-size: fit-content;
      max-inline-size: 100%;
    }
  }

  /* --- Story + spec ------------------------------------------------------- */
  /* Under the hero, above the reading. `order: -1` puts it with the image in
     the flex column, which is where the button belongs; without it the button
     would fall to the bottom of the article with the closing band. */
  /* Inside the figure, so it starts at the board's left edge rather than the
     container's. On a portrait board those are 432px apart. */
  .project-open {
    margin-block: var(--space-sm) 0;
  }

  .project-close {
    padding-block: var(--space-2xl);
    margin-block-start: var(--space-2xl);
  }

  .project-close-inner {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
  }

  @media (min-width: 860px) {
    .project-close-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xl);
    }
  }

  .project-close-title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
