  @media (min-width: 1000px) {
    .project-lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-3xl);
    }
  }

  .project-lead-detail {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .project-header {
    order: -2;
    /* Tighter, because the image now follows it rather than 800px of copy. */
    padding-block: var(--space-xl) var(--space-md);
  }

  .project-back {
    margin-block-end: var(--space-lg);
  }

  /* On a phone the masthead is one column, so every line of chrome above the
     title is a line between the visitor and the work. 56px of padding and
     36px between a back link and a breadcrumb is desktop generosity; here it
     is 60px of the fold spent on two pieces of navigation. */
  @media (max-width: 599px) {
    .project-header {
      padding-block-start: var(--space-md);
    }

    .project-back {
      margin-block-end: var(--space-sm);
    }

    .project-lead {
      gap: var(--space-sm);
    }
  }

  .back-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link-arrow {
    display: inline-block;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--color-accent);
    }

    .back-link:hover .back-link-arrow {
      translate: -0.25em 0;
    }
  }

  .overline-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
