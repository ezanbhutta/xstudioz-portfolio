---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Lightbox from '@/components/Lightbox.astro';
import { SITE } from '@/config/site';
import { getCategory } from '@/data/categories';
import {
  getSortedProjects,
  adjacentProjects,
  projectExtras,
  projectDeliverables,
  projectType,
  secondaryType,
  metaDescription,
} from '@/lib/projects';
import { siteGraph, ORGANIZATION_ID } from '@/lib/schema';
import { lqipStyle } from '@/lib/lqip';

/**
 * The case study.
 *
 *   the story (only the parts that have been written) → what was delivered →
 *   the deck: cover at size, then every page, one width, in order → the action
 *
 * The overview reads before the first page of the deck, everywhere. A visitor
 * who has scrolled past the title has not yet been told what they are looking
 * at, and a 34-page brand book is a poor way to find out. Saying it first also
 * leaves the deck contiguous — cover, then every page — instead of splitting
 * page 1 from pages 2 onward with a column of text.
 *
 * Every narrative field is optional and its section is simply absent when
 * empty, so a project with nothing but a summary still produces a clean,
 * complete page rather than a scaffold with holes in it. Nothing here is
 * generated from guesses about a real client's business.
 */
// Server-rendered per request: the slug comes from the URL and the project is
// looked up live, so a case study edited in the admin is correct on refresh.
// An unknown slug is a real 404 rather than a page that renders empty.
const projects = await getSortedProjects();
const project = projects.find((p) => p.id === Astro.params.slug);

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const {
  title,
  category,
  summary,
  intent,
  cover,
  coverAlt,
  images,
  industry,
  context,
  challenge,
  direction,
  outcome,
  testimonial,
} = project.data;

const categoryInfo = getCategory(category);
/**
 * A set of icons is not a document.
 *
 * The images arrive identically — one PDF — but a sheet is not a page of an
 * argument. Each one holds many marks composed together, grouped by industry
 * or by kind, and the project is one or a few of them rather than a document
 * read in order.
 *
 * So the sheets are still shown at full width, because twenty icons on one
 * sheet are only legible at full width — laying them out as a grid of
 * thumbnails would shrink the very thing the page exists to show. What
 * changes is what the section is called, that a sheet can say which group it
 * holds, and that page numbers are dropped: they number an argument, and
 * there isn't one.
 */
const isIconSet = project.data.layout === 'icons';
const kind = projectType(project.data);
const extras = projectExtras(project.data);
const deliverables = projectDeliverables(project.data);

/**
 * Every page, at one size, in order.
 *
 * This used to show a curated handful inline and hide the rest behind a
 * drawer. For a brand guidelines deck that is the wrong trade: the document
 * IS the deliverable, and a buyer deciding whether to hire a studio wants to
 * read it, not a summary of it. Page 1 leads as the hero (it is also the
 * view-transition target the grid morphs into); pages 2 onward follow at a
 * single width, in sequence, nothing skipped.
 *
 * Two widths rather than three keeps the build honest: 228 pages across the
 * portfolio at three widths each is where the host's builder ran out of
 * memory before.
 */
const hero = images[0];
const heroPlaceholder = await lqipStyle(hero.src);
const pages = await Promise.all(
  images.slice(1).map(async (img, i) => ({
    img,
    // +1 because page 1 is the hero, so this list starts at index 1.
    at: i + 1,
    placeholder: await lqipStyle(img.src),
  })),
);

/**
 * Chapters, from the labels typed against the pages themselves.
 *
 * A forty-five page deck is 38,000 pixels of one column. Every page is worth
 * showing — the document is the deliverable — but a reader arriving two thirds
 * of the way down has no idea whether they are looking at colour, typography
 * or stationery, and no way to get to the part they came for. The count above
 * the stack said "45 pages, in order", which is true and useless.
 *
 * Only the person who made the deck knows where its sections begin, so this is
 * not inferred. A deck page carrying a label opens the chapter it names —
 * the same `label` column an icon set uses for a mark's own name, because it
 * is the same fact: this image has a name of its own. Page one is the hero and
 * sits above the stack, so its label names the run that leads up to the first
 * mark rather than printing a rule at the top of a section that has not
 * started yet.
 *
 * Two named chapters is the floor. One rule two thirds down a deck, with
 * nothing before it and nothing after, is not a structure — it is a deck
 * somebody started labelling and stopped, and drawing it would say the
 * document has one section that begins in the middle.
 */
type Chapter = { title: string | null; id: string; first: number; pages: typeof pages };

const chapters: Chapter[] = [];
const usedIds = new Set<string>();
const chapterId = (title: string, at: number) => {
  const base =
    title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'chapter';
  // Two chapters called "Applications" would otherwise share one id, and both
  // links in the index would go to the first.
  return usedIds.has(base) ? `${base}-${at}` : (usedIds.add(base), base);
};

if (!isIconSet) {
  // The hero's own label opens the leading chapter; without one it is an
  // untitled run and prints no rule.
  const opening = hero.label?.trim();
  chapters.push({
    title: opening || null,
    id: opening ? chapterId(opening, 0) : '',
    first: 0,
    pages: [],
  });

  for (const page of pages) {
    const title = page.img.label?.trim();
    if (title) {
      chapters.push({ title, id: chapterId(title, page.at), first: page.at, pages: [page] });
    } else {
      chapters[chapters.length - 1].pages.push(page);
    }
  }

  // A leading run with no pages and no title is not a chapter — it happens
  // whenever page two opens the first named one.
  if (chapters[0].pages.length === 0 && !chapters[0].title) chapters.shift();
}

const namedChapters = chapters.filter((c) => c.title);
const isChaptered = namedChapters.length >= 2;

/**
 * The stored path already points at the widest WebP that was written, so the
 * full-screen viewer uses it directly rather than asking the build for one.
 *
 * The chapter rides along. Full screen is where a reader is most lost — the
 * page is all artwork and the only orientation is "23 / 45" — and it is the
 * one place the rules drawn down the page are not visible.
 */
const chapterAt: (string | null)[] = images.map(() => null);
if (isChaptered) {
  for (const chapter of chapters) {
    if (!chapter.title) continue;
    for (const page of chapter.pages) chapterAt[page.at] = chapter.title;
    if (chapter.first === 0) chapterAt[0] = chapter.title;
  }
}
const viewerPages = images.map((img, i) => ({
  src: img.src,
  alt: img.alt,
  ...(chapterAt[i] ? { chapter: chapterAt[i]! } : {}),
}));

// Brand links, rendered only when set in the CMS. A social accepts a
// full link or a bare username (the platform base is prepended); a value
// that isn't a real URL is ignored rather than failing the build.
const toUrl = (value: string | undefined, platformBase?: string) => {
  const v = value?.trim().replace(/^@/, '');
  if (!v) return null;
  const href = /^https?:\/\//i.test(v)
    ? v
    : platformBase && !v.includes('.')
      ? `${platformBase}${v}`
      : `https://${v}`;
  try {
    return new URL(href);
  } catch {
    return null;
  }
};
const hostLabel = (url: URL) => url.hostname.replace(/^www\./, '');

const website = toUrl(project.data.website);
const links = [
  website && { label: `Live at ${hostLabel(website)}`, href: website.href },
  ...(
    [
      ['Instagram', project.data.instagram, 'https://instagram.com/'],
      ['Facebook', project.data.facebook, 'https://facebook.com/'],
      ['LinkedIn', project.data.linkedin, 'https://www.linkedin.com/company/'],
    ] as const
  ).map(([label, value, base]) => {
    const url = toUrl(value, base);
    return url && { label, href: url.href };
  }),
  ...(project.data.otherLinks ?? []).map((value) => {
    const url = toUrl(value);
    return url && { label: hostLabel(url), href: url.href };
  }),
].filter((l) => l !== null);

const { prev, next } = adjacentProjects(projects, project.id);

// Only the story fields that were actually written get a row.
const story = [
  ['Context', context],
  ['Challenge', challenge],
  ['Direction', direction],
].filter((row): row is [string, string] => Boolean(row[1]));

const specs = [
  ['Service', categoryInfo.title],
  ['Industry', industry],
  ['Type', kind],
  // A guidelines project is still built around a mark; naming which kind is
  // detail a designer's client notices.
  ['Mark', secondaryType(project.data)],
  /**
   * Only when there is more than one.
   *
   * "Pages 1" is the spec table volunteering that this case study contains a
   * single image — the weakest line it could end on, and the line four of the
   * five published projects ended on. A count is worth printing when it says
   * "there is a lot to read"; at one it says the opposite, and the visitor can
   * already see the one image above it.
   */
  images.length > 1 ? [isIconSet ? 'Sheets' : 'Pages', `${images.length}`] : null,
].filter((row): row is [string, string] => Boolean(row && row[1]));

// Social card and structured data point at the cover. It is already served at
// a known size, so there is nothing to derive — an absolute URL is all the
// crawlers need, and they crop to their own ratio anyway.
//
// Its size is passed to the layout rather than left to the default. That
// default is 1200×630, which is true of /og.png and of nothing else, so every
// case study was declaring dimensions its image did not have — 1200×630
// against files that are 1600×900, 1517×900 or 1600×1077. A scraper that
// trusts the declaration instead of measuring the file lays the card out
// wrongly.
const socialUrl = new URL(cover.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      abstract: intent,
      genre: categoryInfo.title,
      url: new URL(`/work/${project.id}/`, SITE.url).href,
      image: socialUrl,
      creator: { '@id': ORGANIZATION_ID },
      ...(industry ? { about: industry } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        // The site root, not /work/. There is no All Work index — the site was
        // trimmed to the portfolio itself — so this pointed at a 404 on all
        // eight case studies, which is a breadcrumb error Search Console
        // reports. Category pages already root their trail here.
        { '@type': 'ListItem', position: 1, name: SITE.name, item: `${SITE.url}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryInfo.title,
          item: new URL(`/${category}/`, SITE.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};

// The responsive widths are no longer declared here: each image carries its
// own srcset, built from the variants actually written to disk at upload, so
// the page can never advertise a width that returns 404.
const heroSizes = '(min-width: 1360px) 1232px, 92vw';
---

<BaseLayout
  title={`${title} | ${categoryInfo.title}`}
  description={metaDescription(intent, summary)}
  ogImage={socialUrl}
  ogImageWidth={cover.width}
  ogImageHeight={cover.height}
  ogImageAlt={coverAlt || `${title} presentation cover`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="project">
    <header class="container project-header">
      <p class="project-back">
        <a class="back-link" href={`/${category}/`} data-back data-astro-prefetch>
          <span class="back-link-arrow" aria-hidden="true">←</span> Back to {categoryInfo.title}
        </a>
      </p>

      <p class="overline">
        <a class="overline-link" href={`/${category}/`} data-astro-prefetch>{categoryInfo.title}</a>
        {
          industry && (
            <span>
              <span aria-hidden="true"> · </span>
              {industry}
            </span>
          )
        }
        {
          kind && (
            <span>
              <span aria-hidden="true"> · </span>
              {kind}
            </span>
          )
        }
      </p>

      <h1 class="project-title">{title}</h1>
      {/* The value proposition, at statement scale, before any image */}
      {intent && <p class="project-intent">{intent}</p>}

      {
        links.length > 0 && (
          <p class="project-links">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="container project-body">
      <div class="project-story">
        <section aria-labelledby="overview-heading">
          <p class="overline overline--bare story-label" id="overview-heading">Overview</p>
          <p class="project-summary">{summary}</p>
        </section>

        {
          story.map(([label, text]) => (
            <section class="story-row" aria-label={label}>
              <p class="overline overline--bare story-label">{label}</p>
              <p class="story-text">{text}</p>
            </section>
          ))
        }

        {
          outcome && (
            <section class="story-row story-row--outcome" aria-label="Outcome">
              <p class="overline overline--bare story-label">Outcome</p>
              <p class="story-text">{outcome}</p>
            </section>
          )
        }

        {
          testimonial?.quote && (
            <figure class="project-quote">
              <blockquote>
                <p>{testimonial.quote}</p>
              </blockquote>
              {/* One string, not a name beside a span whose ::before supplied
                  the comma. The formatter is entitled to put an expression and
                  the element after it on separate lines, and that newline is a
                  space — which rendered "Dana Okafor , Founder". Unreachable
                  while the editor had no way to type a quote in; reachable the
                  moment those fields came back. */}
              {[testimonial.name, testimonial.role].filter(Boolean).length > 0 && (
                <figcaption>
                  {[testimonial.name, testimonial.role].filter(Boolean).join(', ')}
                </figcaption>
              )}
            </figure>
          )
        }
      </div>

      <aside class="project-spec" aria-label="Project details">
        <dl class="spec-table">
          {
            specs.map(([label, value]) => (
              <div class="spec-row">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>

        {
          deliverables.length > 0 && (
            <div class="spec-block">
              <p class="overline overline--bare spec-label">Delivered</p>
              <ul class="spec-list" role="list">
                {deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          extras.length > 0 && deliverables.length === 0 && (
            <p class="spec-tags">
              {extras.map((e) => (
                <span class="tag">{e}</span>
              ))}
            </p>
          )
        }
      </aside>
    </div>

    {
      /* The deck opens here. Cover first, at size, then every page below it —
        the overview above has already said what this is, so the images run
        uninterrupted from this point down. Pairs with the grid card's view
        transition and loads with priority. */
    }
    <figure class="container project-hero">
      <button
        type="button"
        class="page-open media"
        data-open-page="0"
        style={`view-transition-name: work-${project.id}`}
        aria-label={isIconSet
          ? `Open sheet 1 of ${images.length} of the ${title} full screen`
          : `Open the ${title} presentation, page 1 of ${images.length}`}
      >
        <picture>
          {
            hero.avifSrcset && (
              <source type="image/avif" srcset={hero.avifSrcset} sizes={heroSizes} />
            )
          }
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes={heroSizes}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={heroPlaceholder}
          />
        </picture>
        <span class="page-cue" aria-hidden="true">View full screen</span>
      </button>
      {
        /* The first sheet is the hero, so without this its label is the one
          caption in the set that never appears — and on a one-sheet set that
          is every label the project has. */
      }
      {
        isIconSet && (hero.label || hero.logoType) && (
          <figcaption class="icon-caption">
            {hero.label && <span class="icon-name">{hero.label}</span>}
            {hero.logoType && <span class="icon-kind">{hero.logoType}</span>}
          </figcaption>
        )
      }
    </figure>

    {
      /**
       * The door, under the first image, on every layout.
       *
       * This button was added to the gallery head, which only renders when
       * there is a second image — so on four of the five published projects
       * it did not exist at all, and those are the ones that need it most: a
       * single-image case study has exactly one thing to look at, and the only
       * way to see it larger was to guess the image was clickable. The
       * "View full screen" cue that hints at it is hover-only, so a phone
       * never showed it either.
       *
       * One door, not two. It sits where a visitor first wants it — beside the
       * image, before the reading — rather than a thousand pixels down the
       * page beside a heading that names what they would already be scrolling
       * through. The delegated handler in Lightbox.astro catches any
       * [data-open-page], so this needs no script of its own.
       */
    }
    <p class="container project-open">
      <button class="button button--outline" type="button" data-open-page="0">
        {
          images.length === 1
            ? 'View full screen'
            : isIconSet
              ? `Open all ${images.length} sheets`
              : `Open all ${images.length} pages`
        }
        <span aria-hidden="true">↗</span>
      </button>
    </p>

    {
      pages.length > 0 && (
        <section class="container project-gallery" aria-labelledby="gallery-heading">
          <div class="gallery-head">
            <p class="overline">{isIconSet ? 'The set' : 'The system'}</p>
            {/* The dot has to touch the word. Every other use of this device
                on the site writes it adjacent — `your brand<span…>.` — and the
                newline the formatter puts here is a rendered space that does
                not collapse against a visible full stop: "Every page ." */}
            {/* prettier-ignore */}
            <h2 id="gallery-heading" class="gallery-title">{isIconSet ? 'Every mark' : 'Every page'}<span class="accent-dot">.</span></h2>
            <p class="gallery-count">
              {isIconSet
                ? `${images.length} ${images.length === 1 ? 'sheet' : 'sheets'} of icons.`
                : isChaptered
                  ? `${images.length} pages, in order, in ${namedChapters.length} chapters.`
                  : `${images.length} pages, in order.`}
            </p>
            {/* The way in to a specific part.

                A deck is read start to finish by whoever commissioned it and
                skimmed by everyone else — a buyer wants to see the colour
                system, an art director wants the typography. Without this the
                only instrument for reaching page 31 is the scrollbar. */}
            {isChaptered && (
              <nav class="chapter-index" aria-label="Chapters">
                <ol role="list">
                  {namedChapters.map((chapter) => (
                    <li>
                      <a href={`#${chapter.id}`}>
                        <span class="chapter-index-name">{chapter.title}</span>
                        <span class="chapter-index-at" aria-hidden="true">
                          {chapter.first + 1}
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>

          <div class="gallery-stack" data-chaptered={isChaptered ? '' : undefined}>
            {(isChaptered ? chapters : [{ title: null, id: '', first: 0, pages }]).map(
              (chapter) => (
                <section
                  class="chapter"
                  id={chapter.id || undefined}
                  aria-labelledby={chapter.title ? `${chapter.id}-heading` : undefined}
                >
                  {chapter.title && (
                    <h3 class="chapter-mark" id={`${chapter.id}-heading`}>
                      <span class="chapter-name">{chapter.title}</span>
                      <span class="chapter-span">
                        {chapter.pages.length === 1 && chapter.first !== 0
                          ? `page ${chapter.first + 1}`
                          : `pages ${chapter.first + 1}–${
                              (chapter.pages.at(-1)?.at ?? chapter.first) + 1
                            }`}
                      </span>
                    </h3>
                  )}
                  {chapter.pages.map(({ img, at, placeholder }) => (
                    <figure class="gallery-figure" data-reveal="wipe">
                      <button
                        type="button"
                        class="page-open media"
                        data-open-page={at}
                        aria-label={`Open page ${at + 1} of ${images.length} full screen`}
                      >
                        <picture>
                          {img.avifSrcset && (
                            <source type="image/avif" srcset={img.avifSrcset} sizes={heroSizes} />
                          )}
                          <img
                            src={img.src}
                            srcset={img.srcset}
                            sizes={heroSizes}
                            alt={img.alt}
                            width={img.width}
                            height={img.height}
                            loading="lazy"
                            decoding="async"
                            style={placeholder}
                          />
                        </picture>
                        {!isIconSet && (
                          <span class="page-num" aria-hidden="true">
                            {String(at + 1).padStart(2, '0')}
                          </span>
                        )}
                        <span class="page-cue" aria-hidden="true">
                          Enlarge
                        </span>
                      </button>
                      {/* A sheet can say which group it holds — "Fitness", or
                    "Mascot" — where a deck page is just page seven. Rendered
                    only when there is something to say, so a set part-way
                    through being labelled prints nothing rather than a rule. */}
                      {isIconSet && (img.label || img.logoType) && (
                        <figcaption class="icon-caption">
                          {img.label && <span class="icon-name">{img.label}</span>}
                          {img.logoType && <span class="icon-kind">{img.logoType}</span>}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </section>
              ),
            )}
          </div>
        </section>
      )
    }

    {
      /**
       * The ask.
       *
       * A case study ran to the end and then offered two more case studies.
       * Nowhere on the page — the one page a visitor reaches after deciding
       * they like the work — was there anything to do about it: `fiverrUrl`
       * appeared zero times in this template, and `.section--ink` sat in
       * global.css annotated "used for the closing Fiverr handoff" with no
       * caller anywhere in the codebase. This is that caller.
       */
    }
    <section class="project-close section--ink" aria-labelledby="project-close-heading">
      <div class="container project-close-inner">
        <div>
          <p class="overline">{categoryInfo.title}</p>
          <h2 id="project-close-heading" class="project-close-title">
            {industry ? `Want a system like this for ${industry}?` : 'Want a system like this?'}
          </h2>
          {
            /* Not the footer's line. Both bands appeared on the same page,
              ~600px apart, opening with the identical sentence — "Send what
              the business does and who it is for." The footer's is the general
              invitation and keeps it; this one stands beside the work a
              visitor has just finished looking at and can say something the
              footer cannot. */
          }
          <p class="section-lede">
            Everything on this page was made for one business. The next one is made for yours, to
            the same standard, with the same files at the end.
          </p>
        </div>
        <div class="project-close-actions">
          <a
            class="button button--primary button--lg"
            href={SITE.fiverrUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Start on Fiverr <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--ghost button--lg" href={`/${category}/#includes`}>
            What's included
          </a>
        </div>
      </div>
    </section>

    {
      (prev || next) && (
        <nav class="container project-nav" aria-label="More projects">
          <p class="overline project-nav-label">More work</p>
          <ul class="project-nav-list" role="list">
            {[prev, next]
              .filter((p) => p !== null)
              .map((p) => (
                <li>
                  <a class="project-nav-link" href={`/work/${p.id}/`} data-astro-prefetch>
                    <span class="project-nav-media media">
                      <picture>
                        {p.data.cover.avifSrcset && (
                          <source
                            type="image/avif"
                            srcset={p.data.cover.avifSrcset}
                            sizes="(min-width: 760px) 40vw, 92vw"
                          />
                        )}
                        <img
                          src={p.data.cover.src}
                          srcset={p.data.cover.srcset}
                          sizes="(min-width: 760px) 40vw, 92vw"
                          alt=""
                          width={p.data.cover.width}
                          height={p.data.cover.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </span>
                    <span class="project-nav-title">{p.data.title}</span>
                    {p.data.intent && <span class="project-nav-intent">{p.data.intent}</span>}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      )
    }
  </article>

  <Lightbox pages={viewerPages} title={title} />
</BaseLayout>

<script>
  // Back returns to the exact stage the visitor left — same filters, same
  // scroll offset — by walking real history. Only visitors who arrived from
  // within the site have that history; anyone landing from a shared link or
  // search follows the href to the work index instead.
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey) return;
    if (history.length > 1 && document.referrer.startsWith(location.origin)) {
      event.preventDefault();
      history.back();
    }
  });
</script>

