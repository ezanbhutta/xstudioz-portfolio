---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCategory } from '@/data/categories';
import { getSortedProjects, adjacentProjects } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { title, category, year, summary, cover, coverAlt, images } = project.data;
const categoryInfo = getCategory(category);
const { prev, next } = adjacentProjects(projects, project.id);

// Social card + structured data use the processed cover at share-friendly size.
const social = await getImage({ src: cover, width: 1200, format: 'jpeg' });
const socialUrl = new URL(social.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      genre: categoryInfo.title,
      dateCreated: String(year),
      url: new URL(`/work/${project.id}/`, SITE.url).href,
      image: socialUrl,
      creator: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Work', item: `${SITE.url}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryInfo.title,
          item: new URL(`/${category}/`, SITE.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};

const sizes = '(min-width: 1488px) 1232px, 92vw';
const widths = [640, 960, 1280, 1600];
---

<BaseLayout
  title={`${title} — ${categoryInfo.title}`}
  description={summary}
  ogImage={socialUrl}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article class="project">
    <header class="container project-header">
      <p class="overline">
        <a class="overline-link" href={`/${category}/`}>{categoryInfo.title}</a>
        <span aria-hidden="true"> · </span>{year}
      </p>
      <h1 class="project-title">{title}</h1>
      <p class="project-summary">{summary}</p>
    </header>

    <div class="container project-gallery">
      <figure class="project-figure" style={`view-transition-name: work-${project.id}`}>
        <Picture
          src={cover}
          alt={coverAlt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      {
        images.map((img) => (
          <figure class="project-figure" data-reveal>
            <Picture
              src={img.src}
              alt={img.alt}
              formats={['avif', 'webp']}
              widths={widths}
              sizes={sizes}
              loading="lazy"
            />
          </figure>
        ))
      }
    </div>

    <nav class="container project-nav" aria-label="More projects">
      <a class="project-nav-link" href={`/work/${prev.id}/`} rel="prev">
        <span class="overline"><span aria-hidden="true">← </span>Previous</span>
        <span class="project-nav-title">{prev.data.title}</span>
      </a>
      <a class="project-nav-link project-nav-next" href={`/work/${next.id}/`} rel="next">
        <span class="overline">Next<span aria-hidden="true"> →</span></span>
        <span class="project-nav-title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .overline-link {
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid var(--color-line-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .overline-link:hover {
    color: var(--color-accent);
  }

  .project-title {
    font-size: var(--text-display);
    margin-block: var(--space-sm) var(--space-md);
  }

  .project-summary {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .project-gallery {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  .project-figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xs);
    background: var(--color-line);
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-3xl);
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--space-lg);
  }

  .project-nav-link {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
    min-height: 2.75rem;
  }

  .project-nav-next {
    text-align: end;
  }

  .project-nav-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .project-nav-link:hover .project-nav-title {
    color: var(--color-accent);
  }
</style>
