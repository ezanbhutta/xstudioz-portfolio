---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCategory } from '@/data/categories';
import { getSortedProjects, adjacentProjects, projectExtras } from '@/lib/projects';
import { siteGraph, ORGANIZATION_ID } from '@/lib/schema';
import { lqipStyle } from '@/lib/lqip';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { title, category, summary, cover, coverAlt, images, logoType, guidelineType, industry } =
  project.data;
const categoryInfo = getCategory(category);
const kind = logoType ?? guidelineType;
const extras = projectExtras(project.data);

// Brand links, rendered only when set in the CMS. A social accepts a
// full link or a bare username (the platform base is prepended); a value
// that isn't a real URL is ignored rather than failing the build.
const toUrl = (value: string | undefined, platformBase?: string) => {
  const v = value?.trim().replace(/^@/, '');
  if (!v) return null;
  const href = /^https?:\/\//i.test(v)
    ? v
    : platformBase && !v.includes('.')
      ? `${platformBase}${v}`
      : `https://${v}`;
  try {
    return new URL(href);
  } catch {
    return null;
  }
};
const hostLabel = (url: URL) => url.hostname.replace(/^www\./, '');

const website = toUrl(project.data.website);
const links = [
  website && { label: `Live at ${hostLabel(website)}`, href: website.href },
  ...(
    [
      ['Instagram', project.data.instagram, 'https://instagram.com/'],
      ['Facebook', project.data.facebook, 'https://facebook.com/'],
      ['LinkedIn', project.data.linkedin, 'https://www.linkedin.com/company/'],
    ] as const
  ).map(([label, value, base]) => {
    const url = toUrl(value, base);
    return url && { label, href: url.href };
  }),
  ...(project.data.otherLinks ?? []).map((value) => {
    const url = toUrl(value);
    return url && { label: hostLabel(url), href: url.href };
  }),
].filter((l) => l !== null);
const { prev, next } = adjacentProjects(projects, project.id);

// Social card + structured data use the processed cover, cropped to the
// 1.91:1 ratio large-image cards expect.
const social = await getImage({
  src: cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const socialUrl = new URL(social.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      genre: categoryInfo.title,
      url: new URL(`/work/${project.id}/`, SITE.url).href,
      image: socialUrl,
      creator: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Work', item: `${SITE.url}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryInfo.title,
          item: new URL(`/${category}/`, SITE.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};

const sizes = '(min-width: 1360px) 1232px, 92vw';
const widths = [640, 960, 1280, 1600];
---

<BaseLayout
  title={`${title} | ${categoryInfo.title}`}
  description={summary}
  ogImage={socialUrl}
  ogImageAlt={coverAlt || `${title} presentation cover`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="project">
    <header class="container page-hero project-header">
      <p class="project-back">
        <a class="back-link" href={`/${category}/`} data-back>
          <span class="back-link-arrow" aria-hidden="true">←</span> Back
        </a>
      </p>
      <p class="overline">
        <a class="overline-link" href={`/${category}/`} data-astro-prefetch>{categoryInfo.title}</a>
        {
          kind && (
            <span>
              <span aria-hidden="true"> · </span>
              {kind}
            </span>
          )
        }
        {
          industry && (
            <span>
              <span aria-hidden="true"> · </span>
              {industry}
            </span>
          )
        }
      </p>
      <h1 class="page-title">{title}</h1>
      <p class="page-lede">{summary}</p>
      {
        extras.length > 0 && (
          <p class="project-includes">
            <span class="project-includes-label">Also includes</span>
            {extras.map((item) => (
              <span class="project-includes-item">{item}</span>
            ))}
          </p>
        )
      }
      {
        links.length > 0 && (
          <p class="project-links">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      /* The first image pairs with the grid card's view transition and loads
        with priority; the rest reveal lazily as the visitor scrolls. Each
        image carries its own blur placeholder so frames never appear empty. */
    }
    <div class="container project-gallery">
      {
        await Promise.all(
          images.map(async (img, i) => (
            <figure
              class="project-figure"
              data-reveal={i === 0 ? undefined : ''}
              style={i === 0 ? `view-transition-name: work-${project.id}` : undefined}
            >
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={widths}
                sizes={sizes}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                style={await lqipStyle(img.src)}
              />
            </figure>
          )),
        )
      }
    </div>

    <aside class="container project-cta" aria-label="Start a project">
      <p class="project-cta-text">Want something with this level of craft?</p>
      <div class="project-cta-actions">
        <a
          class="button button--primary"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hire on Fiverr <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>

    <nav class="container project-nav" aria-label="More projects">
      {
        prev && (
          <a class="project-nav-link" href={`/work/${prev.id}/`} rel="prev" data-astro-prefetch>
            <span class="overline">
              <span aria-hidden="true">← </span>Previous
            </span>
            <span class="project-nav-title">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a
            class="project-nav-link project-nav-next"
            href={`/work/${next.id}/`}
            rel="next"
            data-astro-prefetch
          >
            <span class="overline">
              Next<span aria-hidden="true"> →</span>
            </span>
            <span class="project-nav-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  // Back returns to the exact stage the visitor left — same filters, same
  // scroll offset — by walking real history. Only visitors who arrived from
  // within the site have that history; anyone landing from a shared link or
  // search follows the href to the project's category instead.
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey) return;
    if (history.length > 1 && document.referrer.startsWith(location.origin)) {
      event.preventDefault();
      history.back();
    }
  });
</script>

<style>
  /* Exhibition spacing: the wall text sits further from the first work
     than the works sit from each other. */
  .project-header {
    padding-block-end: var(--space-3xl);
  }

  .project-back {
    margin-block-end: var(--space-md);
  }

  .back-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link-arrow {
    display: inline-block;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--color-accent);
    }

    .back-link:hover .back-link-arrow {
      translate: -0.25em 0;
    }
  }

  .overline-link {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .overline-link:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }

  /* Extra elements read as a quiet spec line, pill-tagged like the filter
     vocabulary but non-interactive — informational, never competing. */
  .project-includes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-md);
  }

  .project-includes-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    margin-inline-end: var(--space-3xs);
  }

  .project-includes-item {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .project-links a {
    display: inline-block;
    /* 44px hit area without growing the line box */
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .project-links a:hover {
      color: var(--color-accent);
    }
  }

  .project-gallery {
    display: grid;
    gap: var(--space-gallery);
  }

  .project-figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xs);
    background: var(--color-line);
  }

  .project-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-3xl);
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-lg);
  }

  /* Quieter than the next-project titles — at a project's end, the next
     work should win; the pill carries the CTA's authority. */
  .project-cta-text {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
  }

  .project-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
  }

  .project-nav-link {
    display: grid;
    gap: var(--space-3xs);
    overflow-wrap: break-word;
    text-decoration: none;
    min-height: var(--control-h);
  }

  .project-nav-next {
    text-align: end;
    margin-inline-start: auto;
  }

  .project-nav-title {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    padding-block-end: 2px;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .project-nav-next .project-nav-title {
    justify-self: end;
  }

  @media (hover: hover) {
    .project-nav-link:hover .project-nav-title {
      background-size: 100% 2px;
    }
  }

  .project-nav-link:focus-visible .project-nav-title {
    background-size: 100% 2px;
  }
</style>
