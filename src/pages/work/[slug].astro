  }

  @media (hover: hover) {
    .overline-link:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }

  .project-title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-2xs) var(--space-md);
  }

  /* The one line that says why this project mattered */
  .project-intent {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    /* Ink, not accent. tokens.css rations the violet to one thing per view —
       the case study already spends it on the header rule and the Fiverr
       pill — and `.service-outcome` makes the argument against this exact
       treatment in its own comment: a promise set in purple reads as a
