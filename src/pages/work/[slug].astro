  .project-close-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* One column at a reading measure. The 7fr/4fr split existed to hold the
     spec aside; the facts are in the masthead now and the reading gets the
     page to itself. */
  .project-body {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .project-story {
    display: grid;
    gap: var(--space-xl);
