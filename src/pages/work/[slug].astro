---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCategory } from '@/data/categories';
import { getSortedProjects, adjacentProjects } from '@/lib/projects';
import { siteGraph, ORGANIZATION_ID } from '@/lib/schema';
import { lqipStyle } from '@/lib/lqip';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { title, category, year, summary, cover, coverAlt, images } = project.data;
const categoryInfo = getCategory(category);
const { prev, next } = adjacentProjects(projects, project.id);

// Social card + structured data use the processed cover, cropped to the
// 1.91:1 ratio large-image cards expect.
const social = await getImage({
  src: cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const socialUrl = new URL(social.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      genre: categoryInfo.title,
      dateCreated: String(year),
      url: new URL(`/work/${project.id}/`, SITE.url).href,
      image: socialUrl,
      creator: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Work', item: `${SITE.url}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryInfo.title,
          item: new URL(`/${category}/`, SITE.url).href,
        },
        { '@type': 'ListItem', position: 3, name: title },
      ],
    },
  ],
};

const sizes = '(min-width: 1360px) 1232px, 92vw';
const widths = [640, 960, 1280, 1600];
---

<BaseLayout
  title={`${title} — ${categoryInfo.title}`}
  description={summary}
  ogImage={socialUrl}
  ogImageAlt={coverAlt}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="project">
    <header class="container page-hero project-header">
      <p class="overline">
        <a class="overline-link" href={`/${category}/`}>{categoryInfo.title}</a>
        <span aria-hidden="true"> · </span>{year}
      </p>
      <h1 class="page-title">{title}</h1>
      <p class="page-lede">{summary}</p>
    </header>

    {
      /* The first image pairs with the grid card's view transition and loads
        with priority; the rest reveal lazily as the visitor scrolls. Each
        image carries its own blur placeholder so frames never appear empty. */
    }
    <div class="container project-gallery">
      {
        await Promise.all(
          images.map(async (img, i) => (
            <figure
              class="project-figure"
              data-reveal={i === 0 ? undefined : ''}
              style={i === 0 ? `view-transition-name: work-${project.id}` : undefined}
            >
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={widths}
                sizes={sizes}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                style={await lqipStyle(img.src)}
              />
            </figure>
          )),
        )
      }
    </div>

    <aside class="container project-cta" aria-label="Start a project">
      <p class="project-cta-text">Want something with this level of craft?</p>
      <div class="project-cta-actions">
        <a
          class="button button--primary"
          href={SITE.fiverrUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hire on Fiverr <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>

    <nav class="container project-nav" aria-label="More projects">
      {
        prev && (
          <a class="project-nav-link" href={`/work/${prev.id}/`} rel="prev" data-astro-prefetch>
            <span class="overline">
              <span aria-hidden="true">← </span>Previous
            </span>
            <span class="project-nav-title">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a
            class="project-nav-link project-nav-next"
            href={`/work/${next.id}/`}
            rel="next"
            data-astro-prefetch
          >
            <span class="overline">
              Next<span aria-hidden="true"> →</span>
            </span>
            <span class="project-nav-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .overline-link {
    display: inline-block;
    padding-block: 0.5rem;
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid var(--color-line-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .overline-link:hover {
    color: var(--color-accent);
  }

  .project-gallery {
    display: grid;
    gap: var(--space-gallery);
  }

  .project-figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xs);
    background: var(--color-line);
  }

  .project-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-3xl);
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-lg);
  }

  .project-cta-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
  }

  .project-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-lg);
  }

  .project-nav-link {
    display: grid;
    gap: var(--space-3xs);
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: none;
    min-height: var(--control-h);
  }

  .project-nav-next {
    text-align: end;
    margin-inline-start: auto;
  }

  .project-nav-title {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    padding-block-end: 2px;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .project-nav-next .project-nav-title {
    justify-self: end;
  }

  @media (hover: hover) {
    .project-nav-link:hover .project-nav-title {
      background-size: 100% 2px;
    }
  }
</style>
