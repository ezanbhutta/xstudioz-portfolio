---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkFilters from '@/components/WorkFilters.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import BriefSection from '@/components/BriefSection.astro';
import { SITE } from '@/config/site';
import {
  getSortedProjects,
  countByCategory,
  industriesOf,
  typeGroups as buildTypeGroups,
} from '@/lib/projects';
import { siteGraph, WEBSITE_ID } from '@/lib/schema';

const projects = await getSortedProjects();
const counts = countByCategory(projects);
const industries = industriesOf(projects);
const typeGroups = buildTypeGroups(projects);

const description = `Every ${SITE.name} project in one place — logo design, brand guidelines and identity systems, filterable by service, industry and type.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(),
    {
      '@type': 'CollectionPage',
      name: `Work | ${SITE.name}`,
      description,
      url: new URL('/work/', SITE.url).href,
      isPartOf: { '@id': WEBSITE_ID },
    },
  ],
};
---

<BaseLayout title="Work" description={description} jsonLd={jsonLd}>
  <section class="container page-hero work-hero">
    <p class="overline">All work</p>
    <h1 class="page-title">The full portfolio<span class="accent-dot">.</span></h1>
    <p class="page-lede">
      Every project published so far, newest thinking first. Narrow it by service, industry or
      type — the count updates as you go.
    </p>
  </section>

  <WorkFilters counts={counts} total={projects.length} industries={industries} typeGroups={typeGroups} />

  <section class="container work-section" aria-label="Projects">
    {/* The filter script's announcement channel for screen readers */}
    <p class="visually-hidden" role="status" data-filter-status></p>

    <WorkGrid
      projects={projects}
      heading="All projects"
      eagerCount={2}
      rhythm="grid"
      filterable
      leadFirst
    />

    <p class="work-empty" data-work-empty hidden>
      <span class="work-empty-title">Nothing matches that combination.</span>
      <span class="work-empty-text">
        Clear a filter to widen the search — or
        <a href={SITE.fiverrUrl} target="_blank" rel="noopener noreferrer"
          >ask about this kind of project on Fiverr <span aria-hidden="true">↗</span></a
        >. Work that isn't published yet still gets made.
      </span>
    </p>
  </section>

  <BriefSection
    title="Seen something close to what you need?"
    lede="Send the brand nearest to yours and say what is different about your business. Six lines is enough to get a real answer back."
  />
</BaseLayout>

<style>
  /* The filter rail stacks under the sticky header on this page, so anything
     scrolled to needs to clear both. */
  :global(html:has(.work-section)) {
    --sticky-offset: calc(var(--header-h) + 5.75rem);
  }

  .work-hero {
    padding-block-end: var(--space-lg);
  }

  .work-section {
    padding-block: var(--space-2xl) var(--space-section);
  }

  .work-empty {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-3xl);
    max-width: var(--measure);
  }

  .work-empty-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
  }

  .work-empty-text {
    color: var(--color-ink-soft);
  }

  .work-empty a {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
    text-decoration-color: var(--color-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .work-empty a:hover {
      color: var(--color-accent);
    }
  }
</style>
